# Generated by scripts/archlinux.py from the workspace version and hydrated sources.
# Maintainer: SwitchX contributors
pkgname=switchx
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='Manage model providers and local routing for Codex'
arch=('x86_64')
url='https://github.com/VOD-Studio/switchx'
license=('MIT')
depends=('glibc' 'libgcc' 'fontconfig' 'libxkbcommon' 'libxkbcommon-x11'
         'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr' 'libglvnd'
         'wayland' 'dbus' 'hicolor-icon-theme')
makedepends=('rustup' 'cmake' 'pkgconf' 'python' 'imagemagick')
checkdepends=('desktop-file-utils')
# Cargo controls optimization; avoid cross-language LTO and a second debug package.
options=('!lto' '!debug')
_version='@VERSION@'
_target="${CARCH}-unknown-linux-gnu"
source=("switchx-${_version}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

_setup() {
    cd "$srcdir/switchx-$_version"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    export CARGO_INCREMENTAL=0
}

prepare() {
    _setup
    # rust-toolchain.toml selects the same pinned toolchain as the other packages.
    cargo fetch --locked --target "$_target"
}

build() {
    _setup
    cargo build --frozen --release --bin switchx --target "$_target"
    magick assets/app-icon.png -resize 512x512 switchx.png
    python - <<'PY'
import json
import subprocess
from pathlib import Path

path = Path('BUILD-INFO.json')
info = json.loads(path.read_text(encoding='utf-8'))
info['rustc'] = subprocess.check_output(['rustc', '--version'], text=True).strip()
path.write_text(json.dumps(info, indent=2) + '\n', encoding='utf-8')
PY
}

check() {
    _setup
    desktop-file-validate packaging/linux/switchx.desktop
    python scripts/package_smoke.py "$CARGO_TARGET_DIR/$_target/release/switchx" "$_version"
}

package() {
    _setup
    install -Dm755 "$CARGO_TARGET_DIR/$_target/release/switchx" "$pkgdir/usr/bin/switchx"
    install -Dm644 packaging/linux/switchx.desktop "$pkgdir/usr/share/applications/switchx.desktop"
    install -Dm644 switchx.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/switchx.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/switchx/LICENSE"
    install -Dm644 assets/providers/NOTICE.md "$pkgdir/usr/share/licenses/switchx/Provider-Icons-NOTICE.md"
    install -Dm644 README.md CHANGELOG.md BUILD-INFO.json -t "$pkgdir/usr/share/doc/switchx/"
}
