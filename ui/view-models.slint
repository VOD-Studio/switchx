export struct ModelRow {
    provider-id: string,
    provider-name: string,
    upstream-model: string,
    public-id: string,
    display-name: string,
    detail: string,
    context-window: string,
    reasoning-levels: string,
    default-reasoning: string,
    saved: bool,
    ready: bool,
    included: bool,
    fallback-provider-id: string,
    fallback-label: string,
    binding-label: string,
    is-subscription: bool,
    // Set only in the snapshot right after a batch addition, to play its arrival.
    fresh: bool,
}

export struct ProviderRow {
    id: string,
    name: string,
    endpoint: string,
    base-url: string,
    model-id: string,
    credential-status: string,
    check-id: string,
    check-stage: string,
    check-elapsed-ms: int,
    check-message: string,
    check-detail: string,
    check-failed: bool,
    auth-error: string,
    is-subscription: bool,
    is-grok: bool,
    binding-label: string,
    preset-id: string,
    icon-id: string,
    icon: image,
    monochrome: bool,
    model-count: int,
    ready-model-count: int,
    selected-model-count: int,
    models: [ModelRow],
}

export struct ConnectionModelRow {
    public-id: string,
    display-name: string,
    upstream-model: string,
    context-window: string,
    reasoning-levels: string,
    default-reasoning: string,
    removing: bool,
}

export struct ProviderPresetRow {
    id: string,
    name: string,
    icon: image,
    monochrome: bool,
}

export struct ProviderIconRow {
    id: string,
    name: string,
    icon: image,
    monochrome: bool,
}

export struct XaiQuotaRow {
    has-value: bool,
    remaining-percent: float,
    period-label: string,
    resets-at: string,
    queried-at: string,
    reset-label: string,
    reset-detail: string,
    updated-label: string,
    loading: bool,
    request-id: string,
    error: string,
}

export struct CodexQuotaRow {
    has-value: bool,
    primary-window: XaiQuotaRow,
    secondary-window: XaiQuotaRow,
    credits-label: string,
    reset-expiries: string,
    resets-label: string,
    resets-warning: bool,
    queried-at: string,
    updated-label: string,
    loading: bool,
    request-id: string,
    error: string,
}

export struct AccountRow {
    id: string,
    label: string,
    initial: string,
    workspace: string,
    is-default: bool,
    is-active: bool,
    requires-reauth: bool,
    bound-provider-count: int,
    bound-provider-names: string,
    quota: XaiQuotaRow,
    credential-generation: string,
    codex-quota: CodexQuotaRow,
}


// A discovered upstream model in the batch picker. Empty `context` and `levels`
// inherit the template values (when `source` is set), then the shared values.
export struct BatchModelRow {
    id: string,
    added: bool,
    supported: bool,
    checked: bool,
    matched: bool,
    source: string,
    template-context: string,
    template-levels: string,
    template-default: string,
    // Compact labels from catalog::reasoning_label, for the parameter chip.
    template-levels-label: string,
    context: string,
    levels: string,
    levels-label: string,
}

// Counts for the batch picker; `visible-*` cover rows matching the search.
export struct BatchSummary {
    total: int,
    matched: int,
    added: int,
    selected: int,
    visible-selectable: int,
    visible-selected: int,
}

// One routed request. `kind`: 0 completed, 1 failed, 2 interrupted, 3 cancelled.
// Timings are milliseconds, or -1 when the stage was never reached; `level` is the
// log-scaled duration in 0..1 shared with the pulse chart.
// `stamp` is the refresh generation that first saw the row; 0 for the initial load.
export struct RequestRow {
    id: string,
    time: string,
    clock: string,
    model: string,
    provider: string,
    upstream: string,
    duration: string,
    duration-ms: int,
    level: float,
    headers-ms: int,
    first-event-ms: int,
    http: string,
    generation: string,
    status: string,
    kind: int,
    error: string,
    fallback: string,
    // Compact total and breakdown when the upstream reported usage.
    tokens: string,
    token-detail: string,
    stamp: int,
}

// Aggregates for the activity header; rates and latencies are -1 without data.
export struct RequestStats {
    total: int,
    completed: int,
    failed: int,
    cancelled: int,
    success-rate: float,
    p50-ms: float,
    p95-ms: float,
    first-event-ms: float,
}

// One bar of the activity pulse; `level` is a log-scaled duration in 0..1.
export struct RequestBar {
    id: string,
    level: float,
    kind: int,
    label: string,
    stamp: int,
}

// Usage page view models. Rust formats every value; levels are 0–1 of each chart's scale.
export struct UsageSummary {
    tokens: float,
    requests: float,
    // 0–1, or -1 when no input was reported.
    cache-rate: float,
    fresh-share: float,
    output-share: float,
    cache-share: float,
    fresh-text: string,
    output-text: string,
    reasoning-text: string,
    cache-text: string,
    delta-text: string,
    // 0 neutral, 1 up, 2 down.
    delta-tone: int,
    cost-text: string,
    cost-secondary: string,
    cost-note: string,
    speed-text: string,
    range-text: string,
    empty: bool,
}

// A local date and minute as the range picker edits it; Rust resolves it to an instant.
export struct UsageMoment {
    year: int,
    month: int,
    day: int,
    hour: int,
    minute: int,
}

export struct UsageRange {
    start: UsageMoment,
    end: UsageMoment,
}

export struct UsagePoint {
    key: string,
    label: string,
    tip-title: string,
    tip-detail: string,
    future: bool,
    current: bool,
    tokens-level: float,
    // Shares of the token bar, bottom to top: fresh input, output, then cache.
    fresh-share: float,
    output-share: float,
    cost-level: float,
    // Share of the cost bar billed by API connections; the rest is subscription-equivalent.
    api-share: float,
    requests-level: float,
}

export struct UsageScale {
    tokens-top: string,
    tokens-mid: string,
    cost-top: string,
    cost-mid: string,
    requests-top: string,
    requests-mid: string,
    cost-caption: string,
}

export struct UsageShareRow {
    key: string,
    name: string,
    detail: string,
    icon: image,
    has-icon: bool,
    monochrome: bool,
    letter: string,
    level: float,
    percent: string,
    value: string,
    cost: string,
    // Folded remainder rows cannot be used as filters.
    selectable: bool,
}

export struct UsageHeatCell {
    level: float,
    tip: string,
}

export struct UsageDetailRow {
    id: string,
    clock: string,
    time: string,
    connection: string,
    kind: string,
    icon: image,
    has-icon: bool,
    monochrome: bool,
    letter: string,
    model: string,
    public-model: string,
    fresh: string,
    cached: string,
    output: string,
    reasoning: string,
    cost: string,
    speed: string,
    duration: string,
    source: string,
    cache-write: string,
    client: string,
    routed: bool,
    // Shares of the row's input plus output, for the expanded composition bar.
    fresh-share: float,
    cache-share: float,
    output-share: float,
    stamp: int,
}

export struct UsageSourceRow {
    key: string,
    name: string,
    path: string,
    enabled: bool,
    hint: string,
}

export struct UsageSyncState {
    running: bool,
    progress: float,
    enabled: bool,
    text: string,
    detail: string,
    error: string,
}

export struct UsagePriceRow {
    provider-id: string,
    model: string,
    scope: string,
    currency: string,
    input: string,
    cached: string,
    write: string,
    write-hour: string,
    output: string,
    usage: string,
    priced: bool,
    reference: string,
}

export struct PreviewFact {
    label: string,
    value: string,
}

export struct PreviewMappingRow {
    model: string,
    provider: string,
    origin: string,
    fallback: string,
    fallback-origin: string,
}

export struct PreviewBindingRow {
    provider: string,
    grok: bool,
    facts: [PreviewFact],
}

// Grouped route publication review; it never carries credentials.
export struct RoutePreviewData {
    client: string,
    endpoint: string,
    target: string,
    mappings: [PreviewMappingRow],
    changes: [string],
    bindings: [PreviewBindingRow],
    notes: [string],
}
