export struct ModelRow {
    provider-id: string,
    provider-name: string,
    upstream-model: string,
    public-id: string,
    display-name: string,
    detail: string,
    context-window: string,
    reasoning-levels: string,
    default-reasoning: string,
    saved: bool,
    ready: bool,
    included: bool,
    fallback-provider-id: string,
    fallback-label: string,
    binding-label: string,
    is-subscription: bool,
    // Set only in the snapshot right after a batch addition, to play its arrival.
    fresh: bool,
}

export struct ProviderRow {
    id: string,
    name: string,
    endpoint: string,
    base-url: string,
    model-id: string,
    credential-status: string,
    check-id: string,
    check-stage: string,
    check-elapsed-ms: int,
    check-message: string,
    check-detail: string,
    check-failed: bool,
    auth-error: string,
    is-subscription: bool,
    is-grok: bool,
    binding-label: string,
    preset-id: string,
    icon-id: string,
    icon: image,
    monochrome: bool,
    model-count: int,
    ready-model-count: int,
    selected-model-count: int,
    models: [ModelRow],
}

export struct ConnectionModelRow {
    public-id: string,
    display-name: string,
    upstream-model: string,
    context-window: string,
    reasoning-levels: string,
    removing: bool,
}

export struct ProviderPresetRow {
    id: string,
    name: string,
    icon: image,
    monochrome: bool,
}

export struct ProviderIconRow {
    id: string,
    name: string,
    icon: image,
    monochrome: bool,
}

export struct XaiQuotaRow {
    has-value: bool,
    remaining-percent: float,
    period-label: string,
    resets-at: string,
    queried-at: string,
    reset-label: string,
    reset-detail: string,
    updated-label: string,
    loading: bool,
    request-id: string,
    error: string,
}

export struct CodexQuotaRow {
    has-value: bool,
    primary-window: XaiQuotaRow,
    secondary-window: XaiQuotaRow,
    credits-label: string,
    reset-expiries: string,
    resets-label: string,
    resets-warning: bool,
    queried-at: string,
    updated-label: string,
    loading: bool,
    request-id: string,
    error: string,
}

export struct AccountRow {
    id: string,
    label: string,
    initial: string,
    workspace: string,
    is-default: bool,
    is-active: bool,
    requires-reauth: bool,
    bound-provider-count: int,
    bound-provider-names: string,
    quota: XaiQuotaRow,
    credential-generation: string,
    codex-quota: CodexQuotaRow,
}


// A discovered upstream model in the batch picker. Empty `context` and `levels`
// inherit the template values (when `source` is set), then the shared values.
export struct BatchModelRow {
    id: string,
    added: bool,
    supported: bool,
    checked: bool,
    matched: bool,
    source: string,
    template-context: string,
    template-levels: string,
    // Compact labels from catalog::reasoning_label, for the parameter chip.
    template-levels-label: string,
    context: string,
    levels: string,
    levels-label: string,
}

// Counts for the batch picker; `visible-*` cover rows matching the search.
export struct BatchSummary {
    total: int,
    matched: int,
    added: int,
    selected: int,
    visible-selectable: int,
    visible-selected: int,
}

// One routed request. `kind`: 0 completed, 1 failed, 2 interrupted, 3 cancelled.
// Timings are milliseconds, or -1 when the stage was never reached; `level` is the
// log-scaled duration in 0..1 shared with the pulse chart.
// `stamp` is the refresh generation that first saw the row; 0 for the initial load.
export struct RequestRow {
    id: string,
    time: string,
    clock: string,
    model: string,
    provider: string,
    upstream: string,
    duration: string,
    duration-ms: int,
    level: float,
    headers-ms: int,
    first-event-ms: int,
    http: string,
    generation: string,
    status: string,
    kind: int,
    error: string,
    fallback: string,
    stamp: int,
}

// Aggregates for the activity header; rates and latencies are -1 without data.
export struct RequestStats {
    total: int,
    completed: int,
    failed: int,
    cancelled: int,
    success-rate: float,
    p50-ms: float,
    p95-ms: float,
    first-event-ms: float,
}

// One bar of the activity pulse; `level` is a log-scaled duration in 0..1.
export struct RequestBar {
    id: string,
    level: float,
    kind: int,
    label: string,
    stamp: int,
}
