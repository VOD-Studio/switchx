import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: Palette.color-scheme != ColorScheme.light;
    out property <color> background: dark ? #101113 : #f5f4f1;
    out property <color> panel: dark ? #17191d : #ffffff;
    out property <color> raised: dark ? #1d2025 : #efeeeb;
    out property <color> border: dark ? #2b2e35 : #dfddd8;
    out property <color> primary-text: dark ? #f1f0f4 : #24242a;
    out property <color> muted-text: dark ? #a1a3af : #666571;
    out property <color> brand: dark ? #b3a0ff : #7154c4;
    out property <color> on-brand: dark ? #24242a : #ffffff;
    out property <color> brand-surface: dark ? #302a40 : #f0ebff;
    out property <color> success: dark ? #9de5c3 : #327554;
    out property <color> warning: dark ? #f0c987 : #916018;
    out property <color> error: dark ? #f5a8a4 : #a84442;
    out property <color> code-key: dark ? #8cc8ff : #155d91;
    out property <color> code-string: dark ? #a9d69c : #326c2a;
    out property <color> code-number: dark ? #f0c987 : #83560b;
    out property <color> code-literal: dark ? #c6b0ff : #7145a1;
    out property <color> code-comment: dark ? #919baa : #69717c;
    out property <color> code-section: dark ? #f0a6ce : #993b70;
}
