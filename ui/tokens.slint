import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: Palette.color-scheme != ColorScheme.light;
    in-out property <bool> animations-enabled: true;
    in-out property <bool> system-reduced-motion: false;
    out property <duration> fast: animations-enabled && !system-reduced-motion ? 150ms : 0ms;
    out property <duration> page-motion: animations-enabled && !system-reduced-motion ? 240ms : 0ms;
    out property <duration> drawer-motion: animations-enabled && !system-reduced-motion ? 340ms : 0ms;
    out property <color> background: dark ? #17191b : #fbfaf8;
    out property <color> sidebar: dark ? #111315 : #f0efeb;
    out property <color> panel: dark ? #202326 : #ffffff;
    out property <color> raised: dark ? #282c2e : #f3f3ef;
    out property <color> border: dark ? #333a35 : #e4e7e1;
    out property <color> primary-text: dark ? #e9ede9 : #252c29;
    out property <color> muted-text: dark ? #a3ada5 : #6d7670;
    out property <color> brand: dark ? #a7c4ab : #496b56;
    out property <color> solid: dark ? #bfd4bf : #273f31;
    out property <color> on-brand: dark ? #1b2a20 : #ffffff;
    out property <color> brand-surface: dark ? #29382e : #e8efe6;
    out property <color> success: dark ? #a7c4ab : #496b56;
    out property <color> warning: dark ? #e1b879 : #946621;
    out property <color> warning-surface: dark ? #3a3125 : #f8efdf;
    out property <color> error: dark ? #e7a19b : #ae534d;
    out property <color> scrim: dark ? #00000070 : #18221a30;
    out property <color> code-key: dark ? #8cc8ff : #155d91;
    out property <color> code-string: dark ? #a9d69c : #326c2a;
    out property <color> code-number: dark ? #f0c987 : #83560b;
    out property <color> code-literal: dark ? #c6b0ff : #7145a1;
    out property <color> code-comment: dark ? #919baa : #69717c;
    out property <color> code-section: dark ? #f0a6ce : #993b70;
}
