import { ScrollView as NativeScrollView } from "std-widgets.slint";
import { Theme } from "tokens.slint";

component QuietScrollBar inherits Rectangle {
    in property <bool> horizontal;
    in property <bool> enabled: true;
    in property <length> maximum;
    in property <length> page-size;
    in-out property <length> value;
    callback scrolled();

    private property <length> track-size: root.horizontal ? root.width : root.height;
    private property <length> thumb-size: min(root.track-size, max(28px, root.track-size * root.page-size / max(1px, root.maximum + root.page-size)));
    private property <length> travel: max(0px, root.track-size - root.thumb-size);
    private property <length> thumb-position: root.maximum > 0px ? max(0px, min(root.travel, -root.value / root.maximum * root.travel)) : 0px;
    private property <length> thickness: touch.has-hover || touch.pressed ? 6px : 4px;

    function scroll-to(value: length) {
        if root.enabled {
            root.value = max(-root.maximum, min(0px, value));
            root.scrolled();
        }
    }
    changed maximum => { root.value = max(-root.maximum, min(0px, root.value)); }

    border-radius: 7px;
    clip: true;
    background: touch.has-hover ? Theme.muted-text.with-alpha(0.06) : transparent;
    opacity: root.enabled ? 1 : 0.45;
    animate background, opacity { duration: Theme.fast; }
    accessible-role: slider;
    accessible-orientation: root.horizontal ? Orientation.horizontal : Orientation.vertical;
    accessible-label: root.horizontal ? "水平滚动条" : "垂直滚动条";
    accessible-enabled: root.enabled && root.maximum > 0px;
    accessible-value: -root.value / 1px;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.maximum / 1px;
    accessible-action-increment => { root.scroll-to(root.value - 40px); }
    accessible-action-decrement => { root.scroll-to(root.value + 40px); }
    accessible-action-set-value(value) => { root.scroll-to(-value.to-float() * 1px); }

    Rectangle {
        x: root.horizontal ? root.thumb-position : (parent.width - self.width) / 2;
        y: root.horizontal ? (parent.height - self.height) / 2 : root.thumb-position;
        width: root.horizontal ? root.thumb-size : root.thickness;
        height: root.horizontal ? root.thickness : root.thumb-size;
        border-radius: 3px;
        background: Theme.muted-text.with-alpha(touch.pressed ? 0.8 : touch.has-hover ? 0.6 : 0.32);
        animate background, width, height { duration: Theme.fast; }
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled && root.maximum > 0px;
        private property <length> pressed-position;
        private property <length> pressed-value;
        private property <length> pressed-maximum;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.pressed-position = root.horizontal ? self.mouse-x : self.mouse-y;
                if root.travel > 0px && (self.pressed-position < root.thumb-position || self.pressed-position > root.thumb-position + root.thumb-size) {
                    root.scroll-to(-(self.pressed-position - root.thumb-size / 2) / root.travel * root.maximum);
                }
                self.pressed-value = root.value;
                self.pressed-maximum = root.maximum;
            }
        }
        moved => {
            if self.pressed && root.travel > 0px {
                if self.pressed-maximum != root.maximum {
                    self.pressed-position = root.horizontal ? self.mouse-x : self.mouse-y;
                    self.pressed-value = root.value;
                    self.pressed-maximum = root.maximum;
                }
                root.scroll-to(self.pressed-value - ((root.horizontal ? self.mouse-x : self.mouse-y) - self.pressed-position) / root.travel * root.maximum);
            }
        }
        scroll-event(event) => {
            if (root.horizontal ? event.delta-x : event.delta-y) != 0px {
                root.scroll-to(root.value + (root.horizontal ? event.delta-x : event.delta-y));
                return accept;
            }
            reject
        }
    }
}

// Native scrolling and child layout, with scrollbars outside the clipped content.
export component QuietScrollView inherits Rectangle {
    in property <bool> enabled: true;
    out property <length> visible-width <=> scroll.visible-width;
    out property <length> visible-height <=> scroll.visible-height;
    in-out property <length> content-width <=> scroll.content-width;
    in-out property <length> content-height <=> scroll.content-height;
    in-out property <length> content-x <=> scroll.content-x;
    in-out property <length> content-y <=> scroll.content-y;
    in property <ScrollBarPolicy> vertical-scrollbar-policy: as-needed;
    in property <ScrollBarPolicy> horizontal-scrollbar-policy: as-needed;
    in property <bool> mouse-drag-pan-enabled <=> scroll.mouse-drag-pan-enabled;
    callback scrolled <=> scroll.scrolled;

    // Keep the right gutter stable as lists grow and forms resize.
    private property <length> gutter: 14px;
    min-width: 50px;
    min-height: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-width: 100%;
    preferred-height: 100%;

    scroll := NativeScrollView {
        x: 0px;
        y: 0px;
        width: max(0px, root.width - (root.vertical-scrollbar-policy == always-off ? 0px : root.gutter));
        height: max(0px, root.height - (horizontal.visible ? root.gutter : 0px));
        enabled: root.enabled;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        @children
    }

    vertical := QuietScrollBar {
        x: root.width - root.gutter;
        y: 0px;
        width: root.gutter;
        height: scroll.height;
        enabled: root.enabled;
        maximum: max(0px, root.content-height - root.visible-height);
        page-size: root.visible-height;
        value <=> root.content-y;
        visible: root.vertical-scrollbar-policy == always-on || (root.vertical-scrollbar-policy == as-needed && self.maximum > 0px);
        scrolled => { root.scrolled(); }
    }

    horizontal := QuietScrollBar {
        x: 0px;
        y: root.height - root.gutter;
        width: scroll.width;
        height: root.gutter;
        horizontal: true;
        enabled: root.enabled;
        maximum: max(0px, root.content-width - root.visible-width);
        page-size: root.visible-width;
        value <=> root.content-x;
        visible: root.horizontal-scrollbar-policy == always-on || (root.horizontal-scrollbar-policy == as-needed && self.maximum > 0px);
        scrolled => { root.scrolled(); }
    }
}

// Slint recognizes the ListView name and keeps repeated rows virtualized.
export component ListView inherits QuietScrollView {
    @children
    accessible-role: list;
    accessible-orientation: vertical;
}
