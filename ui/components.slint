import { ComboBox } from "std-widgets.slint";
import { QuietScrollView as ScrollView } from "scroll-view.slint";
import { Theme } from "tokens.slint";

export component SurfaceCard inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 11px;
    animate background, border-color { duration: Theme.page-motion; }
    @children
}

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> ink: Theme.muted-text;
    in property <color> fill: Theme.raised;
    width: 100px;
    height: 26px;
    border-radius: 6px;
    background: fill;
    animate background { duration: Theme.fast; }
    Text {
        text: root.label;
        color: root.ink;
        font-size: 11px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: Theme.fast; }
    }
}

export component QuietButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <length> icon-width: 16px;
    in property <length> icon-height: 16px;
    in property <brush> icon-color: transparent;
    in property <bool> icon-only: false;
    in property <bool> stacked-icon: false;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <bool> ghost: false;
    in property <bool> navigation: false;
    in property <bool> left-aligned: false;
    in property <bool> enabled <=> hit-area.enabled;
    callback clicked;
    property <length> press-offset: hit-area.pressed && root.enabled ? 1px : 0px;
    animate press-offset {
        duration: Theme.fast;
        easing: ease-out;
    }

    height: 36px;
    min-width: root.icon-only ? 36px : 64px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.42;
    border-width: root.ghost || root.navigation ? 0px : 1px;
    border-color: root.primary ? Theme.solid : root.selected ? Theme.brand : hit-area.has-hover ? Theme.muted-text : Theme.border;
    background: root.primary ? (hit-area.pressed ? Theme.brand : Theme.solid)
        : root.navigation && root.selected ? Theme.panel
        : root.selected ? Theme.brand-surface
        : hit-area.has-hover || hit-area.pressed ? Theme.raised
        : root.ghost || root.navigation ? transparent : Theme.panel;
    animate background, border-color, opacity {
        duration: Theme.fast;
        easing: ease-out;
    }
    forward-focus: key-focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    if root.icon-only: Tooltip {
        Rectangle {
            background: Theme.solid;
            border-radius: 6px;
            max-width: 360px;
            VerticalLayout {
                padding: 9px;
                Text {
                    text: root.text;
                    color: Theme.on-brand;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }

    Rectangle {
        x: 0px;
        width: 3px;
        height: 14px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: Theme.brand;
        opacity: root.navigation && root.selected ? 1 : 0;
        animate opacity { duration: Theme.fast; }
    }

    if root.icon.width > 0: Image {
        x: root.icon-only || root.stacked-icon ? (parent.width - self.width) / 2 : 12px;
        y: (root.stacked-icon ? 16px : (parent.height - self.height) / 2) + root.press-offset;
        width: root.icon-width;
        height: root.icon-height;
        source: root.icon;
        image-fit: contain;
        colorize: root.icon-color;
        accessible-role: none;
    }
    if !root.icon-only: Text {
        x: !root.stacked-icon && root.icon.width > 0 ? root.icon-width + 21px : 12px;
        y: (root.stacked-icon ? root.icon-height + 24px : 0px) + root.press-offset;
        width: parent.width - self.x - 12px;
        height: parent.height - (root.stacked-icon ? self.y : 0px);
        text: root.text;
        color: root.primary ? Theme.on-brand : root.selected && !root.navigation ? Theme.brand : root.ghost && !hit-area.has-hover ? Theme.muted-text : Theme.primary-text;
        font-size: 12px;
        font-weight: root.selected || root.primary ? 600 : 400;
        horizontal-alignment: root.left-aligned ? left : center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
        animate color { duration: Theme.fast; }
    }
    if root.icon-only && root.icon.width == 0: Text {
        text: "+";
        color: Theme.muted-text;
        font-size: 24px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    hit-area := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { key-focus.focus(); root.clicked(); } }
    }

    key-focus := FocusScope {
        width: 0px;
        enabled <=> root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                if (root.enabled) { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.brand;
        opacity: key-focus.has-focus ? 1 : 0;
        animate opacity { duration: Theme.fast; }
    }
}

export component QuietCheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;
    height: 32px;
    min-width: root.text == "" ? 30px : label.preferred-width + 32px;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;
    animate opacity { duration: Theme.fast; }
    forward-focus: keyboard;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }
    function toggle() {
        if (root.enabled) { root.checked = !root.checked; root.toggled(); }
    }
    Rectangle {
        x: 3px;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.checked || touch.has-hover || keyboard.has-focus ? Theme.brand : Theme.border;
        background: root.checked ? Theme.brand : Theme.panel;
        animate background, border-color { duration: Theme.fast; }
        Image {
            x: 2px;
            y: root.checked ? 2px : 4px;
            width: 13px;
            height: 13px;
            source: @image-url("../assets/ui/check.svg");
            accessible-role: none;
            colorize: Theme.on-brand;
            opacity: root.checked ? 1 : 0;
            animate y, opacity {
                duration: Theme.fast;
                easing: ease-out;
            }
        }
    }

    label := Text {
        x: 30px;
        width: max(0px, parent.width - 30px);
        text: root.text;
        accessible-role: none;
        color: Theme.primary-text;
        font-size: 12px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.toggle(); }
    }

    keyboard := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space) { root.toggle(); return accept; }
            return reject;
        }
    }
}

// Style the field while TextInput keeps editing, selection, IME and password masking.
export component QuietLineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> enabled <=> input.enabled;
    in property <bool> read-only <=> input.read-only;
    in property <InputType> input-type <=> input.input-type;
    in property <InputMethodHints> input-method-hints <=> input.input-method-hints;
    in property <string> placeholder-text;
    in property <image> icon;
    in property <length> font-size <=> input.font-size;
    in property <string> font-family <=> input.font-family;
    in property <bool> font-italic <=> input.font-italic;
    in property <TextHorizontalAlignment> horizontal-alignment <=> input.horizontal-alignment;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback key-pressed(KeyEvent) -> EventResult;
    callback key-released(KeyEvent) -> EventResult;

    public function set-selection-offsets(anchor: int, focus: int) { input.set-selection-offsets(anchor, focus); }
    public function select-all() { input.select-all(); }
    public function clear-selection() { input.clear-selection(); }
    public function cut() { input.cut(); }
    public function copy() { input.copy(); }
    public function paste() { input.paste(); }
    public function undo() { input.undo(); }
    public function redo() { input.redo(); }

    min-width: 0px;
    min-height: 36px;
    preferred-width: 180px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.has-focus && root.enabled ? Theme.brand : hover.has-hover && root.enabled ? Theme.muted-text : Theme.border;
    background: !root.enabled || (hover.has-hover && !root.has-focus) ? Theme.raised : Theme.panel;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color, opacity {
        duration: Theme.fast;
        easing: ease-out;
    }
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-read-only: root.read-only;
    accessible-placeholder-text: root.placeholder-text;
    accessible-value: root.input-type == InputType.password ? "" : root.text;
    accessible-action-set-value(value) => { if (root.enabled && !root.read-only) { root.text = value; root.edited(value); } }
    accessible-action-set-selection-offsets(anchor, focus) => { input.set-selection-offsets(anchor, focus); }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 11px;
        border-width: 2px;
        border-color: Theme.brand.with-alpha(Theme.dark ? 0.2 : 0.16);
        opacity: root.has-focus && root.enabled ? 1 : 0;
        animate opacity {
            duration: Theme.fast;
            easing: ease-out;
        }
        accessible-role: none;
    }

    if root.icon.width > 0: Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.has-focus ? Theme.brand : Theme.muted-text;
        animate colorize { duration: Theme.fast; }
        accessible-role: none;
    }

    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }

        ContextMenuArea {
            x: root.icon.width > 0 ? 38px : 12px;
            y: 1px;
            width: max(0px, parent.width - self.x - 12px);
            height: parent.height - 2px;
            Menu {
                MenuItem {
                    title: "撤销";
                    enabled: !root.read-only;
                    activated => { input.undo(); }
                }

                MenuItem {
                    title: "重做";
                    enabled: !root.read-only;
                    activated => { input.redo(); }
                }

                MenuSeparator { }

                MenuItem {
                    title: "剪切";
                    enabled: !root.read-only && root.text != "";
                    activated => { input.cut(); }
                }

                MenuItem {
                    title: "复制";
                    enabled: root.text != "";
                    activated => { input.copy(); }
                }

                MenuItem {
                    title: "粘贴";
                    enabled: !root.read-only;
                    activated => { input.paste(); }
                }

                MenuItem {
                    title: "全选";
                    enabled: root.text != "";
                    activated => { input.select-all(); }
                }
            }

            Rectangle {
                clip: true;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
                    color: Theme.muted-text;
                    font-size: root.font-size;
                    font-family: root.font-family;
                    font-italic: root.font-italic;
                    horizontal-alignment: root.horizontal-alignment;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }

                input := TextInput {
                    property <length> scroll-x;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: parent.height;
                    font-size: 13px;
                    single-line: true;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    color: Theme.primary-text;
                    selection-background-color: Theme.brand-surface;
                    selection-foreground-color: Theme.primary-text;
                    accessible-role: none;
                    accepted => { root.accepted(self.text); }
                    edited => { root.edited(self.text); }
                    key-pressed(event) => { root.key-pressed(event) }
                    key-released(event) => { root.key-released(event) }
                    cursor-position-changed(position) => {
                        if position.x + self.scroll-x < 0px {
                            self.scroll-x = -position.x;
                        } else if position.x + self.scroll-x > parent.width - self.text-cursor-width {
                            self.scroll-x = parent.width - position.x - self.text-cursor-width;
                        }
                    }
                }
            }
        }
    }
}

export component QuietComboBox inherits Rectangle {
    in property <[string]> model <=> selection-state.model;
    in property <bool> enabled: true;
    in-out property <int> current-index <=> selection-state.current-index;
    in-out property <string> current-value <=> selection-state.current-value;
    out property <bool> has-focus: keyboard.has-focus || root.popup-open;
    callback selected(string);
    property <bool> popup-open: popup.is-open;
    property <int> visible-items: min(6, root.model.length);

    function select(index: int) {
        if (root.enabled && index >= 0 && index < root.model.length) {
            root.current-index = index;
            root.current-value = root.model[index];
            root.selected(root.current-value);
        }
    }
    function open-popup() {
        if (root.enabled && root.model.length > 0) { popup.show(); }
    }
    function handle-selection-key(event: KeyEvent) -> EventResult {
        if (event.text == Key.UpArrow) {
            root.select(max(0, root.current-index - 1));
            return accept;
        } else if (event.text == Key.DownArrow) {
            root.select(min(root.model.length - 1, root.current-index + 1));
            return accept;
        } else if (event.text == Key.Home) {
            root.select(0);
            return accept;
        } else if (event.text == Key.End) {
            root.select(root.model.length - 1);
            return accept;
        }
        return reject;
    }
    changed model => { if (root.model.length == 0) { popup.close(); } }
    changed enabled => { if (!root.enabled) { popup.close(); } }

    min-width: 0px;
    min-height: 36px;
    preferred-width: 180px;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.has-focus ? Theme.brand : touch.has-hover && root.enabled ? Theme.muted-text : Theme.border;
    background: root.popup-open || touch.pressed || (touch.has-hover && root.enabled) ? Theme.raised : Theme.panel;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color, opacity { duration: Theme.fast; }
    forward-focus: keyboard;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.popup-open;
    accessible-value <=> root.current-value;
    accessible-action-expand => { root.open-popup(); }

    // Reuse native index/value synchronization, including external value bindings.
    selection-state := ComboBox {
        visible: false;
        enabled: false;
        width: 0px;
        height: 0px;
        accessible-role: none;
    }

    Text {
        x: 12px;
        width: max(0px, parent.width - 42px);
        text: root.current-value;
        color: Theme.primary-text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    Image {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("../assets/ui/chevron-down.svg");
        colorize: root.popup-open ? Theme.brand : Theme.muted-text;
        transform-rotation: root.popup-open ? 180deg : 0deg;
        animate transform-rotation {
            duration: Theme.fast;
            easing: ease-out;
        }
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.open-popup(); }
    }

    keyboard := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.open-popup();
                return accept;
            }
            return root.handle-selection-key(event);
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 6px;
        width: max(root.width, 200px);
        height: root.visible-items * 40px + 10px;
        close-policy: close-on-click-outside;
        forward-focus: popup-keyboard;

        popup-keyboard := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == Key.Space || event.text == Key.Escape) {
                    popup.close();
                    return accept;
                } else if (event.text == Key.Tab || event.text == Key.Backtab) {
                    popup.close();
                    return reject;
                }
                return root.handle-selection-key(event);
            }
            Rectangle {
                background: Theme.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 5px;
                drop-shadow-color: Theme.dark ? #00000050 : #18221a18;

                ScrollView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    content-y: -max(0, root.current-index - root.visible-items + 1) * 40px;
                    property <int> selection: root.current-index;
                    changed selection => {
                        if (self.content-y + self.selection * 40px < 0px) {
                            self.content-y = -self.selection * 40px;
                        } else if (self.content-y + (self.selection + 1) * 40px + 8px > self.height) {
                            self.content-y = self.height - (self.selection + 1) * 40px - 8px;
                        }
                    }
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        alignment: start;
                        for value[index] in root.model: Rectangle {
                            height: 36px;
                            border-radius: 6px;
                            background: index == root.current-index ? Theme.brand-surface : item-touch.has-hover ? Theme.raised : transparent;
                            animate background { duration: Theme.fast; }
                            Text {
                                x: 10px;
                                width: max(0px, parent.width - 38px);
                                text: value;
                                color: index == root.current-index ? Theme.brand : Theme.primary-text;
                                font-size: 13px;
                                font-weight: index == root.current-index ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }

                            if index == root.current-index: Image {
                                x: parent.width - 24px;
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                source: @image-url("../assets/ui/check.svg");
                                colorize: Theme.brand;
                                accessible-role: none;
                            }
                            accessible-role: list-item;
                            accessible-label: value;
                            accessible-value: index == root.current-index ? "已选" : "";
                            accessible-action-default => { root.select(index); popup.close(); }
                            item-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select(index); popup.close(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// The panel stays mounted through its exit transition. Owners clear credentials
// when open becomes false, independently of the visual animation.
export component Drawer inherits Rectangle {
    in property <bool> open;
    in property <bool> busy: false;
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> error-message: "";
    in property <length> panel-width: 660px;
    callback dismissed();
    property <float> reveal: root.open ? 1 : 0;
    animate reveal {
        duration: Theme.drawer-motion;
        easing: cubic-bezier(0.2, 0.75, 0.25, 1);
    }
    visible: root.reveal > 0;
    accessible-role: none;
    changed open => { if (root.open) { keyboard.focus(); } }
    FocusScope {
        // Focus remains inside the modal's subtree during keyboard navigation.
        enabled: root.open;
        keyboard := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape && !root.busy) { root.dismissed(); return accept; }
                return reject;
            }
            Rectangle {
                background: Theme.scrim;
                opacity: root.reveal;
                TouchArea {
                    enabled: root.open && !root.busy;
                    clicked => { root.dismissed(); }
                }
            }

            Rectangle {
                x: root.width - self.width * root.reveal;
                width: min(root.panel-width, root.width);
                height: root.height;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                // Consume panel clicks so they never reach the scrim.
                TouchArea { }

                VerticalLayout {
                    padding: 26px;
                    spacing: 18px;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: root.title;
                                color: Theme.primary-text;
                                font-size: 23px;
                                font-weight: 600;
                            }

                            if root.subtitle != "": Text {
                                text: root.subtitle;
                                color: Theme.muted-text;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }

                        QuietButton {
                            text: "关闭";
                            width: 36px;
                            icon-only: true;
                            icon: @image-url("../assets/ui/close.svg");
                            icon-color: Theme.muted-text;
                            ghost: true;
                            enabled: !root.busy;
                            clicked => { root.dismissed(); }
                        }
                    }

                    if root.error-message != "": Text {
                        text: root.error-message;
                        color: Theme.error;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    @children
                }

                if !root.open: TouchArea { }
            }
        }
    }
}
