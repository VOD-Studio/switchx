import { ComboBox } from "std-widgets.slint";
import { QuietScrollView as ScrollView } from "scroll-view.slint";
import { Theme } from "tokens.slint";

// Bound by the owning Window so outside clicks can request an animated close.
export global DropdownViewport {
    in-out property <Point> size;
}

export component SurfaceCard {
    in property <brush> background: Theme.panel;
    in property <length> border-width: 1px;
    in property <color> border-color: Theme.border;
    in property <length> border-radius: 11px;
    preferred-width: 100%;
    preferred-height: 100%;
    Rectangle {
        width: root.width;
        height: root.height;
        background: root.background;
        border-width: root.border-width;
        border-color: root.border-color;
        border-radius: root.border-radius;
        animate background, border-color { duration: Theme.page-motion; }
    }

    @children
}

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> ink: Theme.muted-text;
    in property <color> fill: Theme.raised;
    width: 100px;
    height: 26px;
    border-radius: 6px;
    background: fill;
    animate background { duration: Theme.fast; }
    Text {
        text: root.label;
        color: root.ink;
        font-size: 11px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: Theme.fast; }
    }
}

export component QuietButton {
    in property <string> text;
    in property <string> description: "";
    in property <image> icon;
    in property <length> icon-width: 16px;
    in property <length> icon-height: 16px;
    in property <brush> icon-color: transparent;
    in property <bool> icon-only: false;
    in property <bool> stacked-icon: false;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <bool> ghost: false;
    in property <bool> navigation: false;
    in property <bool> tab: false;
    in property <bool> left-aligned: false;
    in property <angle> icon-angle: 0deg;
    in property <bool> loading: false;
    in property <bool> enabled <=> hit-area.enabled;
    callback clicked;
    property <bool> keyboard-pressed: false;
    property <length> press-offset: (hit-area.pressed || root.keyboard-pressed) && root.enabled ? 1px : 0px;
    property <angle> spin: root.loading ? 360deg : 0deg;
    animate spin {
        duration: root.loading && Theme.fast > 0ms ? 900ms : 0ms;
        iteration-count: root.loading ? -1 : 1;
    }
    changed enabled => { if (!root.enabled) { root.keyboard-pressed = false; } }
    animate press-offset {
        duration: Theme.fast;
        easing: ease-out;
    }

    height: 36px;
    min-width: root.icon-only ? 36px : 64px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    in property <length> border-radius: 8px;
    in property <length> border-width: root.ghost || root.navigation || root.tab ? 0px : 1px;
    in property <color> border-color: root.primary ? Theme.solid : root.selected ? Theme.brand : hit-area.has-hover ? Theme.muted-text : Theme.border;
    in property <brush> background: root.primary ? ((hit-area.pressed || root.keyboard-pressed) ? Theme.brand : hit-area.has-hover && root.enabled ? Theme.solid.with-alpha(0.9) : Theme.solid)
        : root.navigation && root.selected ? Theme.panel
        : root.selected && !root.tab ? Theme.brand-surface
        : hit-area.has-hover || hit-area.pressed || root.keyboard-pressed ? Theme.raised
        : root.ghost || root.navigation ? transparent : Theme.panel;
    forward-focus: key-focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text + (root.description == "" ? "" : "，" + root.description);
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    // Keep visual effects off the root so repeated buttons remain reusable subcomponents.
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: root.border-radius;
        border-width: root.border-width;
        border-color: root.border-color;
        background: root.background;
        opacity: root.enabled ? 1 : 0.42;
        animate background, border-color, opacity {
            duration: Theme.fast;
            easing: ease-out;
        }
        if root.icon-only: Tooltip {
            Rectangle {
                background: Theme.solid;
                border-radius: 6px;
                max-width: 360px;
                VerticalLayout {
                    padding: 9px;
                    Text {
                        text: root.text;
                        color: Theme.on-brand;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle {
            x: 0px;
            width: 3px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: Theme.brand;
            opacity: root.navigation && root.selected ? 1 : 0;
            animate opacity { duration: Theme.fast; }
        }

        if root.icon.width > 0: Image {
            x: root.icon-only || root.stacked-icon ? (parent.width - self.width) / 2 : 12px;
            y: (root.stacked-icon ? 16px : (parent.height - self.height) / 2) + root.press-offset;
            width: root.icon-width;
            height: root.icon-height;
            source: root.icon;
            image-fit: contain;
            colorize: root.icon-color;
            transform-rotation: root.icon-angle + root.spin;
            animate transform-rotation {
                duration: root.loading ? 0ms : Theme.fast;
                easing: ease-out;
            }
            accessible-role: none;
        }
        if !root.icon-only: Text {
            x: !root.stacked-icon && root.icon.width > 0 ? root.icon-width + 21px : 12px;
            y: (root.description != "" ? 14px : root.stacked-icon ? root.icon-height + 24px : 0px) + root.press-offset;
            width: parent.width - self.x - 12px;
            height: root.description != "" ? 20px : parent.height - (root.stacked-icon ? self.y : 0px);
            text: root.text;
            color: root.primary ? Theme.on-brand : root.selected && root.tab ? Theme.primary-text : root.selected && !root.navigation ? Theme.brand : root.ghost && !hit-area.has-hover ? Theme.muted-text : Theme.primary-text;
            font-size: root.description != "" ? 14px : 12px;
            font-weight: root.selected || root.primary ? 600 : 400;
            horizontal-alignment: root.left-aligned ? left : center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
            animate color { duration: Theme.fast; }
        }
        if root.description != "": Text {
            x: root.icon.width > 0 ? root.icon-width + 21px : 12px;
            y: 38px + root.press-offset;
            width: parent.width - self.x - 12px;
            height: 18px;
            text: root.description;
            color: Theme.muted-text;
            font-size: 12px;
            overflow: elide;
            accessible-role: none;
        }
        if root.icon-only && root.icon.width == 0: Text {
            text: "+";
            color: Theme.muted-text;
            font-size: 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }

        Rectangle {
            border-radius: 8px;
            border-width: 2px;
            border-color: Theme.brand;
            opacity: key-focus.has-focus ? 1 : 0;
            animate opacity { duration: Theme.fast; }
        }
    }

    hit-area := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { key-focus.focus(); root.clicked(); } }
    }

    key-focus := FocusScope {
        width: 0px;
        enabled <=> root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                if (root.enabled) { root.keyboard-pressed = true; }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                if (root.enabled && root.keyboard-pressed) { root.keyboard-pressed = false; root.clicked(); }
                return accept;
            }
            return reject;
        }
        changed has-focus => { if (!self.has-focus) { root.keyboard-pressed = false; } }
    }
}

export component QuietCheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> indeterminate: false;
    in property <bool> auto-toggle: true;
    in property <bool> enabled: true;
    callback toggled;
    height: 32px;
    min-width: root.text == "" ? 30px : label.preferred-width + 32px;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;
    animate opacity { duration: Theme.fast; }
    forward-focus: keyboard;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-value: root.indeterminate ? "部分选中" : root.checked ? "已选" : "未选";
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }
    function toggle() {
        if (root.enabled) {
            if (root.auto-toggle) { root.checked = !root.checked; }
            root.toggled();
        }
    }
    Rectangle {
        x: 3px;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.checked || root.indeterminate || touch.has-hover || keyboard.has-focus ? Theme.brand : Theme.border;
        background: root.checked || root.indeterminate ? Theme.brand : Theme.panel;
        animate background, border-color { duration: Theme.fast; }
        Image {
            x: 2px;
            y: root.checked ? 2px : 4px;
            width: 13px;
            height: 13px;
            source: @image-url("../assets/ui/check.svg");
            accessible-role: none;
            colorize: Theme.on-brand;
            opacity: root.checked && !root.indeterminate ? 1 : 0;
            animate y, opacity {
                duration: Theme.fast;
                easing: ease-out;
            }
        }

        Rectangle {
            x: 4px;
            y: 7px;
            width: 9px;
            height: 2px;
            border-radius: 1px;
            background: Theme.on-brand;
            visible: root.indeterminate;
            accessible-role: none;
        }
    }

    label := Text {
        x: 30px;
        width: max(0px, parent.width - 30px);
        text: root.text;
        accessible-role: none;
        color: Theme.primary-text;
        font-size: 12px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.toggle(); }
    }

    keyboard := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space) { root.toggle(); return accept; }
            return reject;
        }
    }
}

// Style the field while TextInput keeps editing, selection, IME and password masking.
export component QuietLineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> enabled <=> input.enabled;
    in property <bool> read-only <=> input.read-only;
    in property <InputType> input-type <=> input.input-type;
    in property <InputMethodHints> input-method-hints <=> input.input-method-hints;
    in property <string> placeholder-text;
    in property <image> icon;
    in property <length> font-size <=> input.font-size;
    in property <string> font-family <=> input.font-family;
    in property <bool> font-italic <=> input.font-italic;
    in property <TextHorizontalAlignment> horizontal-alignment <=> input.horizontal-alignment;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback key-pressed(KeyEvent) -> EventResult;
    callback key-released(KeyEvent) -> EventResult;

    public function set-selection-offsets(anchor: int, focus: int) { input.set-selection-offsets(anchor, focus); }
    public function select-all() { input.select-all(); }
    public function clear-selection() { input.clear-selection(); }
    public function cut() { input.cut(); }
    public function copy() { input.copy(); }
    public function paste() { input.paste(); }
    public function undo() { input.undo(); }
    public function redo() { input.redo(); }

    min-width: 0px;
    height: 36px;
    preferred-width: 180px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.has-focus && root.enabled ? Theme.brand : hover.has-hover && root.enabled ? Theme.muted-text : Theme.border;
    background: !root.enabled || (hover.has-hover && !root.has-focus) ? Theme.raised : Theme.panel;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color, opacity {
        duration: Theme.fast;
        easing: ease-out;
    }
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-read-only: root.read-only;
    accessible-placeholder-text: root.placeholder-text;
    accessible-value: root.input-type == InputType.password ? "" : root.text;
    accessible-action-set-value(value) => { if (root.enabled && !root.read-only) { root.text = value; root.edited(value); } }
    accessible-action-set-selection-offsets(anchor, focus) => { input.set-selection-offsets(anchor, focus); }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 11px;
        border-width: 2px;
        border-color: Theme.brand.with-alpha(Theme.dark ? 0.2 : 0.16);
        opacity: root.has-focus && root.enabled ? 1 : 0;
        animate opacity {
            duration: Theme.fast;
            easing: ease-out;
        }
        accessible-role: none;
    }

    if root.icon.width > 0: Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.has-focus ? Theme.brand : Theme.muted-text;
        animate colorize { duration: Theme.fast; }
        accessible-role: none;
    }

    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }

        ContextMenuArea {
            x: root.icon.width > 0 ? 38px : 12px;
            y: 1px;
            width: max(0px, parent.width - self.x - 12px);
            height: parent.height - 2px;
            Menu {
                MenuItem {
                    title: "撤销";
                    enabled: !root.read-only;
                    activated => { input.undo(); }
                }

                MenuItem {
                    title: "重做";
                    enabled: !root.read-only;
                    activated => { input.redo(); }
                }

                MenuSeparator { }

                MenuItem {
                    title: "剪切";
                    enabled: !root.read-only && root.text != "";
                    activated => { input.cut(); }
                }

                MenuItem {
                    title: "复制";
                    enabled: root.text != "";
                    activated => { input.copy(); }
                }

                MenuItem {
                    title: "粘贴";
                    enabled: !root.read-only;
                    activated => { input.paste(); }
                }

                MenuItem {
                    title: "全选";
                    enabled: root.text != "";
                    activated => { input.select-all(); }
                }
            }

            Rectangle {
                clip: true;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
                    color: Theme.muted-text;
                    font-size: root.font-size;
                    font-family: root.font-family;
                    font-italic: root.font-italic;
                    horizontal-alignment: root.horizontal-alignment;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }

                input := TextInput {
                    property <length> scroll-x;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: parent.height;
                    font-size: 13px;
                    single-line: true;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    color: Theme.primary-text;
                    selection-background-color: Theme.brand-surface;
                    selection-foreground-color: Theme.primary-text;
                    accessible-role: none;
                    accepted => { root.accepted(self.text); }
                    edited => { root.edited(self.text); }
                    key-pressed(event) => { root.key-pressed(event) }
                    key-released(event) => { root.key-released(event) }
                    cursor-position-changed(position) => {
                        if position.x + self.scroll-x < 0px {
                            self.scroll-x = -position.x;
                        } else if position.x + self.scroll-x > parent.width - self.text-cursor-width {
                            self.scroll-x = parent.width - position.x - self.text-cursor-width;
                        }
                    }
                }
            }
        }
    }
}

export component QuietComboBox inherits Rectangle {
    in property <[string]> model <=> selection-state.model;
    in property <bool> enabled: true;
    in property <bool> action-menu: false;
    in property <string> trigger-text: "";
    in property <image> trigger-icon;
    in property <bool> icon-only: false;
    in property <bool> primary: false;
    in property <[bool]> item-enabled: [];
    in property <int> destructive-index: -1;
    in property <string> action-context;
    in-out property <int> current-index <=> selection-state.current-index;
    in-out property <string> current-value <=> selection-state.current-value;
    out property <bool> has-focus: keyboard.has-focus || root.popup-mounted;
    callback selected(string);
    property <bool> popup-open: false;
    property <bool> popup-mounted: popup.is-open;
    property <bool> popup-entered: false;
    property <float> popup-reveal: root.popup-open && root.popup-entered ? 1 : 0;
    property <duration> popup-motion: root.popup-open ? Theme.fast : Theme.fast * 0.8;
    property <int> visible-items: min(6, root.model.length);
    property <int> menu-index: 0;
    property <int> highlight-index: root.action-menu ? root.menu-index : root.current-index;
    property <string> pending-action: "";
    property <string> pending-context;
    property <int> pending-index: -1;
    animate popup-reveal {
        duration: root.popup-motion;
        easing: ease-out;
    }

    Timer {
        interval: 16ms;
        running: root.popup-open && !root.popup-entered;
        triggered => { root.popup-entered = true; }
    }

    Timer {
        interval: root.popup-motion;
        running: root.popup-mounted && !root.popup-open;
        triggered => { popup.close(); }
    }

    changed popup-mounted => {
        if (!root.popup-mounted) {
            root.popup-open = false;
            root.popup-entered = false;
            if (root.pending-action != "" && root.enabled && root.pending-context == root.action-context && root.item-is-enabled(root.pending-index) && root.model[root.pending-index] == root.pending-action) { root.selected(root.pending-action); }
            root.pending-action = "";
        }
    }

    function item-is-enabled(index: int) -> bool {
        return index >= 0 && index < root.model.length && (root.item-enabled.length <= index || root.item-enabled[index]);
    }
    function select(index: int) {
        if (root.enabled && root.item-is-enabled(index)) {
            if (root.action-menu) {
                root.pending-action = root.model[index];
                root.pending-index = index;
                root.pending-context = root.action-context;
                root.close-popup();
            } else {
                root.current-index = index;
                root.current-value = root.model[index];
                root.selected(root.current-value);
            }
        }
    }
    function open-popup() {
        if (root.enabled && root.model.length > 0 && root.pending-action == "") {
            if (!root.popup-mounted) {
                root.popup-entered = Theme.fast == 0ms;
                root.menu-index = 0;
                popup.show();
            }
            root.popup-open = true;
        }
    }
    public function close-popup() {
        root.popup-open = false;
        if (Theme.fast == 0ms) { popup.close(); }
    }
    public function cancel-popup() { root.pending-action = ""; root.close-popup(); }
    function handle-selection-key(event: KeyEvent) -> EventResult {
        if (root.action-menu) {
            if (event.text == Key.UpArrow) { root.menu-index = max(0, root.menu-index - 1); return accept; }
            if (event.text == Key.DownArrow) { root.menu-index = min(root.model.length - 1, root.menu-index + 1); return accept; }
            if (event.text == Key.Home) { root.menu-index = 0; return accept; }
            if (event.text == Key.End) { root.menu-index = root.model.length - 1; return accept; }
            return reject;
        }
        if (event.text == Key.UpArrow) {
            root.select(max(0, root.current-index - 1));
            return accept;
        } else if (event.text == Key.DownArrow) {
            root.select(min(root.model.length - 1, root.current-index + 1));
            return accept;
        } else if (event.text == Key.Home) {
            root.select(0);
            return accept;
        } else if (event.text == Key.End) {
            root.select(root.model.length - 1);
            return accept;
        }
        return reject;
    }
    changed model => { if (root.action-menu || root.model.length == 0) { root.cancel-popup(); } }
    changed enabled => { if (!root.enabled) { root.pending-action = ""; root.close-popup(); } }

    min-width: 0px;
    min-height: 36px;
    preferred-width: 180px;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: root.action-menu && !root.primary ? 0px : 1px;
    border-color: root.primary ? Theme.solid : root.has-focus ? Theme.brand : touch.has-hover && root.enabled ? Theme.muted-text : Theme.border;
    background: root.primary ? (touch.pressed ? Theme.brand : touch.has-hover && root.enabled ? Theme.solid.with-alpha(0.9) : Theme.solid) : root.popup-open || touch.pressed || (touch.has-hover && root.enabled) ? Theme.raised : root.action-menu ? transparent : Theme.panel;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color, opacity { duration: Theme.fast; }
    forward-focus: keyboard;
    accessible-role: combobox;
    accessible-label: root.trigger-text;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.popup-open;
    accessible-value: root.action-menu ? "" : root.current-value;
    accessible-action-default => { root.open-popup(); }
    accessible-action-expand => { root.open-popup(); }

    // Reuse native index/value synchronization, including external value bindings.
    if root.action-menu: Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.brand;
        opacity: keyboard.has-focus ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        accessible-role: none;
    }
    selection-state := ComboBox {
        visible: false;
        enabled: false;
        width: 0px;
        height: 0px;
        accessible-role: none;
    }

    if !root.icon-only: Text {
        x: root.trigger-icon.width > 0 ? 36px : 12px;
        width: max(0px, parent.width - self.x - 30px);
        text: root.trigger-text == "" ? root.current-value : root.trigger-text;
        color: root.primary ? Theme.on-brand : Theme.primary-text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    if root.trigger-icon.width > 0: Image {
        x: root.icon-only ? (parent.width - self.width) / 2 : 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.trigger-icon;
        colorize: root.primary ? Theme.on-brand : root.has-focus ? Theme.brand : Theme.muted-text;
        animate colorize { duration: Theme.fast; }
        accessible-role: none;
    }
    if !root.icon-only: Image {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("../assets/ui/chevron-down.svg");
        colorize: root.primary ? Theme.on-brand : root.popup-open ? Theme.brand : Theme.muted-text;
        transform-rotation: root.popup-open ? 180deg : 0deg;
        animate transform-rotation {
            duration: Theme.fast;
            easing: ease-out;
        }
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.open-popup(); }
    }

    keyboard := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.open-popup();
                return accept;
            }
            if (root.action-menu && (event.text == Key.UpArrow || event.text == Key.DownArrow)) { root.open-popup(); return accept; }
            return root.handle-selection-key(event);
        }
    }

    popup := PopupWindow {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: DropdownViewport.size.x;
        height: DropdownViewport.size.y;
        property <Point> viewport-size: DropdownViewport.size;
        changed viewport-size => { self.width = self.viewport-size.x; self.height = self.viewport-size.y; }
        close-policy: no-auto-close;
        forward-focus: popup-keyboard;

        popup-keyboard := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == Key.Space || event.text == Key.Escape) {
                    if (!root.popup-open && event.text != Key.Escape) {
                        root.open-popup();
                    } else if (root.action-menu && event.text != Key.Escape) {
                        root.select(root.menu-index);
                    } else {
                        root.close-popup();
                    }
                    return accept;
                } else if (event.text == Key.Tab || event.text == Key.Backtab) {
                    // Release the native focus grab before Tab moves to the next control.
                    root.close-popup();
                    popup.close();
                    return reject;
                }
                return root.popup-open ? root.handle-selection-key(event) : accept;
            }
            TouchArea {
                clicked => {
                    if (!root.popup-open && self.mouse-x >= root.absolute-position.x && self.mouse-x <= root.absolute-position.x + root.width && self.mouse-y >= root.absolute-position.y && self.mouse-y <= root.absolute-position.y + root.height) {
                        root.open-popup();
                    } else {
                        root.close-popup();
                    }
                }
            }

            Rectangle {
                width: min(max(root.width, 200px), parent.width);
                height: min(root.visible-items * 40px + 10px, parent.height);
                x: max(0px, min(root.action-menu ? root.absolute-position.x + root.width - self.width : root.absolute-position.x, parent.width - self.width));
                property <bool> above: root.absolute-position.y + root.height + 6px + self.height > parent.height;
                y: (self.above ? max(0px, root.absolute-position.y - self.height - 6px) : root.absolute-position.y + root.height + 6px) + (self.above ? 5px : -5px) * (1 - root.popup-reveal);
                opacity: root.popup-reveal;
                background: Theme.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 5px;
                drop-shadow-color: Theme.dark ? #00000050 : #18221a18;

                // Consume padding clicks, including while the panel is fading out.
                TouchArea { }

                ScrollView {
                    enabled: root.popup-open && root.enabled;
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    vertical-scrollbar-policy: root.model.length * 40px + 8px > self.height ? as-needed : always-off;
                    horizontal-scrollbar-policy: always-off;
                    content-y: -max(0, root.highlight-index - root.visible-items + 1) * 40px;
                    property <int> selection: root.highlight-index;
                    changed selection => {
                        if (self.content-y + self.selection * 40px < 0px) {
                            self.content-y = -self.selection * 40px;
                        } else if (self.content-y + (self.selection + 1) * 40px + 8px > self.height) {
                            self.content-y = self.height - (self.selection + 1) * 40px - 8px;
                        }
                    }
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        alignment: start;
                        for value[index] in root.model: Rectangle {
                            height: 36px;
                            border-radius: 6px;
                            background: root.item-is-enabled(index) && (index == root.highlight-index || item-touch.has-hover) ? (root.action-menu ? Theme.raised : index == root.current-index ? Theme.brand-surface : Theme.raised) : transparent;
                            opacity: root.item-is-enabled(index) ? 1 : 0.42;
                            animate opacity { duration: Theme.fast; }
                            animate background { duration: Theme.fast; }
                            Text {
                                x: 10px;
                                width: max(0px, parent.width - 38px);
                                text: value;
                                color: index == root.destructive-index ? Theme.error : !root.action-menu && index == root.current-index ? Theme.brand : Theme.primary-text;
                                font-size: 13px;
                                font-weight: !root.action-menu && index == root.current-index ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }

                            if !root.action-menu && index == root.current-index: Image {
                                x: parent.width - 24px;
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                source: @image-url("../assets/ui/check.svg");
                                colorize: Theme.brand;
                                accessible-role: none;
                            }
                            accessible-role: list-item;
                            accessible-label: value;
                            accessible-value: !root.action-menu && index == root.current-index ? "已选" : "";
                            accessible-enabled: root.popup-open && root.enabled && root.item-is-enabled(index);
                            accessible-action-default => {
                                if (root.popup-open) { root.select(index); root.close-popup(); }
                            }
                            item-touch := TouchArea {
                                enabled: root.popup-open && root.enabled && root.item-is-enabled(index);
                                mouse-cursor: pointer;
                                clicked => { root.select(index); root.close-popup(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Equal segments with a raised thumb that glides, slightly overshooting, to the
// current one. The owner applies `selected`; Left and Right also select.
export component QuietSegmented inherits Rectangle {
    in property <[string]> options;
    in property <bool> enabled: true;
    in property <int> current-index;
    callback selected(int);
    private property <length> segment: (root.width - 6px) / max(1, root.options.length);
    function choose(index: int) {
        if (root.enabled && index >= 0 && index < root.options.length && index != root.current-index) {
            root.selected(index);
        }
    }

    height: 32px;
    min-width: 120px;
    horizontal-stretch: 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.inset;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color, opacity { duration: Theme.fast; }
    forward-focus: keyboard;
    accessible-role: tab-list;

    Rectangle {
        x: 3px + root.segment * root.current-index;
        y: 3px;
        width: root.segment;
        height: parent.height - 6px;
        border-radius: 7px;
        border-width: 1px;
        border-color: keyboard.has-focus ? Theme.brand : Theme.border;
        background: Theme.panel;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.dark ? #00000048 : #18221a16;
        animate x {
            duration: Theme.page-motion;
            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
        }
        animate background, border-color { duration: Theme.fast; }
        accessible-role: none;
    }

    for option[index] in root.options: Rectangle {
        x: 3px + root.segment * index;
        y: 3px;
        width: root.segment;
        height: parent.height - 6px;
        accessible-role: tab;
        accessible-label: option;
        accessible-item-selected: index == root.current-index;
        accessible-action-default => { root.choose(index); }
        Text {
            text: option;
            color: index == root.current-index ? Theme.primary-text : segment-touch.has-hover ? Theme.primary-text.with-alpha(0.8) : Theme.muted-text;
            font-size: 12px;
            font-weight: index == root.current-index ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: Theme.fast; }
            accessible-role: none;
        }

        segment-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { keyboard.focus(); root.choose(index); }
        }
    }

    keyboard := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) { root.choose(root.current-index - 1); return accept; }
            if (event.text == Key.RightArrow) { root.choose(root.current-index + 1); return accept; }
            return reject;
        }
    }
}

// Keep content mounted while its height and opacity animate in either direction.
export component AnimatedSection inherits Rectangle {
    in property <bool> expanded;
    in property <length> content-height;
    out property <float> reveal: root.expanded ? 1 : 0;
    animate reveal {
        duration: Theme.page-motion;
        easing: cubic-bezier(0.22, 1, 0.36, 1);
    }
    height: root.content-height * root.reveal;
    preferred-height: root.height;
    vertical-stretch: 0;
    clip: true;
    opacity: root.reveal;
    visible: root.reveal > 0;
    @children
}

// The panel stays mounted through its exit transition. Owners clear credentials
// when open becomes false, independently of the visual animation.
export component Drawer inherits Rectangle {
    forward-focus: keyboard;
    in property <bool> open;
    in property <bool> busy: false;
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> error-message: "";
    in property <length> panel-width: 660px;
    in property <bool> centered: false;
    callback dismissed();
    property <float> reveal: root.open ? 1 : 0;
    animate reveal {
        duration: Theme.drawer-motion;
        easing: cubic-bezier(0.2, 0.75, 0.25, 1);
    }
    visible: root.reveal > 0;
    accessible-role: none;
    changed open => { if (root.open) { keyboard.focus(); } }
    FocusScope {
        // Focus remains inside the modal's subtree during keyboard navigation.
        enabled: root.open;
        keyboard := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape && !root.busy) { root.dismissed(); return accept; }
                return reject;
            }
            Rectangle {
                background: Theme.scrim;
                opacity: root.reveal;
                TouchArea {
                    enabled: root.open && !root.busy;
                    clicked => { root.dismissed(); }
                }
            }

            Rectangle {
                x: root.centered ? (root.width - self.width) / 2 : root.width - self.width * root.reveal;
                y: root.centered ? (root.height - self.height) / 2 + 8px * (1 - root.reveal) : 0px;
                width: min(root.panel-width, root.centered ? max(0px, root.width - 48px) : root.width);
                height: root.centered ? min(max(0px, root.height - 48px), panel-layout.preferred-height) : root.height;
                opacity: root.centered ? root.reveal : 1;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: root.centered ? 18px : 0px;
                drop-shadow-blur: root.centered ? 24px : 0px;
                drop-shadow-offset-y: root.centered ? 8px : 0px;
                drop-shadow-color: Theme.dark ? #00000038 : #23332818;
                // Consume panel clicks so they never reach the scrim.
                TouchArea { }

                panel-layout := VerticalLayout {
                    padding: root.centered ? 24px : 26px;
                    spacing: 18px;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: root.title;
                                color: Theme.primary-text;
                                font-size: 23px;
                                font-weight: 600;
                            }

                            if root.subtitle != "": Text {
                                text: root.subtitle;
                                color: Theme.muted-text;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }

                        QuietButton {
                            y: root.centered ? (parent.height - self.height) / 2 : 0px;
                            text: "关闭";
                            width: 36px;
                            icon-only: true;
                            icon: @image-url("../assets/ui/close.svg");
                            icon-color: Theme.muted-text;
                            ghost: true;
                            enabled: !root.busy;
                            clicked => { root.dismissed(); }
                        }
                    }

                    if root.error-message != "": Text {
                        text: root.error-message;
                        color: Theme.error;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    @children
                }

                if !root.open: TouchArea { }
            }
        }
    }
}
