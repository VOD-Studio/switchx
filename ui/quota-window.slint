import { Theme } from "tokens.slint";
import { XaiQuotaRow } from "view-models.slint";

// One quota row: label, remaining bar, remaining percentage and reset time.
// The bar stretches so every column lines up across rows and cards.
export component QuotaWindow inherits HorizontalLayout {
    in property <XaiQuotaRow> quota;
    in property <length> label-width: 60px;
    in property <bool> loading: false;
    property <float> remaining: max(0, min(100, root.quota.remaining-percent));
    property <color> tone: root.quota.remaining-percent <= 0 ? Theme.error : root.quota.remaining-percent < 10 ? Theme.warning : Theme.brand;
    // The fill grows from empty when the row first appears, then follows updates.
    property <bool> filled: Theme.page-motion == 0ms;
    property <float> pulse: root.loading && Theme.fast > 0ms ? 1 : 0;
    animate pulse {
        duration: root.loading && Theme.fast > 0ms ? 900ms : 0ms;
        iteration-count: root.loading ? -1 : 1;
        direction: alternate;
        easing: ease-in-out;
    }
    height: 20px;
    spacing: 12px;
    Timer {
        interval: 120ms;
        running: !root.filled;
        triggered => { root.filled = true; }
    }

    Text {
        width: root.label-width;
        horizontal-stretch: 0;
        text: root.quota.period-label;
        color: Theme.muted-text;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        height: 6px;
        y: (parent.height - self.height) / 2;
        min-width: 60px;
        horizontal-stretch: 1;
        border-radius: 3px;
        background: Theme.border;
        accessible-role: progress-indicator;
        accessible-label: root.quota.period-label + "剩余 " + round(root.quota.remaining-percent) + "%";
        accessible-value: round(root.quota.remaining-percent) + "%";
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.filled ? parent.width * root.remaining / 100 : 0px;
            height: parent.height;
            border-radius: 3px;
            background: root.tone;
            opacity: 1 - 0.5 * root.pulse;
            animate width {
                duration: Theme.page-motion * 2.5;
                easing: cubic-bezier(0.22, 1, 0.36, 1);
            }
        }
    }

    Text {
        width: 68px;
        horizontal-stretch: 0;
        text: "剩余 " + round(root.quota.remaining-percent) + "%";
        color: root.quota.remaining-percent <= 0 ? Theme.error : root.quota.remaining-percent < 10 ? Theme.warning : Theme.primary-text;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }

    Text {
        width: 112px;
        horizontal-stretch: 0;
        text: root.quota.reset-label;
        color: Theme.muted-text;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component QuotaWindowDetail inherits VerticalLayout {
    in property <XaiQuotaRow> quota;
    height: 36px;
    spacing: 4px;
    QuotaWindow {
        quota: root.quota;
        label-width: 74px;
    }

    Text {
        height: 14px;
        text: root.quota.reset-detail;
        font-size: 11px;
        color: Theme.muted-text;
        vertical-alignment: center;
    }
}
