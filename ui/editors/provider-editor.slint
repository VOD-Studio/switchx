import { Theme } from "../tokens.slint";
import {
    AnimatedSection,
    StatusPill,
    QuietButton,
    SurfaceCard,
    QuietLineEdit as LineEdit,
    QuietComboBox as ComboBox,
} from "../components.slint";
import { QuietScrollView as ScrollView } from "../scroll-view.slint";
import { ConnectionOption, ConnectionField } from "connection-controls.slint";
import { CodeEditor } from "../code-editor.slint";
import { FeedbackBanner } from "../feedback-banner.slint";
import { ModelQuickPicker } from "model-quick-picker.slint";
import { BatchModelRow, BatchSummary } from "../view-models.slint";

export component ProviderEditor inherits SurfaceCard {
    in property <bool> busy;
    in property <bool> compact;
    in-out property <bool> editor-open;
    in-out property <bool> delete-confirm;
    in property <string> edit-id;
    in-out property <string> edit-name;
    in-out property <string> edit-url;
    in-out property <string> edit-model;
    in-out property <string> edit-key;
    in-out property <bool> edit-remote-compaction;
    in-out property <bool> edit-use-common-config;
    in-out property <bool> edit-context-1m;
    in-out property <string> edit-compact-limit;
    in property <string> edit-config-preview;
    in property <string> edit-config-error;
    in property <string> edit-preset-id;
    in property <string> edit-icon-name;
    in property <image> edit-icon;
    in property <bool> edit-icon-monochrome;
    in property <[string]> fetched-models;
    in property <bool> fetching-models;
    in property <string> discovery-message;
    in property <int> discovery-scope;
    in property <int> discovery-tone;
    in property <bool> config-managed;
    // Discovered models a new upstream can add as mappings when it is saved.
    in property <[BatchModelRow]> batch-rows;
    in property <BatchSummary> batch-summary;
    in-out property <string> batch-query;
    callback batch-toggle(int);
    callback batch-select-all(bool);
    callback batch-filter(string);
    callback save-provider(string, string, string, string, string);
    callback open-common-config();
    callback delete-provider(string);
    callback open-provider-preset-link(bool);
    callback open-provider-icon-picker();
    callback fetch-models(int);
    callback dismiss-discovery();

    private property <bool> preview-expanded: false;
    private property <bool> options-expanded: false;
    private property <bool> models-visible: false;
    private property <float> side-reveal: root.preview-expanded ? 0 : 1;
    animate side-reveal {
        duration: Theme.drawer-motion;
        easing: cubic-bezier(0.22, 1, 0.36, 1);
    }
    private property <bool> landed: false;
    private property <float> arrival: root.landed ? 1 : 0;
    animate arrival {
        duration: Theme.drawer-motion;
        easing: ease-out;
    }
    Timer {
        interval: 48ms;
        running: !root.landed;
        triggered => { root.landed = true; }
    }

    changed batch-rows => {
        if root.batch-rows.length > 0 && root.edit-id == "" { root.models-visible = true; root.preview-expanded = false; }
    }
    vertical-stretch: 1;
    min-height: 300px;
    VerticalLayout {
        spacing: 16px;
        HorizontalLayout {
            spacing: 20px * root.side-reveal;
            // Keep both columns mounted while the preview widens.
            Rectangle {
                width: 292px * root.side-reveal;
                horizontal-stretch: 0;
                clip: true;
                visible: root.side-reveal > 0;
                opacity: root.side-reveal * (Theme.drawer-motion == 0ms ? 1 : root.arrival);
                ScrollView {
                    width: 292px;
                    enabled: !root.preview-expanded;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding-right: 4px;
                        spacing: root.compact ? 10px : 18px;
                        alignment: start;
                        Rectangle {
                            height: root.compact ? 72px : 84px;
                            border-radius: 14px;
                            background: Theme.brand-surface.with-alpha(0.5);
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 12px;
                                cross-axis-alignment: center;
                                QuietButton {
                                    width: 58px;
                                    height: 58px;
                                    horizontal-stretch: 0;
                                    text: "选择上游头像";
                                    icon-only: true;
                                    icon: root.edit-icon;
                                    icon-width: root.edit-icon.width > root.edit-icon.height * 2 ? 44px : 30px;
                                    icon-height: 30px;
                                    icon-color: root.edit-icon-monochrome ? Theme.primary-text : transparent;
                                    background: Theme.panel;
                                    border-radius: 12px;
                                    enabled: !root.busy && !root.config-managed;
                                    clicked => { root.open-provider-icon-picker(); }
                                }

                                VerticalLayout {
                                    spacing: 5px;
                                    alignment: center;
                                    Text {
                                        text: root.edit-name == "" ? "新的 API 连接" : root.edit-name;
                                        color: Theme.primary-text;
                                        font-size: 17px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: (root.edit-icon-name == "" ? "自定义" : root.edit-icon-name) + " · 点击头像更换";
                                        color: Theme.muted-text;
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            height: 20px;
                            cross-axis-alignment: center;
                            Text {
                                text: "连接信息";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.primary-text;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            StatusPill {
                                width: 44px;
                                height: 20px;
                                label: "API";
                                ink: Theme.brand;
                                fill: Theme.brand-surface;
                            }
                        }

                        ConnectionField {
                            label: "连接名称";
                            LineEdit {
                                text <=> root.edit-name;
                                placeholder-text: "例如 DeepSeek";
                                accessible-label: "上游名称";
                                enabled: !root.busy && !root.config-managed;
                            }
                        }

                        ConnectionField {
                            label: "API 地址";
                            LineEdit {
                                text <=> root.edit-url;
                                placeholder-text: "https://example.com/v1";
                                accessible-label: "上游 API 地址";
                                enabled: !root.busy && !root.config-managed;
                            }
                        }

                        ConnectionField {
                            label: "默认模型 ID";
                            LineEdit {
                                text <=> root.edit-model;
                                placeholder-text: "上游实际模型 ID";
                                accessible-label: "上游模型 ID";
                                enabled: !root.busy && !root.config-managed;
                            }

                            if root.discovery-scope == 0 && root.fetched-models.length > 0 && root.edit-id != "": ComboBox {
                                model: root.fetched-models;
                                current-value: root.edit-model;
                                accessible-label: "选择探测到的默认模型";
                                enabled: !root.busy && !root.config-managed;
                                selected(value) => { root.edit-model = value; }
                            }
                        }

                        ConnectionField {
                            label: "API Key";
                            LineEdit {
                                text <=> root.edit-key;
                                input-type: password;
                                icon: @image-url("../../assets/ui/lock.svg");
                                placeholder-text: root.edit-id == "" ? "输入 API Key" : "留空保留已保存的 Key";
                                accessible-label: "上游 API Key";
                                enabled: !root.busy && !root.config-managed;
                            }
                        }

                        QuietButton {
                            text: root.fetching-models && root.discovery-scope == 0 ? "正在获取模型…" : "获取模型列表";
                            icon: root.fetching-models && root.discovery-scope == 0 ? @image-url("../../assets/ui/loader.svg") : @image-url("../../assets/refresh.svg");
                            icon-width: 14px;
                            icon-height: 14px;
                            icon-color: Theme.brand;
                            loading: root.fetching-models && root.discovery-scope == 0;
                            enabled: !root.busy && !root.config-managed && root.edit-url != "" && (root.edit-key != "" || root.edit-id != "");
                            clicked => { root.fetch-models(0); }
                        }

                        if root.edit-preset-id != "": HorizontalLayout {
                            spacing: 8px;
                            QuietButton {
                                text: "官方网站 ↗";
                                ghost: true;
                                enabled: !root.busy;
                                clicked => { root.open-provider-preset-link(false); }
                            }

                            QuietButton {
                                text: "获取 API Key ↗";
                                ghost: true;
                                enabled: !root.busy;
                                clicked => { root.open-provider-preset-link(true); }
                            }
                        }
                        Text {
                            text: root.edit-id == "" ? "保存连接后，继续准备模型目录。" : "连接与模型目录分别保存。";
                            color: Theme.muted-text;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                opacity: Theme.drawer-motion == 0ms ? 1 : root.arrival;
                VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        height: 44px;
                        spacing: 10px;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 11px;
                            background: Theme.brand-surface;
                            Image {
                                x: 10px;
                                y: 10px;
                                width: 18px;
                                height: 18px;
                                source: @image-url("../../assets/ui/code.svg");
                                colorize: Theme.brand;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.models-visible ? "发现的模型" : "Codex 配置";
                                font-size: 16px;
                                font-weight: 600;
                                color: Theme.primary-text;
                            }

                            Text {
                                text: root.models-visible ? "选择常用模型，一起保存到连接" : "config.toml · 实时预览" + (root.edit-context-1m ? " · 1M" : "");
                                font-size: 11px;
                                color: Theme.muted-text;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        if !root.models-visible && !root.preview-expanded: QuietButton {
                            width: 108px;
                            height: 32px;
                            text: root.options-expanded ? "收起选项" : "配置选项";
                            ghost: true;
                            icon: @image-url("../../assets/ui/chevron-down.svg");
                            icon-color: Theme.muted-text;
                            icon-angle: root.options-expanded ? 180deg : 0deg;
                            enabled: !root.busy;
                            clicked => { root.options-expanded = !root.options-expanded; }
                        }

                        if root.batch-rows.length > 0: QuietButton {
                            width: 112px;
                            text: root.models-visible ? "返回配置预览" : "查看获取结果";
                            ghost: true;
                            clicked => { root.models-visible = !root.models-visible; }
                        }
                        QuietButton {
                            width: 36px;
                            text: root.preview-expanded ? "退出宽屏预览" : "放大配置预览";
                            icon-only: true;
                            icon: @image-url("../../assets/ui/expand.svg");
                            icon-color: root.preview-expanded ? Theme.brand : Theme.muted-text;
                            selected: root.preview-expanded;
                            enabled: !root.busy;
                            clicked => { root.preview-expanded = !root.preview-expanded; root.models-visible = false; }
                        }
                    }

                    discovery-banner := FeedbackBanner {
                        tone: root.discovery-scope == 0 ? root.discovery-tone : 0;
                        loading: root.discovery-scope == 0 && root.fetching-models;
                        title: root.discovery-tone == 3 ? "获取模型列表失败" : "";
                        message: root.discovery-scope == 0 ? root.discovery-message : "";
                        target: root.discovery-tone == 3 ? root.edit-url : "";
                        hint: root.discovery-tone == 3 ? "确认地址可访问、API Key 有效后重试" : "";
                        retryable: true;
                        dismissible: true;
                        actions-enabled: !root.busy && root.edit-url != "" && (root.edit-key != "" || root.edit-id != "");
                        retry => { root.fetch-models(0); }
                        dismiss => { root.dismiss-discovery(); }
                    }

                    options := AnimatedSection {
                        expanded: root.options-expanded && !root.preview-expanded && !root.models-visible;
                        content-height: 106px + threshold.height;
                        VerticalLayout {
                            height: options.content-height;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 58px;
                                spacing: 8px;
                                ConnectionOption {
                                    title: "通用配置";
                                    detail: "继承已保存的偏好";
                                    checked <=> root.edit-use-common-config;
                                    enabled: !root.busy && !root.config-managed;
                                }

                                ConnectionOption {
                                    title: "远程压缩";
                                    detail: "支持 /responses/compact";
                                    checked <=> root.edit-remote-compaction;
                                    enabled: !root.busy && !root.config-managed;
                                }
                            }

                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;
                                QuietButton {
                                    text: root.edit-context-1m ? "✓  1M 上下文" : "1M 上下文";
                                    selected: root.edit-context-1m;
                                    height: 32px;
                                    width: 136px;
                                    accessible-label: "设置一百万 token 上下文窗口";
                                    accessible-role: checkbox;
                                    accessible-checked: root.edit-context-1m;
                                    enabled: !root.busy && !root.config-managed;
                                    clicked => { root.edit-context-1m = !root.edit-context-1m; }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                QuietButton {
                                    height: 32px;
                                    width: 128px;
                                    text: "编辑通用配置 ↗";
                                    ghost: true;
                                    enabled: !root.busy && !root.config-managed;
                                    clicked => { root.open-common-config(); }
                                }
                            }

                            threshold := AnimatedSection {
                                expanded: root.edit-context-1m;
                                content-height: 40px;
                                HorizontalLayout {
                                    height: 36px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: "自动压缩阈值";
                                        color: Theme.muted-text;
                                        font-size: 11px;
                                    }

                                    LineEdit {
                                        width: 128px;
                                        horizontal-stretch: 0;
                                        text <=> root.edit-compact-limit;
                                        input-type: number;
                                        placeholder-text: "900000";
                                        accessible-label: "自动压缩 token 阈值";
                                        enabled: root.edit-context-1m && !root.busy && !root.config-managed;
                                    }

                                    Text {
                                        text: "tokens";
                                        color: Theme.muted-text;
                                        font-size: 11px;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }

                    if root.models-visible: ScrollView {
                        VerticalLayout {
                            alignment: start;
                            ModelQuickPicker {
                                rows: root.batch-rows;
                                summary: root.batch-summary;
                                default-id: root.edit-model;
                                enabled: !root.busy;
                                query <=> root.batch-query;
                                toggle(index) => { root.batch-toggle(index); }
                                select-all(checked) => { root.batch-select-all(checked); }
                                filter(query) => { root.batch-filter(query); }
                                make-default(id) => { root.edit-model = id; }
                            }
                        }
                    }
                    if !root.models-visible: Rectangle {
                        vertical-stretch: 1;
                        min-height: 160px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.inset;
                        clip: true;
                        VerticalLayout {
                            Rectangle {
                                height: 36px;
                                background: Theme.raised.with-alpha(0.5);
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 8px;
                                    cross-axis-alignment: center;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: root.edit-config-error == "" ? Theme.brand : Theme.error;
                                    }

                                    Text {
                                        text: "config.toml";
                                        color: Theme.primary-text;
                                        font-family: "Menlo";
                                        font-size: 11px;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "TOML  /  只读";
                                        color: Theme.muted-text;
                                        font-size: 10px;
                                    }
                                }
                            }

                            CodeEditor {
                                vertical-stretch: 1;
                                text: root.edit-config-preview;
                                read-only: true;
                                background: Theme.inset;
                                border-width: 0px;
                                border-radius: 0px;
                                show-line-numbers: true;
                                content-padding: 14px;
                                accessible-label: "Codex config.toml 配置预览";
                            }

                            Rectangle {
                                height: 30px;
                                background: Theme.raised.with-alpha(0.35);
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: root.edit-config-error == "" ? "● 配置已生成" : "● 配置需要修正";
                                        color: root.edit-config-error == "" ? Theme.brand : Theme.error;
                                        font-size: 10px;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "保存后在工作台启用";
                                        color: Theme.muted-text;
                                        font-size: 10px;
                                    }
                                }
                            }
                        }
                    }
                    config-banner := FeedbackBanner {
                        tone: 3;
                        title: "配置无法生成";
                        message: root.edit-config-error;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 40px;
            spacing: 8px;
            cross-axis-alignment: center;
            if root.edit-id != "": QuietButton {
                text: root.delete-confirm ? "确认删除连接" : "删除连接";
                width: 112px;
                ghost: true;
                enabled: !root.busy && !root.config-managed;
                clicked => {
                    if root.delete-confirm { root.delete-provider(root.edit-id); root.edit-key = ""; }
                    else { root.delete-confirm = true; }
                }
            }
            Text {
                text: "保存连接，在工作台启用。";
                color: Theme.muted-text;
                font-size: 11px;
                overflow: elide;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            QuietButton {
                text: "取消";
                width: 80px;
                enabled: !root.busy;
                clicked => { root.edit-key = ""; root.editor-open = false; }
            }

            QuietButton {
                text: root.busy ? "正在保存…" : root.edit-id == "" ? "保存并配置模型" : "保存连接";
                width: root.edit-id == "" ? 152px : 128px;
                primary: true;
                icon: @image-url("../../assets/ui/check.svg");
                icon-color: Theme.on-brand;
                enabled: !root.busy && !root.config-managed && root.edit-config-error == "";
                clicked => {
                    root.save-provider(root.edit-id, root.edit-name, root.edit-url, root.edit-model, root.edit-key);
                    root.edit-key = "";
                }
            }
        }
    }
}
