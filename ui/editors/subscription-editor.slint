import { QuietScrollView as ScrollView } from "../scroll-view.slint";
import { Theme } from "../tokens.slint";
import {
    AnimatedSection,
    StatusPill,
    QuietSegmented,
    QuietButton,
    SurfaceCard,
    QuietLineEdit as LineEdit,
    QuietComboBox as ComboBox,
} from "../components.slint";
import { ConnectionOption, ConnectionField } from "connection-controls.slint";
import {
    SubscriptionStage,
    SubscriptionIdentity,
    SubscriptionBindingHint,
} from "subscription-surfaces.slint";
import { CodeEditor } from "../code-editor.slint";
import { FeedbackBanner } from "../feedback-banner.slint";

export component SubscriptionEditor inherits SurfaceCard {
    in property <bool> busy;
    in property <bool> compact;
    in property <string> subscription-id;
    in-out property <string> subscription-name;
    in property <string> subscription-binding-label;
    in property <[string]> subscription-account-ids;
    in property <[string]> subscription-account-options;
    in-out property <int> subscription-account-choice;
    in-out property <string> subscription-auth-json;
    in property <string> subscription-auth-error;
    in-out property <bool> delete-confirm;
    in-out property <bool> edit-use-common-config;
    in-out property <bool> edit-context-1m;
    in-out property <string> edit-compact-limit;
    in-out property <string> edit-config-preview;
    in property <string> edit-config-error;
    in property <string> edit-icon-name;
    in property <image> edit-icon;
    in property <bool> edit-icon-monochrome;
    in property <bool> config-managed;
    callback save-subscription(string, string, string);
    callback cancel-subscription-editor();
    callback format-subscription-auth();
    callback subscription-auth-edited();
    callback subscription-config-edited();
    callback update-subscription-context();
    callback update-subscription-common();
    callback open-common-config();
    callback delete-provider(string);
    callback open-provider-icon-picker();
    callback configure-models();
    callback navigate(int);

    private property <bool> auth-visible: false;
    private property <bool> options-expanded: false;
    private property <bool> preview-expanded: false;
    private property <float> side-reveal: root.preview-expanded ? 0 : 1;
    animate side-reveal {
        duration: Theme.drawer-motion;
        easing: cubic-bezier(0.22, 1, 0.36, 1);
    }
    private property <bool> pane-landed: false;
    private property <float> pane-arrival: Theme.drawer-motion == 0ms ? 1 : root.pane-landed ? 1 : 0;
    animate pane-arrival {
        duration: Theme.drawer-motion;
        easing: cubic-bezier(0.22, 1, 0.36, 1);
    }
    changed auth-visible => { root.pane-landed = false; }
    Timer {
        interval: 32ms;
        running: !root.pane-landed;
        triggered => { root.pane-landed = true; }
    }

    vertical-stretch: 1;
    min-height: 300px;
    VerticalLayout {
        spacing: 16px;
        HorizontalLayout {
            spacing: 20px * root.side-reveal;
            Rectangle {
                width: 292px * root.side-reveal;
                horizontal-stretch: 0;
                clip: true;
                visible: root.side-reveal > 0;
                opacity: root.side-reveal;
                ScrollView {
                    width: 292px;
                    enabled: !root.preview-expanded;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding-right: 4px;
                        spacing: root.compact ? 10px : 18px;
                        alignment: start;
                        SubscriptionStage {
                            wait: 32ms;
                            content-height: root.compact ? 72px : 84px;
                            SubscriptionIdentity {
                                name: root.subscription-name;
                                platform: root.edit-icon-name;
                                icon: root.edit-icon;
                                monochrome: root.edit-icon-monochrome;
                                enabled: !root.busy && !root.config-managed;
                                pick => { root.open-provider-icon-picker(); }
                            }
                        }

                        SubscriptionStage {
                            wait: 88ms;
                            content-height: fields.preferred-height;
                            fields := VerticalLayout {
                                spacing: root.compact ? 10px : 16px;
                                alignment: start;
                                HorizontalLayout {
                                    height: 20px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: "连接信息";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.primary-text;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    StatusPill {
                                        width: 50px;
                                        height: 20px;
                                        label: "订阅";
                                        ink: Theme.brand;
                                        fill: Theme.brand-surface;
                                    }
                                }

                                ConnectionField {
                                    label: "连接名称";
                                    LineEdit {
                                        text <=> root.subscription-name;
                                        placeholder-text: "例如 ChatGPT · 工作账号";
                                        accessible-label: "ChatGPT 订阅连接名称";
                                        enabled: !root.busy && !root.config-managed;
                                    }
                                }

                                ConnectionField {
                                    label: "绑定账号";
                                    ComboBox {
                                        model: root.subscription-account-options;
                                        current-index <=> root.subscription-account-choice;
                                        accessible-label: "为订阅连接选择已保存账号";
                                        enabled: !root.busy && !root.config-managed;
                                    }
                                }

                                SubscriptionBindingHint {
                                    choice: root.subscription-account-choice;
                                    detail: root.subscription-binding-label;
                                }

                                QuietButton {
                                    text: "管理 ChatGPT 账号";
                                    icon: @image-url("../../assets/ui/connections.svg");
                                    icon-color: Theme.brand;
                                    enabled: !root.busy;
                                    clicked => { root.navigate(5); }
                                }
                            }
                        }

                        SubscriptionStage {
                            wait: 144ms;
                            content-height: next-step.preferred-height;
                            Rectangle {
                                border-radius: 12px;
                                background: Theme.brand-surface.with-alpha(0.5);
                                border-width: 1px;
                                border-color: Theme.brand.with-alpha(0.12);
                                animate background, border-color { duration: Theme.page-motion; }
                                next-step := VerticalLayout {
                                    padding: 14px;
                                    spacing: 9px;
                                    HorizontalLayout {
                                        height: 18px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        Image {
                                            width: 16px;
                                            height: 16px;
                                            source: @image-url("../../assets/ui/blocks.svg");
                                            colorize: Theme.brand;
                                        }

                                        Text {
                                            text: "下一步 · 准备模型";
                                            color: Theme.primary-text;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                    }

                                    Text {
                                        text: root.subscription-id == "" ? "保存连接后，继续添加常用模型。" : "在模型目录中添加和编辑常用模型，准备好后在工作台启用。";
                                        color: Theme.muted-text;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }

                                    if root.subscription-id != "": QuietButton {
                                        text: "查看模型目录";
                                        height: 30px;
                                        ghost: true;
                                        left-aligned: true;
                                        icon: @image-url("../../assets/ui/arrow.svg");
                                        icon-color: Theme.brand;
                                        enabled: !root.busy && !root.config-managed;
                                        clicked => { root.configure-models(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            SubscriptionStage {
                wait: 112ms;
                content-height: 0px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        height: 44px;
                        spacing: 10px;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 11px;
                            background: Theme.brand-surface;
                            Image {
                                x: 10px;
                                y: 10px;
                                width: 18px;
                                height: 18px;
                                source: root.auth-visible ? @image-url("../../assets/ui/lock.svg") : @image-url("../../assets/ui/code.svg");
                                colorize: Theme.brand;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.auth-visible ? "登录 JSON" : "Codex 配置";
                                font-size: 16px;
                                font-weight: 600;
                                color: Theme.primary-text;
                            }

                            Text {
                                text: root.auth-visible ? "auth.json · 私密编辑" : "config.toml · 可编辑" + (root.edit-context-1m ? " · 1M" : "");
                                font-size: 11px;
                                color: Theme.muted-text;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        if !root.auth-visible && !root.preview-expanded: QuietButton {
                            width: 108px;
                            height: 32px;
                            text: root.options-expanded ? "收起选项" : "配置选项";
                            ghost: true;
                            icon: @image-url("../../assets/ui/chevron-down.svg");
                            icon-color: Theme.muted-text;
                            icon-angle: root.options-expanded ? 180deg : 0deg;
                            enabled: !root.busy;
                            clicked => { root.options-expanded = !root.options-expanded; }
                        }
                        if root.auth-visible: QuietButton {
                            width: 80px;
                            height: 32px;
                            text: "格式化";
                            ghost: true;
                            enabled: !root.busy && !root.config-managed;
                            clicked => { root.format-subscription-auth(); }
                        }
                        QuietButton {
                            width: 36px;
                            text: root.preview-expanded ? "退出宽屏编辑" : "放大编辑区域";
                            icon-only: true;
                            icon: @image-url("../../assets/ui/expand.svg");
                            icon-color: root.preview-expanded ? Theme.brand : Theme.muted-text;
                            selected: root.preview-expanded;
                            enabled: !root.busy;
                            clicked => { root.preview-expanded = !root.preview-expanded; }
                        }
                    }

                    QuietSegmented {
                        width: 260px;
                        height: 34px;
                        options: ["Codex 配置", "登录 JSON"];
                        current-index: root.auth-visible ? 1 : 0;
                        selection-background: Theme.brand-surface;
                        enabled: !root.busy;
                        selected(index) => { root.auth-visible = index == 1; }
                    }

                    code-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: as-needed;
                        code-content := VerticalLayout {
                            height: max(code-scroll.height, 140px + options.height + 12px);
                            spacing: 12px;
                            options := AnimatedSection {
                                expanded: root.options-expanded && !root.auth-visible && !root.preview-expanded;
                                content-height: 100px + threshold.height;
                                VerticalLayout {
                                    height: options.content-height;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        height: 58px;
                                        spacing: 8px;
                                        ConnectionOption {
                                            title: "通用配置";
                                            detail: "继承已保存的偏好";
                                            checked <=> root.edit-use-common-config;
                                            enabled: !root.busy && !root.config-managed;
                                            toggled => { root.update-subscription-common(); }
                                        }

                                        ConnectionOption {
                                            title: "1M 上下文";
                                            detail: "一百万 token 窗口";
                                            checked <=> root.edit-context-1m;
                                            enabled: !root.busy && !root.config-managed;
                                            toggled => { root.update-subscription-context(); }
                                        }
                                    }

                                    threshold := AnimatedSection {
                                        expanded: root.edit-context-1m;
                                        content-height: 40px;
                                        HorizontalLayout {
                                            height: 36px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: "自动压缩阈值";
                                                color: Theme.muted-text;
                                                font-size: 11px;
                                            }

                                            LineEdit {
                                                width: 128px;
                                                horizontal-stretch: 0;
                                                text <=> root.edit-compact-limit;
                                                edited(text) => { root.update-subscription-context(); }
                                                input-type: number;
                                                placeholder-text: "900000";
                                                accessible-label: "订阅自动压缩 token 阈值";
                                                enabled: root.edit-context-1m && !root.busy && !root.config-managed;
                                            }

                                            Text {
                                                text: "tokens";
                                                color: Theme.muted-text;
                                                font-size: 11px;
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }

                                    QuietButton {
                                        height: 26px;
                                        text: "编辑通用配置 ↗";
                                        ghost: true;
                                        left-aligned: true;
                                        enabled: !root.busy && !root.config-managed;
                                        clicked => { root.open-common-config(); }
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                min-height: 140px;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.inset;
                                clip: true;
                                animate border-color, background { duration: Theme.page-motion; }
                                VerticalLayout {
                                    Rectangle {
                                        height: 36px;
                                        background: Theme.raised.with-alpha(0.5);
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            cross-axis-alignment: center;
                                            Rectangle {
                                                width: 6px;
                                                height: 6px;
                                                border-radius: 3px;
                                                background: (root.auth-visible ? root.subscription-auth-error : root.edit-config-error) == "" ? Theme.brand : Theme.error;
                                                animate background { duration: Theme.fast; }
                                            }

                                            Text {
                                                text: root.auth-visible ? "auth.json" : "config.toml";
                                                color: Theme.primary-text;
                                                font-family: "Menlo";
                                                font-size: 11px;
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }

                                            Text {
                                                text: root.auth-visible ? "JSON  /  私密" : "TOML  /  可编辑";
                                                color: Theme.muted-text;
                                                font-size: 10px;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                        clip: true;
                                        Rectangle {
                                            y: 10px * (1 - root.pane-arrival);
                                            width: parent.width;
                                            height: max(0px, parent.height - self.y);
                                            opacity: 0.35 + 0.65 * root.pane-arrival;
                                            // Unmount the private editor immediately on navigation.
                                            if root.auth-visible: CodeEditor {
                                                text <=> root.subscription-auth-json;
                                                language: "json";
                                                edited(text) => { root.subscription-auth-edited(); }
                                                enabled: !root.busy && !root.config-managed;
                                                background: Theme.inset;
                                                border-width: 0px;
                                                border-radius: 0px;
                                                show-line-numbers: true;
                                                content-padding: 14px;
                                                accessible-label: "ChatGPT auth.json 编辑内容";
                                            }
                                            if !root.auth-visible: CodeEditor {
                                                text <=> root.edit-config-preview;
                                                edited(text) => { root.subscription-config-edited(); }
                                                enabled: !root.busy && !root.config-managed;
                                                background: Theme.inset;
                                                border-width: 0px;
                                                border-radius: 0px;
                                                show-line-numbers: true;
                                                content-padding: 14px;
                                                accessible-label: "ChatGPT config.toml 编辑内容";
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 30px;
                                        background: Theme.raised.with-alpha(0.35);
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: root.auth-visible ? "● 私有账号文件" : root.edit-config-error == "" ? "● 配置已准备" : "● 配置需要修正";
                                                color: (root.auth-visible ? root.subscription-auth-error : root.edit-config-error) == "" ? Theme.brand : Theme.error;
                                                font-size: 10px;
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }

                                            Text {
                                                text: root.auth-visible ? "保存到绑定账号" : "保存后在工作台启用";
                                                color: Theme.muted-text;
                                                font-size: 10px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    config-feedback := FeedbackBanner {
                        tone: 3;
                        title: root.auth-visible ? "登录 JSON 需要修正" : "配置需要修正";
                        message: root.auth-visible ? root.subscription-auth-error : root.edit-config-error;
                    }

                    editor-help := Text {
                        text: root.auth-visible ? "修改后保存到私有账号文件。切换 Codex 登录，请在账号管理中选择“写入 Codex 登录”。" : "可编辑模型和非敏感设置；官方地址与路由认证由 SwitchX 管理。";
                        font-size: 11px;
                        color: Theme.muted-text;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 40px;
            spacing: 8px;
            cross-axis-alignment: center;
            if root.subscription-id != "": QuietButton {
                text: root.delete-confirm ? "确认删除连接" : "删除连接";
                width: 112px;
                ghost: true;
                enabled: !root.busy && !root.config-managed;
                clicked => {
                    if root.delete-confirm { root.delete-provider(root.subscription-id); }
                    else { root.delete-confirm = true; }
                }
            }
            Text {
                text: "保存连接，在工作台启用。";
                color: Theme.muted-text;
                font-size: 11px;
                overflow: elide;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            QuietButton {
                text: "取消";
                width: 80px;
                enabled: !root.busy;
                clicked => { root.cancel-subscription-editor(); }
            }

            QuietButton {
                text: root.busy ? "正在保存…" : root.subscription-id == "" ? "保存并配置模型" : "保存连接";
                width: root.subscription-id == "" ? 152px : 128px;
                primary: true;
                loading: root.busy;
                icon: root.busy ? @image-url("../../assets/ui/loader.svg") : @image-url("../../assets/ui/check.svg");
                icon-color: Theme.on-brand;
                enabled: !root.busy && !root.config-managed && root.subscription-name != "" && root.edit-config-error == "" && root.subscription-auth-error == "" && root.subscription-account-choice >= 0 && root.subscription-account-choice < root.subscription-account-ids.length;
                clicked => { root.save-subscription(root.subscription-id, root.subscription-name, root.subscription-account-ids[root.subscription-account-choice]); }
            }
        }
    }
}
