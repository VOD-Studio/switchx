import { QuietLineEdit, DropdownViewport } from "../components.slint";
import { QuietScrollView } from "../scroll-view.slint";
import { Theme } from "../tokens.slint";

export global ModelChoices {
    pure callback filter([string], string) -> [string];
}

// One editable value; the popup continues editing it while filtering suggestions.
export component ModelPicker inherits QuietLineEdit {
    in property <[string]> model;
    out property <bool> expanded: root.open;
    private property <string> query;
    private property <[string]> choices: ModelChoices.filter(root.model, root.query);
    private property <int> highlight: -1;
    private property <bool> open: false;
    private property <bool> entered: false;
    private property <bool> mounted: popup.is-open;
    private property <float> reveal: root.open && root.entered ? 1 : 0;
    private property <duration> motion: root.open ? Theme.fast : Theme.fast * 0.8;
    animate reveal {
        duration: root.motion;
        easing: ease-out;
    }

    public function open-popup() {
        if root.enabled && root.model.length > 0 {
            if !root.mounted {
                root.query = "";
                root.highlight = -1;
                root.entered = Theme.fast == 0ms;
                popup.show();
            }
            root.open = true;
        }
    }
    public function close-popup() {
        root.open = false;
        if Theme.fast == 0ms { popup.close(); }
    }
    function select(index: int) {
        if root.open && root.enabled && index >= 0 && index < root.choices.length {
            root.text = root.choices[index];
            root.edited(root.text);
            root.close-popup();
            root.select-all();
        }
    }
    function handle-key(event: KeyEvent) -> EventResult {
        if event.text == Key.Escape && root.open { root.close-popup(); return accept; }
        if event.text == Key.Tab || event.text == Key.Backtab {
            root.close-popup();
            popup.close();
            return reject;
        }
        if event.text == Key.DownArrow || event.text == Key.UpArrow {
            if !root.open {
                if root.model.length == 0 { return reject; }
                root.open-popup();
            } else if event.text == Key.DownArrow {
                root.highlight = min(root.choices.length - 1, root.highlight + 1);
            } else { root.highlight = min(root.choices.length - 1, max(0, root.highlight - 1)); }
            return accept;
        }
        if event.text == Key.Return && root.open {
            if root.highlight >= 0 && root.highlight < root.choices.length { root.select(root.highlight); }
            else { root.close-popup(); }
            return accept;
        }
        return reject;
    }
    key-pressed(event) => { return root.handle-key(event); }
    changed query => { root.highlight = -1; }
    changed model => { if root.model.length == 0 { root.close-popup(); } }
    changed enabled => { if !root.enabled { root.close-popup(); } }
    changed mounted => { if !root.mounted { root.open = false; root.entered = false; } }
    Timer {
        interval: 16ms;
        running: root.open && !root.entered;
        triggered => { root.entered = true; }
    }

    Timer {
        interval: max(1ms, root.motion);
        running: root.mounted && !root.open;
        triggered => { popup.close(); }
    }

    right-padding: root.model.length > 0 ? 36px : 12px;
    accessible-role: combobox;
    accessible-expandable: root.model.length > 0;
    accessible-expanded: root.open;
    accessible-action-expand => { root.open-popup(); }

    if root.model.length > 0: Image {
        x: root.width - 26px;
        y: (root.height - self.height) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("../../assets/ui/chevron-down.svg");
        colorize: root.open ? Theme.brand : Theme.muted-text;
        transform-rotation: root.open ? 180deg : 0deg;
        animate transform-rotation { duration: Theme.fast; }
        accessible-role: none;
    }
    if root.model.length > 0: TouchArea {
        x: root.width - 36px;
        width: 36px;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.focus(); root.open-popup(); }
    }

    popup := PopupWindow {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: DropdownViewport.size.x;
        height: DropdownViewport.size.y;
        property <Point> viewport: DropdownViewport.size;
        changed viewport => { self.width = self.viewport.x; self.height = self.viewport.y; }
        close-policy: no-auto-close;
        forward-focus: search;
        FocusScope {
            property <bool> active: root.open;
            changed active => { if self.active { search.focus(); search.select-all(); } }
            key-pressed(event) => {
                // Tab still bubbles after the input releases the popup's focus grab.
                return root.open || event.text == Key.Tab || event.text == Key.Backtab ? root.handle-key(event) : accept;
            }
            TouchArea {
                clicked => { root.close-popup(); }
            }

            // Keep the input at exactly the same position while the popup owns focus.
            search := QuietLineEdit {
                x: root.absolute-position.x;
                y: root.absolute-position.y;
                width: root.width;
                height: root.height;
                text <=> root.text;
                placeholder-text: "输入或搜索模型 ID";
                accessible-label: root.accessible-label;
                right-padding: 36px;
                enabled: root.enabled;
                edited(value) => { root.query = value; root.edited(value); }
                key-pressed(event) => { return root.open ? root.handle-key(event) : accept; }
                Image {
                    x: parent.width - 26px;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: @image-url("../../assets/ui/chevron-down.svg");
                    colorize: Theme.brand;
                    transform-rotation: root.open ? 180deg : 0deg;
                    animate transform-rotation { duration: Theme.fast; }
                    accessible-role: none;
                }

                TouchArea {
                    x: parent.width - 36px;
                    width: 36px;
                    mouse-cursor: pointer;
                    clicked => { root.close-popup(); }
                }
            }

            panel := Rectangle {
                width: min(max(root.width, 200px), parent.width);
                height: min(max(1, min(6, root.choices.length)) * 40px + 10px, parent.height);
                x: max(0px, min(root.absolute-position.x, parent.width - self.width));
                property <bool> above: root.absolute-position.y + root.height + 6px + min(min(6, root.model.length) * 40px + 10px, parent.height) > parent.height;
                y: (self.above ? max(0px, root.absolute-position.y - self.height - 6px) : root.absolute-position.y + root.height + 6px) + (self.above ? 5px : -5px) * (1 - root.reveal);
                opacity: root.reveal;
                background: Theme.panel;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 5px;
                drop-shadow-color: Theme.dark ? #00000050 : #18221a18;
                TouchArea { }

                if root.choices.length == 0: Text {
                    text: "无匹配模型，可保留输入的 ID";
                    color: Theme.muted-text;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.choices.length > 0: QuietScrollView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    enabled: root.open && root.enabled;
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: root.choices.length * 40px + 8px > self.height ? as-needed : always-off;
                    property <int> selection: root.highlight;
                    changed selection => {
                        if self.selection < 0 { self.content-y = 0px; }
                        else if self.content-y + self.selection * 40px < 0px { self.content-y = -self.selection * 40px; }
                        else if self.content-y + (self.selection + 1) * 40px + 8px > self.visible-height {
                            self.content-y = self.visible-height - (self.selection + 1) * 40px - 8px;
                        }
                    }
                    property <string> filter: root.query;
                    changed filter => { self.content-y = 0px; }
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        alignment: start;
                        for value[index] in root.choices: Rectangle {
                            height: 36px;
                            border-radius: 6px;
                            background: index == root.highlight || item-touch.has-hover ? Theme.raised : value == root.text ? Theme.brand-surface : transparent;
                            animate background { duration: Theme.fast; }
                            accessible-role: list-item;
                            accessible-label: value;
                            accessible-value: value == root.text ? "已选" : "";
                            accessible-enabled: root.open && root.enabled;
                            accessible-action-default => { root.select(index); }
                            Text {
                                x: 10px;
                                width: max(0px, parent.width - 38px);
                                text: value;
                                color: value == root.text ? Theme.brand : Theme.primary-text;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }

                            if value == root.text: Image {
                                x: parent.width - 24px;
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                source: @image-url("../../assets/ui/check.svg");
                                colorize: Theme.brand;
                                accessible-role: none;
                            }
                            item-touch := TouchArea {
                                enabled: root.open && root.enabled;
                                mouse-cursor: pointer;
                                clicked => { root.select(index); }
                            }
                        }
                    }
                }
            }
        }
    }
}
