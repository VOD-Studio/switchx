import { XaiEditor } from "editors/xai-editor.slint";
import { ConnectionModels } from "editors/connection-models.slint";
import { Palette } from "std-widgets.slint";
import { QuietScrollView as ScrollView } from "scroll-view.slint";
import { Theme } from "tokens.slint";
import {
    QuietButton,
    QuietSegmented,
    QuietCheckBox as CheckBox,
    QuietComboBox as ComboBox,
    QuietLineEdit as LineEdit,
    SurfaceCard,
    StatusPill,
    Drawer,
    DropdownViewport,
} from "components.slint";
import {
    ProviderRow,
    ProviderPresetRow,
    ProviderIconRow,
    AccountRow,
    ModelRow,
    BatchModelRow,
    BatchSummary,
    RequestRow,
    RequestStats,
    RequestBar,
    ConnectionModelRow,
} from "view-models.slint";
import { AccountsPage } from "pages/accounts.slint";
import { ProviderEditor } from "editors/provider-editor.slint";
import { ConnectionPicker } from "editors/connection-picker.slint";
import { ModelEditor } from "editors/model-editor.slint";
export { Theme } from "tokens.slint";
export {
    ReasoningChoices,
    ReasoningChoice,
} from "editors/reasoning-picker.slint";
import { ProviderIconPicker } from "editors/provider-icon-picker.slint";
import { ProvidersPage } from "pages/providers.slint";
import { SubscriptionEditor } from "editors/subscription-editor.slint";
import { CommonConfigEditor } from "editors/common-config-editor.slint";
import { RoutingPage } from "pages/routing.slint";
import { ActivityPage } from "pages/activity.slint";
import { ConfigPage } from "pages/config.slint";
import { ConnectionStatusDialog } from "connection-status.slint";
import { WorkspaceMenu } from "workspace-menu.slint";
import { OperationNotice } from "operation-notice.slint";

export {
    XaiQuotaRow,
    CodexQuotaRow,
    ProviderRow,
    ProviderPresetRow,
    ProviderIconRow,
    AccountRow,
    ModelRow,
    BatchModelRow,
    BatchSummary,
    RequestRow,
    RequestStats,
    RequestBar,
    ConnectionModelRow,
} from "view-models.slint";
export { SyntaxHighlighting, CodeSpan } from "code-editor.slint";

export component AppWindow inherits Window {
    title: "switchx";
    icon: @image-url("../assets/app-icon.png");
    preferred-width: 1200px;
    preferred-height: 820px;
    min-width: 1000px;
    min-height: 680px;
    background: Theme.background;
    forward-focus: app-keyboard;
    in property <bool> native-titlebar-overlay: false;
    property <Point> dropdown-viewport: { x: root.width, y: root.height };
    init => { DropdownViewport.size = root.dropdown-viewport; }
    changed dropdown-viewport => { DropdownViewport.size = root.dropdown-viewport; }

    public function set-appearance(dark: bool) {
        Theme.dark = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    in-out property <int> active-page: 0;
    in-out property <bool> drawer-open: false;
    in-out property <bool> workspace-open: false;
    in-out property <bool> notification-open <=> operation-notice.open;
    in-out property <int> feedback-sequence: 0;
    in-out property <bool> status-directories-expanded: false;
    changed drawer-open => { if (root.drawer-open) { root.status-directories-expanded = false; } }
    in-out property <bool> loading: true;
    in-out property <bool> busy: false;
    in-out property <bool> recovery-only: false;
    in-out property <string> error-code: "";
    in-out property <string> error-message: "";
    in-out property <string> error-action: "";
    in-out property <string> status-text: "正在读取本地资料…";
    in-out property <bool> local-data-ready: false;
    in-out property <bool> credentials-checked: false;
    in-out property <string> data-path: "";
    in-out property <[ProviderRow]> providers: [];
    in-out property <[ProviderRow]> filtered-providers: [];
    in-out property <string> provider-query: "";
    in-out property <bool> connection-picker-open: false;
    in-out property <bool> connection-models-open: false;
    in-out property <string> connection-models-id;
    in-out property <string> connection-models-name;
    in-out property <bool> connection-models-subscription;
    in-out property <[ConnectionModelRow]> connection-models;
    in-out property <bool> connection-models-dirty: false;
    in-out property <bool> connection-models-saving: false;
    in-out property <string> connection-models-message;
    in-out property <int> connection-models-tone: 0;
    changed connection-models-open => {
        if root.connection-models-open { connection-drawer.focus(); }
        else { root.reset-model-discovery(); }
    }
    callback begin-connection-models(string);
    callback edit-connection(string);
    callback add-connection-model();
    callback append-discovered-models();
    callback save-connection-models();
    callback connection-model-edited();
    changed connection-picker-open => {
        if (!root.connection-picker-open) { root.departing-connection-form = 0; }
        if (root.connection-picker-open || root.editor-open || root.subscription-editor-open || root.xai-editor-open) { connection-drawer.focus(); }
    }
    in-out property <string> connection-preset-id: "";
    in-out property <bool> editor-open: false;
    in-out property <bool> xai-editor-open: false;
    in-out property <string> xai-provider-id: "";
    in-out property <string> xai-provider-name: "";
    in-out property <[string]> xai-account-ids: [];
    in-out property <[string]> xai-account-options: [];
    in-out property <int> xai-account-choice: 0;
    in-out property <[AccountRow]> xai-accounts: [];
    in-out property <string> xai-status: "Grok 账号列表尚未读取";
    in-out property <string> xai-account-error: "";
    in-out property <string> account-error: "";
    in-out property <bool> native-login-expanded: false;
    in-out property <string> expanded-chatgpt-account-id: "";
    in-out property <string> expanded-grok-account-id: "";
    in-out property <string> account-removing-id: "";
    property <bool> account-removing-grok: false;
    property <bool> account-removal-submitted: false;
    changed account-removing-id => { if (root.account-removing-id == "") { root.account-removal-submitted = false; } }
    Timer {
        interval: max(1ms, Theme.page-motion);
        running: root.account-removing-id != "" && !root.account-removal-submitted;
        triggered => {
            root.account-removal-submitted = true;
            if (root.account-removing-grok) { root.xai-account-action(4, root.account-removing-id); }
            else { root.account-action(4, root.account-removing-id); }
        }
    }

    in-out property <bool> account-login-confirm-open: false;
    in-out property <string> account-login-confirm-id: "";
    in-out property <string> account-login-confirm-label: "";
    property <bool> account-login-confirm-native: false;
    function dismiss-account-login() {
        root.account-login-confirm-open = false;
        root.account-login-confirm-id = "";
        root.account-login-confirm-label = "";
    }
    in-out property <string> xai-user-code: "";
    in-out property <string> xai-login-url: "";
    in-out property <bool> xai-pending: false;
    in-out property <string> xai-login-id: "";
    property <bool> delete-account-grok: false;
    in-out property <bool> subscription-editor-open: false;
    in-out property <string> subscription-id: "";
    in-out property <string> subscription-name: "";
    in-out property <string> subscription-binding-label: "";
    in-out property <[string]> subscription-account-ids: [];
    in-out property <[string]> subscription-account-options: [];
    in-out property <int> subscription-account-choice: 0;
    in-out property <string> subscription-auth-json: "";
    in-out property <string> subscription-auth-error: "";
    in-out property <bool> config-editor-updating: false;
    in-out property <int> subscription-editor-generation: 0;
    in-out property <bool> subscription-editor-pending: false;
    in-out property <bool> delete-confirm: false;
    in-out property <string> edit-id: "";
    in-out property <string> edit-name: "";
    in-out property <string> edit-url: "";
    in-out property <string> edit-model: "";
    in-out property <string> edit-key: "";
    in-out property <bool> edit-remote-compaction: false;
    in-out property <bool> edit-use-common-config: true;
    in-out property <bool> edit-context-1m: false;
    in-out property <string> edit-compact-limit: "900000";
    in-out property <string> edit-config-preview: "";
    in-out property <string> edit-config-error: "";
    in-out property <bool> common-config-editor-open: false;
    in-out property <string> common-config-draft: "";
    in-out property <string> common-config-saved: "";
    in-out property <string> common-config-error: "";
    in-out property <string> common-config-message: "";
    in-out property <string> common-config-current-source: "";
    in property <[ProviderPresetRow]> provider-presets;
    in-out property <string> edit-preset-id: "";
    in-out property <string> edit-preset-url: "";
    in-out property <image> edit-preset-icon;
    in-out property <bool> edit-preset-monochrome: false;
    in property <[ProviderIconRow]> provider-icons;
    in-out property <[ProviderIconRow]> filtered-provider-icons;
    in-out property <string> provider-icon-query: "";
    in-out property <bool> icon-picker-open: false;
    in-out property <string> edit-icon-id: "";
    in-out property <string> edit-icon-name: "";
    in-out property <image> edit-icon;
    in-out property <bool> edit-icon-monochrome: false;
    in-out property <[string]> fetched-models: [];
    in-out property <bool> fetching-models: false;
    in-out property <string> discovery-message: "";
    in-out property <int> discovery-generation: 0;
    in-out property <int> discovery-scope: 0;
    // 0 info, 1 success, 2 warning, 3 error.
    in-out property <int> discovery-tone: 0;
    in-out property <string> config-home: "";
    in-out property <string> config-status: "尚未读取 Codex 配置";
    in-out property <string> config-mode: "尚未读取 Codex 配置";
    in-out property <string> config-provider: "";
    in-out property <string> config-model: "";
    in-out property <bool> config-exists: false;
    in-out property <bool> direct-active: false;
    out property <string> connection-label: root.route-running ? "路由已启用" : root.direct-active ? "直连已启用" : root.config-managed ? "配置待恢复" : "待启用";
    in-out property <string> auth-status: "官方登录状态尚未检查";
    in-out property <[AccountRow]> accounts: [];
    in-out property <string> account-status: "账号列表尚未读取";
    in-out property <string> login-user-code: "";
    in-out property <string> login-url: "";
    in-out property <string> selected-account-id: "";
    in-out property <string> delete-account-id: "";
    in-out property <bool> delete-account-confirm: false;
    property <string> delete-account-label: "";
    property <string> delete-account-references: "";
    in-out property <bool> chatgpt-login-pending: false;
    in-out property <string> chatgpt-login-id: "";
    in-out property <string> route-auth-error: "";
    in-out property <string> selected-provider-id: "";
    in-out property <string> direct-preview: "";
    in-out property <bool> direct-preview-ready: false;
    in-out property <string> action-message: "";
    in-out property <[ModelRow]> models: [];
    // `requests` is the filtered, keyed view model; `request-log` holds the newest
    // records in chronological order for filtering and arrival stamps.
    in-out property <[RequestRow]> requests: [];
    in-out property <[RequestRow]> request-log: [];
    in-out property <RequestStats> request-stats: { success-rate: -1, p50-ms: -1, p95-ms: -1, first-event-ms: -1 };
    in-out property <[RequestBar]> request-bars: [];
    in-out property <int> request-sync: 0;
    in-out property <int> request-filter: 0;
    in-out property <bool> request-following: true;
    in-out property <int> request-unseen: 0;
    in-out property <bool> request-loading: false;
    in-out property <bool> request-write-failed: false;
    in-out property <string> request-error: "";
    in-out property <bool> window-visible: true;
    in-out property <int> selected-model-count: 0;
    in-out property <int> selected-connection-count: 0;
    in-out property <string> default-model-label;
    callback update-default-model-label();
    in-out property <int> selectable-model-count: 0;
    in-out property <bool> config-managed: false;
    in-out property <bool> route-managed: false;
    in-out property <bool> route-running: false;
    in-out property <string> route-status: "路由未启用";
    in-out property <string> route-port: "18731";
    in-out property <string> default-model: "";
    in-out property <string> route-preview: "";
    in-out property <bool> route-preview-ready: false;
    in-out property <string> route-preview-model: "";
    in-out property <bool> model-editor-open: false;
    in-out property <string> model-provider-id: "";
    in-out property <string> model-provider-name: "";
    in-out property <string> model-upstream-id: "";
    in-out property <string> model-public-id: "";
    in-out property <string> model-display-name: "";
    in-out property <bool> model-display-name-custom: false;
    in-out property <string> model-source-path: "";
    in-out property <string> model-original-id: "";
    in-out property <string> model-context-window: "";
    in-out property <string> model-reasoning-levels: "";
    in-out property <string> model-default-reasoning: "未设置";
    in-out property <[string]> model-reasoning-options: ["未设置"];
    in-out property <bool> model-delete-confirm: false;
    // Adding opens the batch picker; editing an existing mapping stays single.
    in-out property <bool> model-batch-mode: true;
    in-out property <[BatchModelRow]> batch-models: [];
    in-out property <BatchSummary> batch-summary;
    in-out property <bool> batch-saving: false;
    in-out property <string> batch-query: "";
    in-out property <string> batch-context: "";
    in-out property <string> batch-levels: "";
    in-out property <string> batch-default: "未设置";
    in-out property <string> batch-levels-label: "";
    in-out property <[string]> batch-reasoning-options: ["未设置"];
    // Fetch once the drawer has started sliding in, after open-time resets settle.
    property <bool> batch-autofetch: false;
    in-out property <[string]> model-provider-ids: [];
    in-out property <[string]> model-provider-options: [];
    in-out property <int> model-provider-choice: 0;
    in-out property <length> model-scroll-y: 0px;
    in-out property <bool> fallback-editor-open: false;
    in-out property <string> fallback-primary-id;
    in-out property <string> fallback-primary-label;
    in-out property <[string]> fallback-ids;
    in-out property <[string]> fallback-options;
    in-out property <int> fallback-choice: 0;
    in-out property <bool> fallback-consent: false;
    changed config-home => {
        root.route-preview-ready = false;
        root.direct-preview-ready = false;
        root.auth-status = "此目录的官方登录状态尚未检查";
        if (root.subscription-editor-open || root.subscription-editor-pending) { root.cancel-subscription-editor(); }
    }
    changed active-page => {
        root.workspace-open = false;
        root.page-entered = Theme.page-motion == 0ms;
        if (root.active-page == 1 && root.connections-tab == 1) { root.xai-account-action(5, ""); root.account-action(6, ""); }
        if (root.active-page != 1) {
            root.dismiss-account-login();
            root.native-login-expanded = false;
            root.departing-connection-form = 0;
            root.connection-picker-open = false;
            root.connection-preset-id = "";
            if (root.icon-picker-open) { root.close-provider-icon-picker(); }
            if (root.subscription-editor-open || root.subscription-editor-pending) { root.cancel-subscription-editor(); }
            root.xai-editor-open = false;
            root.editor-open = false;
            root.edit-key = "";
        }
        if (root.active-page != 1) { root.connection-models-open = false; }
        if (root.active-page != 0) { root.model-editor-open = false; root.fallback-editor-open = false; }
    }
    changed subscription-editor-open => {
        if (!root.subscription-editor-open) {
            root.subscription-auth-json = "";
            root.subscription-auth-error = "";
        }
    }
    changed subscription-account-choice => {
        if (root.subscription-editor-open && !root.config-editor-updating) { root.load-subscription-auth(); }
    }
    function close-connection-editor() {
        root.departing-connection-form = 0;
        root.connection-models-open = false;
        root.connection-picker-open = false;
        root.connection-preset-id = "";
        if (root.subscription-editor-open || root.subscription-editor-pending) { root.cancel-subscription-editor(); }
        root.editor-open = false;
        root.xai-editor-open = false;
        root.edit-key = "";
        root.delete-confirm = false;
    }
    public function open-connection-picker() {
        if (!root.busy && !root.config-managed) {
            root.close-connection-editor();
            root.active-page = 1;
            root.connections-tab = 0;
            root.error-code = "";
            root.error-message = "";
            root.connection-picker-open = true;
        }
    }
    public function return-to-connection-picker() {
        if (!root.busy && !root.config-managed && root.new-connection-form) {
            // Preserve only the visual subtree; credential drafts are cleared now.
            root.departing-connection-form = Theme.drawer-motion == 0ms ? 0 : root.editor-open ? 1 : root.subscription-editor-open ? 2 : 3;
            root.connection-picker-open = true;
            root.connection-preset-id = "";
            if (root.subscription-editor-open || root.subscription-editor-pending) { root.cancel-subscription-editor(); }
            root.editor-open = false;
            root.xai-editor-open = false;
            root.edit-key = "";
            root.subscription-auth-json = "";
            root.delete-confirm = false;
            root.error-code = "";
            root.error-message = "";
            connection-drawer.focus();
        }
    }
    changed route-port => { root.route-preview-ready = false; }
    changed default-model => {
        root.update-default-model-label();
        if root.default-model != root.route-preview-model { root.route-preview-ready = false; }
    }
    public function reset-model-discovery() {
        root.discovery-generation += 1;
        root.fetched-models = [];
        root.fetching-models = false;
        root.discovery-message = "";
        root.discovery-tone = 0;
        root.batch-query = "";
        root.batch-models = [];
        root.batch-summary = {
            total: 0,
            matched: 0,
            added: 0,
            selected: 0,
            visible-selectable: 0,
            visible-selected: 0,
        };
    }
    function arm-batch-autofetch() {
        root.batch-autofetch = root.model-editor-open && root.model-batch-mode && root.model-original-id == "" && !root.config-managed;
    }
    changed edit-id => { root.reset-model-discovery(); }
    changed edit-url => {
        root.reset-model-discovery();
        if (root.edit-preset-id != "" && root.edit-url != root.edit-preset-url) {
            root.edit-preset-id = "";
        }
        root.update-provider-icon();
        if (root.editor-open) { root.update-provider-config-preview(); }
    }
    changed edit-name => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-model => {
        if (root.editor-open) { root.update-provider-config-preview(); }
        root.lock-batch-rows();
    }
    changed edit-remote-compaction => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-use-common-config => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-context-1m => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-compact-limit => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-key => { root.reset-model-discovery(); }
    changed editor-open => {
        if (!root.editor-open) { root.edit-key = ""; }
        root.reset-model-discovery();
        if (root.editor-open) { root.update-provider-config-preview(); }
    }
    changed model-provider-id => { root.reset-model-discovery(); }
    changed model-original-id => { root.reset-model-discovery(); }
    changed model-editor-open => {
        root.reset-model-discovery();
        root.arm-batch-autofetch();
    }
    changed model-batch-mode => {
        if (root.batch-models.length == 0 && !root.fetching-models) { root.arm-batch-autofetch(); }
    }
    changed batch-levels => { root.update-batch-reasoning-options(); }
    changed model-reasoning-levels => { root.update-reasoning-options(); }
    changed model-upstream-id => { root.update-model-display-name(); }
    callback refresh(bool);
    callback refresh-requests();
    callback filter-requests(int);
    callback filter-providers(string);
    callback save-provider(string, string, string, string, string);
    callback begin-provider-editor(string);
    callback begin-xai-editor(string);
    callback save-xai();
    callback xai-account-action(int, string);
    callback begin-subscription-editor(string);
    callback save-subscription(string, string, string);
    callback cancel-subscription-editor();
    callback load-subscription-auth();
    callback format-subscription-auth();
    callback subscription-auth-edited();
    callback subscription-config-edited();
    callback update-subscription-context();
    callback update-subscription-common();
    callback update-provider-config-preview();
    callback open-common-config();
    callback extract-common-config();
    callback save-common-config();
    callback cancel-common-config();
    callback delete-provider(string);
    callback check-provider(string);
    callback open-provider-preset-link(bool);
    callback open-provider-icon-picker();
    callback choose-provider-icon(string);
    callback close-provider-icon-picker();
    callback filter-provider-icons(string);
    callback update-provider-icon();
    callback fetch-models(int);
    callback inspect-direct(string, string);
    callback apply-direct();
    callback restore-config(string);
    callback inspect-config(string);
    callback import-current(string);
    callback check-login(string);
    callback subscription-action(int);
    callback account-action(int, string);
    callback save-model();
    callback delete-model();
    callback begin-model-editor(string, string);
    callback add-selected-model();
    callback update-model-display-name();
    callback update-reasoning-options();
    callback update-batch-reasoning-options();
    callback batch-toggle(int);
    callback batch-select-all(bool);
    callback batch-filter(string);
    callback batch-edit(int, string, string);
    callback save-batch-models();
    callback lock-batch-rows();
    callback select-model(string, bool);
    callback select-models(bool, bool);
    callback select-connection(string, bool);
    callback edit-fallback(string);
    callback save-fallback();
    callback inspect-route();
    callback apply-route();
    callback launch-codex();
    callback cancel-route-preview();
    callback poll-route-status();
    callback refresh-system-appearance();
    Timer {
        interval: 5s;
        running: true;
        triggered => { root.refresh-system-appearance(); }
    }

    Timer {
        interval: 2s;
        running: root.route-running;
        triggered => { root.poll-route-status(); }
    }

    in-out property <int> connections-tab: 0;
    // Keep the outgoing page alive until the reversible slide/fade reaches its end.
    property <float> connections-progress: root.connections-tab == 1 ? 1 : 0;
    animate connections-progress {
        duration: root.active-page == 1 ? Theme.drawer-motion : 0ms;
        easing: cubic-bezier(0.4, 0, 0.2, 1);
    }
    changed connections-tab => {
        if (root.active-page == 1 && root.connections-tab == 1) { root.xai-account-action(5, ""); root.account-action(6, ""); }
    }
    Timer {
        interval: 30s;
        running: root.active-page == 1 && root.connections-tab == 1 && (root.xai-accounts.length > 0 || root.accounts.length > 0);
        triggered => { root.xai-account-action(6, ""); root.account-action(7, ""); }
    }

    in-out property <bool> publish-drawer-open: false;
    in-out property <bool> direct-drawer-open: false;
    property <bool> page-entered: true;
    property <bool> new-connection-form: (root.editor-open && root.edit-id == "") || (root.subscription-editor-open && root.subscription-id == "") || (root.xai-editor-open && root.xai-provider-id == "");
    // 1 = API, 2 = ChatGPT, 3 = Grok. Outgoing controls remain inert.
    property <int> departing-connection-form: 0;
    property <int> connection-form-kind: root.editor-open ? 1 : root.subscription-editor-open ? 2 : root.xai-editor-open ? 3 : root.departing-connection-form;
    property <float> connection-stage-progress: root.connection-picker-open ? 0 : 1;
    animate connection-stage-progress {
        duration: Theme.drawer-motion;
        easing: cubic-bezier(0.22, 1, 0.36, 1);
    }
    Timer {
        interval: max(1ms, Theme.drawer-motion);
        running: root.connection-picker-open && root.departing-connection-form != 0;
        triggered => { root.departing-connection-form = 0; }
    }

    property <bool> modal-open: root.workspace-open || root.account-removing-id != "" || root.account-login-confirm-open || root.drawer-open || root.connection-picker-open || root.connection-models-open || root.xai-editor-open || root.editor-open || root.subscription-editor-open || root.common-config-editor-open || root.icon-picker-open || root.model-editor-open || root.fallback-editor-open || root.publish-drawer-open || root.direct-drawer-open || root.delete-account-confirm;
    property <string> page-title: root.active-page == 0 ? "模型，随手可用。" : root.active-page == 1 ? "连接" : root.active-page == 3 ? "每次请求，有迹可循。" : root.active-page == 4 ? "让工作流更顺手。" : "让它适合你。";
    property <string> page-subtitle: root.active-page == 0 ? "配好连接，整组模型随手可用。" : root.active-page == 1 ? "账号与上游，集中管理。" : root.active-page == 3 ? "查看模型、耗时与结果。" : root.active-page == 4 ? "MCP 与 Skills，独立于模型连接。" : "外观、工作空间和配置，各在其位。";
    animate background { duration: Theme.page-motion; }
    Timer {
        interval: 16ms;
        running: !root.page-entered;
        triggered => { root.page-entered = true; }
    }

    changed modal-open => { if (!root.modal-open) { app-keyboard.focus(); } }

    app-keyboard := FocusScope {
        FocusScope {
            enabled: !root.modal-open;
            HorizontalLayout {
                spacing: 0px;
                Rectangle {
                    // Measured from the first item so titlebar padding changes never animate.
                    property <length> nav-offset: (root.active-page == 0 ? nav-workbench.y : root.active-page == 1 ? nav-connections.y : root.active-page == 3 ? nav-activity.y : root.active-page == 4 ? nav-toolbox.y : nav-settings.y) - nav-workbench.y;
                    width: 180px;
                    background: Theme.sidebar;
                    animate background { duration: Theme.page-motion; }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.border;
                    }

                    WindowMoveArea {
                        height: 44px;
                        enabled: root.native-titlebar-overlay && !root.full-screen;
                    }

                    Rectangle {
                        property <length> offset: parent.nav-offset;
                        x: nav-workbench.x;
                        y: nav-workbench.y + self.offset;
                        width: nav-workbench.width;
                        height: nav-workbench.height;
                        border-radius: 8px;
                        background: Theme.panel;
                        animate offset {
                            duration: Theme.drawer-motion;
                            easing: cubic-bezier(0.22, 1, 0.36, 1);
                        }
                    }

                    VerticalLayout {
                        padding: 14px;
                        padding-top: root.native-titlebar-overlay && !root.full-screen ? 44px : 26px;
                        spacing: 6px;
                        HorizontalLayout {
                            height: 42px;
                            padding-left: 8px;
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Image {
                                width: 36px;
                                height: 36px;
                                source: @image-url("../assets/logo.png");
                                image-fit: contain;
                            }

                            Text {
                                text: "switchx";
                                color: Theme.primary-text;
                                font-size: 19px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 12px;
                        }

                        nav-workbench := QuietButton {
                            text: "工作台";
                            icon: @image-url("../assets/ui/workbench.svg");
                            icon-color: Theme.muted-text;
                            navigation: true;
                            selected: root.active-page == 0;
                            left-aligned: true;
                            height: 40px;
                            clicked => { root.active-page = 0; }
                        }

                        nav-connections := QuietButton {
                            text: "连接";
                            icon: @image-url("../assets/ui/connections.svg");
                            icon-color: Theme.muted-text;
                            navigation: true;
                            selected: root.active-page == 1;
                            left-aligned: true;
                            height: 40px;
                            clicked => { root.active-page = 1; }
                        }

                        nav-activity := QuietButton {
                            text: "活动";
                            icon: @image-url("../assets/ui/activity.svg");
                            icon-color: Theme.muted-text;
                            navigation: true;
                            selected: root.active-page == 3;
                            left-aligned: true;
                            height: 40px;
                            clicked => { root.active-page = 3; }
                        }

                        Rectangle {
                            height: 20px;
                        }

                        nav-toolbox := QuietButton {
                            text: "工具箱";
                            icon: @image-url("../assets/ui/blocks.svg");
                            icon-color: Theme.muted-text;
                            navigation: true;
                            selected: root.active-page == 4;
                            left-aligned: true;
                            height: 40px;
                            clicked => { root.active-page = 4; }
                        }

                        nav-settings := QuietButton {
                            text: "设置";
                            icon: @image-url("../assets/ui/settings.svg");
                            icon-color: Theme.muted-text;
                            navigation: true;
                            selected: root.active-page == 5;
                            left-aligned: true;
                            height: 40px;
                            clicked => { root.active-page = 5; }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        QuietButton {
                            text: "●  " + root.connection-label;
                            ghost: true;
                            left-aligned: true;
                            clicked => { root.drawer-open = true; }
                        }

                        Text {
                            text: "LOCAL FIRST";
                            color: Theme.muted-text;
                            font-size: 10px;
                        }
                    }

                    Rectangle {
                        // The leading edge arrives first; the trailing edge follows the highlight.
                        property <length> lead: parent.nav-offset;
                        property <length> trail: parent.nav-offset;
                        x: nav-workbench.x;
                        y: nav-workbench.y + (nav-workbench.height - 14px) / 2 + min(self.lead, self.trail);
                        width: 3px;
                        height: 14px + abs(self.lead - self.trail);
                        border-radius: 2px;
                        background: Theme.brand;
                        animate lead {
                            duration: Theme.page-motion;
                            easing: cubic-bezier(0.22, 1, 0.36, 1);
                        }
                        animate trail {
                            duration: Theme.drawer-motion;
                            easing: cubic-bezier(0.22, 1, 0.36, 1);
                        }
                    }
                }

                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 57px;
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.border;
                        }

                        HorizontalLayout {
                            padding-left: 30px;
                            padding-right: 24px;
                            spacing: 8px;
                            WindowMoveArea {
                                horizontal-stretch: 1;
                                enabled: root.native-titlebar-overlay && !root.full-screen;
                            }

                            QuietButton {
                                y: (parent.height - self.height) / 2;
                                width: 36px;
                                text: Theme.dark ? "切换浅色" : "切换深色";
                                icon-only: true;
                                ghost: true;
                                icon: Theme.dark ? @image-url("../assets/ui/sun.svg") : @image-url("../assets/ui/moon.svg");
                                icon-color: Theme.muted-text;
                                clicked => { root.set-appearance(!Theme.dark); }
                            }

                            QuietButton {
                                y: (parent.height - self.height) / 2;
                                width: 88px;
                                text: "连接状态";
                                ghost: true;
                                clicked => { root.drawer-open = true; }
                            }

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 36px;
                                height: 36px;
                                QuietButton {
                                    text: operation-notice.has-message ? "查看最近的操作反馈" : "暂无操作反馈";
                                    icon-only: true;
                                    ghost: true;
                                    selected: root.notification-open && operation-notice.has-message;
                                    icon: @image-url("../assets/ui/bell.svg");
                                    icon-color: Theme.muted-text;
                                    enabled: operation-notice.has-message;
                                    clicked => { operation-notice.toggle(); }
                                }

                                Rectangle {
                                    x: 25px;
                                    y: 6px;
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 3px;
                                    background: operation-notice.has-error ? Theme.error : Theme.brand;
                                    opacity: operation-notice.has-message ? 1 : 0;
                                    animate opacity, background { duration: Theme.page-motion; }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        padding: 28px;
                        padding-bottom: 16px;
                        spacing: 18px;
                        HorizontalLayout {
                            height: root.active-page == 1 || root.active-page == 3 ? 52px : 65px;
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 7px;
                                Text {
                                    text: root.page-title;
                                    color: Theme.primary-text;
                                    font-size: root.active-page == 1 || root.active-page == 3 ? 24px : 28px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: root.page-subtitle;
                                    color: Theme.muted-text;
                                    font-size: 13px;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            if root.active-page != 1: StatusPill {
                                width: 98px;
                                label: root.loading ? "读取中…" : "● " + root.connection-label;
                                ink: root.route-running || root.direct-active ? Theme.success : Theme.warning;
                                fill: root.route-running || root.direct-active ? Theme.brand-surface : Theme.warning-surface;
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            opacity: root.page-entered ? 1 : 0;
                            animate opacity {
                                duration: root.page-entered ? Theme.page-motion : 0ms;
                                easing: ease-out;
                            }
                            Rectangle {
                                y: root.page-entered ? 0px : 7px;
                                height: parent.height;
                                animate y {
                                    duration: root.page-entered ? Theme.page-motion : 0ms;
                                    easing: ease-out;
                                }
                                if root.active-page == 0: RoutingPage {
                                    busy: root.busy;
                                    loading: root.loading;
                                    providers: root.providers;
                                    models: root.models;
                                    selected-model-count: root.selected-model-count;
                                    default-model-label: root.default-model-label;
                                    selectable-model-count: root.selectable-model-count;
                                    config-managed: root.config-managed;
                                    route-managed: root.route-managed;
                                    route-running: root.route-running;
                                    direct-active: root.direct-active;
                                    chatgpt-login-pending: root.chatgpt-login-pending || root.xai-pending;
                                    route-status: root.route-status;
                                    config-home: root.config-home;
                                    default-model <=> root.default-model;
                                    model-provider-options: root.model-provider-options;
                                    model-provider-choice <=> root.model-provider-choice;
                                    model-scroll-y <=> root.model-scroll-y;
                                    add-selected-model() => { root.add-selected-model(); }
                                    add-connection => { root.open-connection-picker(); }
                                    select-connection(id, selected) => { root.select-connection(id, selected); }
                                    connection-models(id) => { root.begin-connection-models(id); }
                                    preview-direct(id) => { root.selected-provider-id = id; root.direct-drawer-open = true; root.inspect-direct(id, root.config-home); }
                                    begin-model-editor(provider-id, model-id) => { root.begin-model-editor(provider-id, model-id); }
                                    select-model(id, selected) => { root.select-model(id, selected); }
                                    select-models(selected, selected-only) => { root.select-models(selected, selected-only); }
                                    edit-fallback(id) => { root.edit-fallback(id); }
                                    inspect-route() => { root.publish-drawer-open = true; root.inspect-route(); }
                                    launch-codex() => { root.launch-codex(); }
                                    show-direct() => { root.direct-drawer-open = true; }
                                    restore-config(home) => { root.restore-config(home); }
                                }
                                if root.active-page == 1: VerticalLayout {
                                    spacing: 20px;
                                    Rectangle {
                                        // Ends where the scroll gutter begins so the actions line up with the cards below.
                                        height: 52px;
                                        Rectangle {
                                            x: root.connections-tab == 0 ? 0px : 106px;
                                            y: 8px;
                                            width: 98px;
                                            height: 36px;
                                            border-radius: 10px;
                                            background: Theme.brand.with-alpha(Theme.dark ? 0.09 : 0.07);
                                            animate x {
                                                duration: Theme.drawer-motion;
                                                easing: cubic-bezier(0.22, 1, 0.36, 1);
                                            }
                                        }

                                        HorizontalLayout {
                                            height: 51px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            QuietButton {
                                                y: 8px;
                                                width: 98px;
                                                text: "上游连接";
                                                ghost: true;
                                                tab: true;
                                                background: transparent;
                                                selected: root.connections-tab == 0;
                                                clicked => { root.connections-tab = 0; }
                                            }

                                            QuietButton {
                                                y: 8px;
                                                width: 98px;
                                                text: "订阅账号";
                                                ghost: true;
                                                tab: true;
                                                background: transparent;
                                                selected: root.connections-tab == 1;
                                                clicked => { root.connections-tab = 1; }
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }

                                            if root.connections-progress > 0: Rectangle {
                                                width: 266px;
                                                height: 32px;
                                                y: 9px;
                                                opacity: root.connections-progress * root.connections-progress;
                                                HorizontalLayout {
                                                    x: (1 - root.connections-progress) * 12px;
                                                    width: parent.width;
                                                    spacing: 8px;
                                                    QuietButton {
                                                        width: 112px;
                                                        height: 32px;
                                                        text: "刷新额度";
                                                        icon: @image-url("../assets/refresh.svg");
                                                        icon-color: Theme.muted-text;
                                                        ghost: true;
                                                        enabled: root.connections-tab == 1 && !root.busy && !root.recovery-only && !root.chatgpt-login-pending && !root.xai-pending;
                                                        clicked => { root.account-action(6, ""); root.xai-account-action(5, ""); }
                                                    }

                                                    ComboBox {
                                                        width: 146px;
                                                        min-height: 32px;
                                                        max-height: 32px;
                                                        action-menu: true;
                                                        accessible-role: button;
                                                        primary: true;
                                                        trigger-text: "添加账号";
                                                        trigger-icon: @image-url("../assets/ui/plus.svg");
                                                        model: ["ChatGPT 账号", "Grok 账号"];
                                                        item-enabled: [true, !root.config-managed];
                                                        enabled: root.connections-tab == 1 && !root.busy && !root.chatgpt-login-pending && !root.xai-pending;
                                                        selected(value) => { if (value == "ChatGPT 账号") { root.account-action(1, ""); } else { root.xai-account-action(1, ""); } }
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            x: 0px;
                                            y: 51px;
                                            width: parent.width - 14px;
                                            height: 1px;
                                            background: Theme.border;
                                        }

                                        Rectangle {
                                            // The leading edge arrives first; the trailing edge catches up.
                                            property <length> left-edge: root.connections-tab == 0 ? 12px : 118px;
                                            property <length> right-edge: root.connections-tab == 0 ? 86px : 192px;
                                            x: self.left-edge;
                                            y: 49px;
                                            width: self.right-edge - self.left-edge;
                                            height: 2px;
                                            border-radius: 1px;
                                            background: Theme.brand;
                                            animate left-edge {
                                                duration: root.connections-tab == 1 ? Theme.drawer-motion : Theme.page-motion;
                                                easing: cubic-bezier(0.22, 1, 0.36, 1);
                                            }
                                            animate right-edge {
                                                duration: root.connections-tab == 1 ? Theme.page-motion : Theme.drawer-motion;
                                                easing: cubic-bezier(0.22, 1, 0.36, 1);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                        clip: true;
                                        if root.connections-progress < 1: Rectangle {
                                            x: -root.connections-progress * 24px;
                                            y: root.connections-progress * 6px;
                                            width: parent.width;
                                            height: parent.height;
                                            opacity: (1 - root.connections-progress) * (1 - root.connections-progress);
                                            FocusScope {
                                                enabled: root.connections-tab == 0;
                                                ProvidersPage {
                                                    interactive: root.connections-tab == 0;
                                                    loading: root.loading;
                                                    busy: root.busy || root.connections-tab != 0;
                                                    recovery-only: root.recovery-only;
                                                    providers: root.providers;
                                                    filtered-providers: root.filtered-providers;
                                                    provider-query <=> root.provider-query;
                                                    config-managed: root.config-managed;
                                                    chatgpt-login-pending: root.chatgpt-login-pending || root.xai-pending;
                                                    refresh(check) => { root.refresh(check); }
                                                    filter-providers(query) => { root.filter-providers(query); }
                                                    add-connection() => { root.open-connection-picker(); }
                                                    begin-provider-editor(id) => { root.begin-provider-editor(id); }
                                                    begin-xai-editor(id) => { root.begin-xai-editor(id); }
                                                    begin-subscription-editor(id) => { root.begin-subscription-editor(id); }
                                                    check-provider(id) => { root.check-provider(id); }
                                                    preview-direct(id) => { root.selected-provider-id = id; root.direct-drawer-open = true; root.inspect-direct(id, root.config-home); }
                                                    begin-model-editor(provider-id, model-id) => { root.begin-connection-models(provider-id); }
                                                }
                                            }
                                            // Fading controls must not receive pointer input on the old page.
                                            TouchArea {
                                                enabled: root.connections-tab != 0;
                                            }
                                        }
                                        if root.connections-progress > 0: Rectangle {
                                            x: (1 - root.connections-progress) * 24px;
                                            y: (1 - root.connections-progress) * 6px;
                                            width: parent.width;
                                            height: parent.height;
                                            opacity: root.connections-progress * root.connections-progress;
                                            FocusScope {
                                                enabled: root.connections-tab == 1;
                                                AccountsPage {
                                                    busy: root.busy || root.account-removing-id != "" || root.connections-tab != 1;
                                                    expanded-chatgpt-id <=> root.expanded-chatgpt-account-id;
                                                    expanded-grok-id <=> root.expanded-grok-account-id;
                                                    removing-id: root.account-removing-id;
                                                    recovery-only: root.recovery-only;
                                                    config-managed: root.config-managed;
                                                    auth-status: root.auth-status;
                                                    accounts: root.accounts;
                                                    account-error: root.account-error;
                                                    login-user-code: root.login-user-code;
                                                    login-url: root.login-url;
                                                    chatgpt-login-pending: root.chatgpt-login-pending;
                                                    route-auth-error: root.route-auth-error;
                                                    xai-accounts: root.xai-accounts;
                                                    xai-error: root.xai-account-error;
                                                    xai-user-code: root.xai-user-code;
                                                    xai-login-url: root.xai-login-url;
                                                    xai-pending: root.xai-pending;
                                                    native-expanded <=> root.native-login-expanded;
                                                    request-account-login(account) => {
                                                        root.account-login-confirm-native = false;
                                                        root.account-login-confirm-id = account.id;
                                                        root.account-login-confirm-label = account.label;
                                                        root.account-login-confirm-open = true;
                                                    }
                                                    request-native-login() => {
                                                        root.account-login-confirm-native = true;
                                                        root.account-login-confirm-label = "目标 Codex 目录的本机登录";
                                                        root.account-login-confirm-id = "";
                                                        root.account-login-confirm-open = true;
                                                    }
                                                    xai-account-action(action, id) => { root.xai-account-action(action, id); }
                                                    request-xai-removal(account) => {
                                                        root.delete-account-grok = true;
                                                        root.delete-account-id = account.id;
                                                        root.delete-account-label = account.label;
                                                        root.delete-account-references = account.bound-provider-names;
                                                        root.error-code = "";
                                                        root.error-message = "";
                                                        root.error-action = "";
                                                        root.delete-account-confirm = true;
                                                    }
                                                    subscription-action(action) => { root.subscription-action(action); }
                                                    account-action(action, id) => { root.account-action(action, id); }
                                                    request-account-removal(account) => {
                                                        root.delete-account-grok = false;
                                                        root.delete-account-id = account.id;
                                                        root.delete-account-label = account.label;
                                                        root.delete-account-references = account.bound-provider-names;
                                                        root.error-code = "";
                                                        root.error-message = "";
                                                        root.error-action = "";
                                                        root.delete-account-confirm = true;
                                                    }
                                                }
                                            }

                                            TouchArea {
                                                enabled: root.connections-tab != 1;
                                            }
                                        }
                                    }
                                }
                                if root.active-page == 3: ActivityPage {
                                    requests: root.requests;
                                    stats: root.request-stats;
                                    bars: root.request-bars;
                                    sync: root.request-sync;
                                    loading: root.request-loading;
                                    request-error: root.request-error;
                                    write-failed: root.request-write-failed;
                                    route-running: root.route-running;
                                    live: root.window-visible;
                                    filter <=> root.request-filter;
                                    following <=> root.request-following;
                                    unseen <=> root.request-unseen;
                                    refresh-requests() => { root.refresh-requests(); }
                                    filter-requests(index) => { root.filter-requests(index); }
                                }
                                if root.active-page == 4: VerticalLayout {
                                    spacing: 22px;
                                    for item in [
                                        {
                                            title: "MCP 服务",
                                            detail: "按工作空间组织模型可用的工具服务。",
                                            icon: @image-url("../assets/ui/blocks.svg")
                                        },
                                        {
                                            title: "Skills",
                                            detail: "集中查看技能、来源与适用范围。",
                                            icon: @image-url("../assets/ui/folder.svg")
                                        }
                                    ]: Rectangle {
                                        height: 105px;
                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            background: Theme.border;
                                        }

                                        HorizontalLayout {
                                            spacing: 18px;
                                            Image {
                                                y: (parent.height - self.height) / 2;
                                                width: 26px;
                                                height: 26px;
                                                source: item.icon;
                                                colorize: Theme.brand;
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                Text {
                                                    text: item.title;
                                                    color: Theme.primary-text;
                                                    font-size: 17px;
                                                    font-weight: 500;
                                                }

                                                Text {
                                                    text: item.detail;
                                                    color: Theme.muted-text;
                                                    font-size: 13px;
                                                }
                                            }

                                            StatusPill {
                                                y: (parent.height - self.height) / 2;
                                                label: "尚未接入";
                                            }
                                        }
                                    }
                                    Text {
                                        text: "工具管理将在后续版本接入。当前可在各订阅连接的配置中管理已有 MCP 设置。";
                                        color: Theme.muted-text;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                    }
                                }
                                if root.active-page == 5: ConfigPage {
                                    busy: root.busy;
                                    recovery-only: root.recovery-only;
                                    config-home <=> root.config-home;
                                    route-port <=> root.route-port;
                                    config-status: root.config-status;
                                    config-managed: root.config-managed;
                                    chatgpt-login-pending: root.chatgpt-login-pending || root.xai-pending;
                                    restore-config(home) => { root.restore-config(home); }
                                    inspect-config(home) => { root.inspect-config(home); }
                                    import-current(home) => { root.import-current(home); }
                                    check-login(home) => { root.check-login(home); }
                                    open-common-config() => { root.open-common-config(); }
                                    set-appearance(dark) => { root.set-appearance(dark); }
                                    show-direct() => { root.direct-drawer-open = true; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    WorkspaceMenu {
        open: root.workspace-open;
        config-home: root.config-home;
        connection-label: root.connection-label;
        managed: root.config-managed;
        connected: root.route-running || root.direct-active;
        actions-enabled: !root.busy && !root.chatgpt-login-pending && !root.xai-pending;
        dismissed => { root.workspace-open = false; }
        configure => { root.workspace-open = false; root.active-page = 5; }
        switch-api => { root.workspace-open = false; root.subscription-action(4); }
        details => { root.workspace-open = false; root.drawer-open = true; }
    }

    operation-notice := OperationNotice {
        message: root.error-code != "" ? root.error-message : root.action-message;
        hint: root.error-code != "" ? root.error-action : "";
        error: root.error-code != "";
        sequence: root.feedback-sequence;
        blocked: root.modal-open || root.busy || root.loading;
        details => { root.drawer-open = true; }
        dismissed => { app-keyboard.focus(); }
    }

    connection-drawer := Drawer {
        open: (root.connection-picker-open || root.editor-open || root.subscription-editor-open || root.xai-editor-open || root.connection-models-open) && !root.icon-picker-open && !root.common-config-editor-open;
        title: root.connection-models-open ? root.connection-models-name : root.connection-picker-open || root.new-connection-form ? "添加连接" : root.editor-open ? "API 连接" : root.subscription-editor-open ? "ChatGPT 订阅" : "Grok 订阅连接";
        subtitle: root.connection-picker-open ? "选择订阅账号或 API 服务，继续配置连接。" : "连接设置与模型目录分别保存，完成后在工作台启用。";
        panel-width: root.editor-open || root.subscription-editor-open || root.xai-editor-open ? min(1120px, root.width - 60px) : 820px;
        animate panel-width {
            duration: Theme.drawer-motion;
            easing: cubic-bezier(0.22, 1, 0.36, 1);
        }
        busy: root.busy;
        error-message: root.error-code == "" ? "" : root.error-message + " · " + root.error-action;
        dismissed => { root.close-connection-editor(); }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            if root.connection-picker-open || root.connection-stage-progress < 1: Rectangle {
                width: min(768px, parent.width);
                height: parent.height;
                x: parent.width - self.width - 44px * root.connection-stage-progress;
                opacity: 1 - root.connection-stage-progress;
                FocusScope {
                    enabled: root.connection-picker-open;
                    ConnectionPicker {
                        busy: root.busy || !root.connection-picker-open;
                        config-managed: root.config-managed;
                        arrival: 1 - root.connection-stage-progress;
                        chatgpt-login-pending: root.chatgpt-login-pending || root.xai-pending;
                        provider-presets: root.provider-presets;
                        select-api(id) => { root.connection-preset-id = id; root.begin-provider-editor(""); }
                        select-chatgpt() => { root.begin-subscription-editor(""); }
                        select-grok() => { root.begin-xai-editor(""); }
                    }
                }

                TouchArea {
                    enabled: !root.connection-picker-open;
                }
            }
            if !root.connection-picker-open || root.departing-connection-form != 0: Rectangle {
                width: root.connection-form-kind == 1 || root.connection-form-kind == 2 ? min(1120px, root.width - 60px) - 52px : parent.width;
                height: parent.height;
                x: parent.width - self.width + 72px * (1 - root.connection-stage-progress);
                opacity: root.connection-stage-progress * root.connection-stage-progress;
                FocusScope {
                    enabled: !root.connection-picker-open;
                    VerticalLayout {
                        spacing: 14px;
                        if root.new-connection-form || root.departing-connection-form != 0: HorizontalLayout {
                            height: 36px;
                            spacing: 12px;
                            QuietButton {
                                width: 112px;
                                horizontal-stretch: 0;
                                text: "‹ 返回选择";
                                ghost: true;
                                enabled: !root.busy && !root.connection-picker-open;
                                clicked => { root.return-to-connection-picker(); }
                            }

                            Text {
                                text: root.connection-form-kind == 1 ? (root.edit-preset-id == "" ? "自定义 API" : root.edit-name) : root.connection-form-kind == 2 ? "ChatGPT 订阅" : "Grok 订阅";
                                color: Theme.primary-text;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if !root.new-connection-form && root.departing-connection-form == 0: HorizontalLayout {
                            height: 44px;
                            spacing: 16px;
                            cross-axis-alignment: center;
                            editor-tabs := QuietSegmented {
                                width: 320px;
                                height: 44px;
                                options: ["连接设置", "模型目录"];
                                enabled-options: [true, !root.config-managed];
                                enabled: !root.busy;
                                current-index: root.connection-models-open ? 1 : 0;
                                selection-background: Theme.brand-surface;
                                property <string> connection-id: root.connection-models-open ? root.connection-models-id : root.editor-open ? root.edit-id : root.subscription-editor-open ? root.subscription-id : root.xai-provider-id;
                                selected(index) => {
                                    if index == 0 {
                                        root.edit-connection(self.connection-id);
                                    } else {
                                        root.begin-connection-models(self.connection-id);
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: root.editor-open ? "API 连接 / 设置" : root.connection-models-open ? "连接 / 模型目录" : "订阅连接 / 设置";
                                color: Theme.muted-text;
                                font-size: 11px;
                            }
                        }
                        if root.connection-models-open: ConnectionModels {
                            busy: root.busy;
                            saving: root.busy && root.connection-models-saving;
                            managed: root.config-managed;
                            subscription: root.connection-models-subscription;
                            dirty: root.connection-models-dirty;
                            rows <=> root.connection-models;
                            message: root.connection-models-message;
                            message-tone: root.connection-models-tone;
                            fetching: root.fetching-models && root.discovery-scope == 2;
                            discovery-message: root.discovery-scope == 2 ? root.discovery-message : "";
                            discovery-tone: root.discovery-tone;
                            candidates: root.batch-models;
                            summary: root.batch-summary;
                            query <=> root.batch-query;
                            fetch => { root.fetch-models(2); }
                            add => { root.add-connection-model(); }
                            edited => { root.connection-model-edited(); }
                            toggle(index) => { root.batch-toggle(index); }
                            select-all(checked) => { root.batch-select-all(checked); }
                            filter(query) => { root.batch-filter(query); }
                            append => { root.append-discovered-models(); }
                            save => { root.save-connection-models(); }
                            cancel => { root.connection-models-open = false; }
                        }
                        if root.editor-open || root.departing-connection-form == 1: ProviderEditor {
                            busy: root.busy;
                            compact: root.height < 760px;
                            editor-open <=> root.editor-open;
                            delete-confirm <=> root.delete-confirm;
                            edit-id: root.edit-id;
                            edit-name <=> root.edit-name;
                            edit-url <=> root.edit-url;
                            edit-model <=> root.edit-model;
                            edit-key <=> root.edit-key;
                            edit-remote-compaction <=> root.edit-remote-compaction;
                            edit-use-common-config <=> root.edit-use-common-config;
                            edit-context-1m <=> root.edit-context-1m;
                            edit-compact-limit <=> root.edit-compact-limit;
                            edit-config-preview: root.edit-config-preview;
                            edit-config-error: root.edit-config-error;
                            edit-preset-id: root.edit-preset-id;
                            edit-icon-name: root.edit-icon-name;
                            edit-icon: root.edit-icon;
                            edit-icon-monochrome: root.edit-icon-monochrome;
                            fetched-models: root.fetched-models;
                            fetching-models: root.fetching-models;
                            discovery-message: root.discovery-message;
                            discovery-scope: root.discovery-scope;
                            discovery-tone: root.discovery-tone;
                            config-managed: root.config-managed;
                            batch-rows: root.batch-models;
                            batch-summary: root.batch-summary;
                            batch-query <=> root.batch-query;
                            border-width: 0px;
                            background: transparent;
                            batch-toggle(index) => { root.batch-toggle(index); }
                            batch-select-all(checked) => { root.batch-select-all(checked); }
                            batch-filter(query) => { root.batch-filter(query); }
                            save-provider(id, name, url, model, key) => { root.save-provider(id, name, url, model, key); }
                            open-common-config() => { root.open-common-config(); }
                            delete-provider(id) => { root.delete-provider(id); }
                            open-provider-preset-link(api-key-page) => { root.open-provider-preset-link(api-key-page); }
                            open-provider-icon-picker() => { root.open-provider-icon-picker(); }
                            fetch-models(scope) => { root.fetch-models(scope); }
                            dismiss-discovery => { root.reset-model-discovery(); }
                        }

                        if root.subscription-editor-open || root.departing-connection-form == 2: SubscriptionEditor {
                            busy: root.busy;
                            compact: root.height < 760px;
                            border-width: 0px;
                            background: transparent;
                            subscription-id: root.subscription-id;
                            subscription-name <=> root.subscription-name;
                            subscription-binding-label: root.subscription-binding-label;
                            subscription-account-ids: root.subscription-account-ids;
                            subscription-account-options: root.subscription-account-options;
                            subscription-account-choice <=> root.subscription-account-choice;
                            subscription-auth-json <=> root.subscription-auth-json;
                            subscription-auth-error: root.subscription-auth-error;
                            delete-confirm <=> root.delete-confirm;
                            edit-use-common-config <=> root.edit-use-common-config;
                            edit-context-1m <=> root.edit-context-1m;
                            edit-compact-limit <=> root.edit-compact-limit;
                            edit-config-preview <=> root.edit-config-preview;
                            edit-config-error: root.edit-config-error;
                            edit-icon-name: root.edit-icon-name;
                            edit-icon: root.edit-icon;
                            edit-icon-monochrome: root.edit-icon-monochrome;
                            config-managed: root.config-managed;
                            save-subscription(id, name, account-id) => { root.save-subscription(id, name, account-id); }
                            cancel-subscription-editor() => { root.cancel-subscription-editor(); }
                            format-subscription-auth() => { root.format-subscription-auth(); }
                            subscription-auth-edited() => { root.subscription-auth-edited(); }
                            subscription-config-edited() => { root.subscription-config-edited(); }
                            update-subscription-context() => { root.update-subscription-context(); }
                            update-subscription-common() => { root.update-subscription-common(); }
                            open-common-config() => { root.open-common-config(); }
                            delete-provider(id) => { root.delete-provider(id); }
                            open-provider-icon-picker() => { root.open-provider-icon-picker(); }
                            configure-models() => { root.begin-connection-models(root.subscription-id); }
                            navigate(page) => { root.cancel-subscription-editor(); root.connections-tab = 1; root.active-page = 1; }
                        }

                        if root.xai-editor-open || root.departing-connection-form == 3: XaiEditor {
                            busy: root.busy;
                            compact: root.height < 760px;
                            border-width: 0px;
                            background: transparent;
                            config-managed: root.config-managed;
                            provider-id: root.xai-provider-id;
                            provider-name <=> root.xai-provider-name;
                            accounts: root.xai-account-options;
                            choice <=> root.xai-account-choice;
                            delete-confirm <=> root.delete-confirm;
                            save => { root.save-xai(); }
                            cancel => { root.xai-editor-open = false; root.delete-confirm = false; }
                            delete-provider(id) => { root.delete-provider(id); }
                            manage-accounts => { root.xai-editor-open = false; root.connections-tab = 1; root.active-page = 1; root.xai-account-action(0, ""); }
                            configure-models => { root.begin-connection-models(root.xai-provider-id); }
                        }
                    }
                }

                TouchArea {
                    enabled: root.connection-picker-open;
                }
            }
        }
    }

    Timer {
        interval: 220ms;
        running: root.batch-autofetch;
        triggered => {
            root.batch-autofetch = false;
            if (root.model-editor-open && root.model-batch-mode && root.model-original-id == "" && !root.busy && !root.fetching-models && root.batch-models.length == 0) {
                root.fetch-models(1);
            }
        }
    }

    Drawer {
        open: root.model-editor-open;
        title: "模型设置";
        subtitle: "修改在下次发布时应用。";
        panel-width: 700px;
        busy: root.busy;
        error-message: root.error-code == "" ? "" : root.error-message + " · " + root.error-action;
        dismissed => { root.model-editor-open = false; }
        ModelEditor {
            busy: root.busy;
            fetched-models: root.fetched-models;
            fetching-models: root.fetching-models;
            discovery-message: root.discovery-message;
            discovery-scope: root.discovery-scope;
            discovery-tone: root.discovery-tone;
            config-managed: root.config-managed;
            model-editor-open <=> root.model-editor-open;
            model-provider-name: root.model-provider-name;
            model-upstream-id <=> root.model-upstream-id;
            model-public-id <=> root.model-public-id;
            model-display-name <=> root.model-display-name;
            model-display-name-custom <=> root.model-display-name-custom;
            model-source-path <=> root.model-source-path;
            model-original-id: root.model-original-id;
            model-context-window <=> root.model-context-window;
            model-reasoning-levels <=> root.model-reasoning-levels;
            model-default-reasoning <=> root.model-default-reasoning;
            model-reasoning-options: root.model-reasoning-options;
            model-delete-confirm <=> root.model-delete-confirm;
            batch-mode <=> root.model-batch-mode;
            batch-rows: root.batch-models;
            batch-summary: root.batch-summary;
            batch-saving: root.batch-saving;
            batch-query <=> root.batch-query;
            batch-context <=> root.batch-context;
            batch-levels <=> root.batch-levels;
            batch-default <=> root.batch-default;
            batch-levels-label: root.batch-levels-label;
            batch-reasoning-options: root.batch-reasoning-options;
            batch-list-height: clamp(root.height - 470px, 232px, 460px);
            fetch-models(scope) => { root.fetch-models(scope); }
            dismiss-discovery => { root.reset-model-discovery(); }
            save-model() => { root.save-model(); }
            delete-model() => { root.delete-model(); }
            restore-display-name => { root.update-model-display-name(); }
            batch-toggle(index) => { root.batch-toggle(index); }
            batch-select-all(checked) => { root.batch-select-all(checked); }
            batch-filter(query) => { root.batch-filter(query); }
            batch-edit(index, context, levels) => { root.batch-edit(index, context, levels); }
            save-batch => { root.save-batch-models(); }
        }
    }

    Drawer {
        open: root.fallback-editor-open;
        title: "备用策略";
        subtitle: "";
        panel-width: 660px;
        busy: root.busy;
        error-message: root.error-code == "" ? "" : root.error-message + " · " + root.error-action;
        dismissed => { root.fallback-editor-open = false; }
        SurfaceCard {
            height: 350px;
            border-width: 0px;
            background: transparent;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: "备用上游 · " + root.fallback-primary-label;
                    color: Theme.primary-text;
                    font-size: 16px;
                    font-weight: 600;
                    overflow: elide;
                }

                ComboBox {
                    model: root.fallback-options;
                    current-index <=> root.fallback-choice;
                    accessible-label: "选择备用上游";
                    enabled: !root.busy && !root.config-managed;
                    selected(value) => { root.fallback-consent = false; }
                }

                Text {
                    text: "主上游 → 一个备用上游。仅在连接建立失败且请求尚未发送时尝试一次；超时、HTTP 错误和响应中断均不切换。主备实际模型 ID、能力和指令模板须一致。";
                    color: Theme.muted-text;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Text {
                    text: "选择备用后，请确认该站点的数据区域与隐私要求适用；费用可能变化。备用模型无需单独发布。";
                    color: Theme.muted-text;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                CheckBox {
                    text: "允许在上述条件下把完整请求发送到所选备用站点";
                    checked <=> root.fallback-consent;
                    enabled: root.fallback-choice > 0 && !root.busy && !root.config-managed;
                }

                HorizontalLayout {
                    spacing: 8px;
                    QuietButton {
                        text: "保存备用策略";
                        primary: true;
                        enabled: !root.busy && !root.config-managed && (root.fallback-choice == 0 || root.fallback-consent);
                        clicked => { root.save-fallback(); }
                    }

                    QuietButton {
                        text: "取消";
                        clicked => { root.fallback-editor-open = false; }
                    }
                }
            }
        }
    }

    Drawer {
        open: root.common-config-editor-open && !root.icon-picker-open;
        title: "通用配置";
        subtitle: "";
        panel-width: 920px;
        busy: root.busy;
        error-message: root.error-code == "" ? "" : root.error-message + " · " + root.error-action;
        dismissed => { root.cancel-common-config(); }
        CommonConfigEditor {
            open: root.common-config-editor-open && !root.icon-picker-open;
            compact: root.height < 760px;
            busy: root.busy;
            border-width: 0px;
            background: transparent;
            common-config-draft <=> root.common-config-draft;
            common-config-saved: root.common-config-saved;
            common-config-error: root.common-config-error;
            common-config-message: root.common-config-message;
            common-config-current-source: root.common-config-current-source;
            config-managed: root.config-managed;
            extract-common-config() => { root.extract-common-config(); }
            save-common-config() => { root.save-common-config(); }
            cancel-common-config() => { root.cancel-common-config(); }
        }
    }

    Drawer {
        open: root.icon-picker-open;
        title: "选择连接头像";
        subtitle: "";
        panel-width: 760px;
        busy: root.busy;
        error-message: root.error-code == "" ? "" : root.error-message + " · " + root.error-action;
        dismissed => { root.close-provider-icon-picker(); }
        if root.icon-picker-open: ProviderIconPicker {
            busy: root.busy;
            provider-icons: root.provider-icons;
            filtered-provider-icons: root.filtered-provider-icons;
            provider-icon-query <=> root.provider-icon-query;
            edit-icon-id: root.edit-icon-id;
            edit-icon-name: root.edit-icon-name;
            config-managed: root.config-managed;
            choose-provider-icon(id) => { root.choose-provider-icon(id); }
            close-provider-icon-picker() => { root.close-provider-icon-picker(); }
            filter-provider-icons(query) => { root.filter-provider-icons(query); }
        }
    }

    // Block pointer input while a confirmed removal collapses and is dispatched.
    if root.account-removing-id != "": TouchArea { }

    Drawer {
        open: root.account-login-confirm-open;
        centered: true;
        title: root.account-login-confirm-native ? "重新登录 Codex" : "写入 Codex 登录";
        subtitle: root.account-login-confirm-label;
        panel-width: 520px;
        busy: root.busy;
        dismissed => { root.dismiss-account-login(); }
        VerticalLayout {
            spacing: 16px;
            Text {
                text: "执行时会先恢复受管配置，并停止当前路由。";
                color: Theme.warning;
                font-size: 13px;
                wrap: word-wrap;
            }

            Text {
                text: "各上游的账号绑定保持不变。完成后，请在工作台重新发布，并启动新会话。";
                color: Theme.muted-text;
                font-size: 13px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;
                QuietButton {
                    text: "取消";
                    enabled: root.account-login-confirm-open && !root.busy;
                    clicked => { root.dismiss-account-login(); }
                }

                QuietButton {
                    text: root.account-login-confirm-native ? "继续登录" : "确认写入";
                    primary: true;
                    enabled: root.account-login-confirm-open && !root.busy && !root.chatgpt-login-pending && !root.xai-pending && (root.account-login-confirm-native || (!root.recovery-only && root.account-login-confirm-id != ""));
                    clicked => {
                        if (root.account-login-confirm-native) { root.subscription-action(1); }
                        else { root.account-action(3, root.account-login-confirm-id); }
                        root.dismiss-account-login();
                    }
                }
            }
        }
    }

    Drawer {
        open: root.delete-account-confirm;
        title: "移除订阅账号";
        subtitle: "";
        panel-width: 580px;
        busy: root.busy;
        error-message: root.error-code == "" ? "" : root.error-message + " · " + root.error-action;
        dismissed => { root.delete-account-confirm = false; root.delete-account-id = ""; }
        SurfaceCard {
            border-width: 0px;
            background: transparent;
            height: (root.error-code == "" ? 272px : 332px) + (root.delete-account-references == "" ? 0px : 64px);
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text {
                    text: root.delete-account-grok ? "移除 Grok 账号" : "移除 ChatGPT 账号";
                    color: Theme.primary-text;
                    font-size: 19px;
                    font-weight: 600;
                }

                Text {
                    text: root.delete-account-label;
                    color: Theme.primary-text;
                    font-size: 14px;
                    overflow: elide;
                }

                Text {
                    text: root.delete-account-references == "" ? "将移除此账号在 SwitchX 中保存的登录信息。" : "此账号仍被上游引用。请先重新绑定或删除关联上游，再移除账号。";
                    color: Theme.muted-text;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                if root.delete-account-references != "": Text {
                    text: "关联上游：" + root.delete-account-references;
                    color: Theme.warning;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                if root.error-code != "": Text {
                    text: root.error-message;
                    color: Theme.error;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 10px;
                    QuietButton {
                        text: "取消";
                        enabled: !root.busy;
                        clicked => {
                            root.delete-account-confirm = false;
                            root.delete-account-id = "";
                        }
                    }

                    QuietButton {
                        text: "确认移除";
                        primary: true;
                        enabled: !root.busy && !root.config-managed && !root.chatgpt-login-pending && !root.xai-pending && root.delete-account-id != "" && root.delete-account-references == "";
                        clicked => {
                            root.account-removing-grok = root.delete-account-grok;
                            root.account-removing-id = root.delete-account-id;
                            root.delete-account-confirm = false;
                        }
                    }
                }
            }
        }
    }

    changed route-running => { if (root.route-running) { root.publish-drawer-open = false; } }
    changed direct-active => { if (root.direct-active) { root.direct-drawer-open = false; } }

    Drawer {
        open: root.publish-drawer-open;
        title: "启用前，确认一下。";
        subtitle: "检查目录与连接，确认配置变化，再开启新的 Codex 会话。";
        panel-width: 690px;
        busy: root.busy;
        error-message: root.error-code == "" ? "" : root.error-message + " · " + root.error-action;
        dismissed => {
            root.publish-drawer-open = false;
            if (!root.config-managed) { root.cancel-route-preview(); }
            app-keyboard.focus();
        }
        VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                Text {
                    text: root.selected-model-count + " 个模型 · 默认 " + root.default-model;
                    color: Theme.primary-text;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                StatusPill {
                    label: root.busy ? "正在检查…" : root.route-preview-ready ? "检查通过" : "等待检查";
                    ink: root.route-preview-ready ? Theme.success : Theme.warning;
                    fill: root.route-preview-ready ? Theme.brand-surface : Theme.warning-surface;
                }
            }

            Text {
                text: root.config-home;
                color: Theme.muted-text;
                font-size: 12px;
                wrap: word-wrap;
            }

            SurfaceCard {
                vertical-stretch: 1;
                background: Theme.background;
                ScrollView {
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    x: 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    height: parent.height - 32px;
                    VerticalLayout {
                        Text {
                            min-width: 0px;
                            text: root.route-preview == "" ? (root.busy ? "正在检查模型目录、连接与目标配置…" : "检查完成后，配置差异会显示在这里。") : root.route-preview;
                            color: Theme.primary-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Text {
                text: root.action-message;
                color: Theme.muted-text;
                font-size: 12px;
                wrap: word-wrap;
            }

            Text {
                text: "在新会话中使用发布后的模型菜单；跨上游切换请新建会话。停止时恢复启用前的配置。";
                color: Theme.muted-text;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;
                QuietButton {
                    text: "重新检查";
                    enabled: !root.busy && !root.config-managed && !root.chatgpt-login-pending && !root.xai-pending;
                    clicked => { root.inspect-route(); }
                }

                QuietButton {
                    text: root.busy ? "正在处理…" : "确认启用  →";
                    primary: true;
                    enabled: !root.busy && !root.config-managed && !root.chatgpt-login-pending && !root.xai-pending && root.route-preview-ready;
                    clicked => { root.apply-route(); }
                }
            }
        }
    }

    Drawer {
        open: root.direct-drawer-open;
        title: "直连配置";
        subtitle: "一个连接，一个默认模型。先查看变更，再应用。";
        panel-width: 640px;
        busy: root.busy;
        error-message: root.error-code == "" ? "" : root.error-message;
        dismissed => { root.direct-drawer-open = false; app-keyboard.focus(); }
        VerticalLayout {
            spacing: 16px;
            Text {
                text: root.config-home;
                color: Theme.muted-text;
                font-size: 12px;
                wrap: word-wrap;
            }

            SurfaceCard {
                vertical-stretch: 1;
                background: Theme.background;
                ScrollView {
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    x: 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    height: parent.height - 32px;
                    VerticalLayout {
                        Text {
                            min-width: 0px;
                            text: root.direct-preview == "" ? (root.direct-active ? root.config-status : "在连接列表选择 API 连接的“直连”，即可查看配置差异。") : root.direct-preview;
                            color: Theme.primary-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Text {
                text: root.action-message;
                color: Theme.muted-text;
                font-size: 12px;
                wrap: word-wrap;
            }

            Text {
                text: "应用前检查模型列表。移动或删除 SwitchX 前，请先恢复原配置。";
                color: Theme.muted-text;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;
                QuietButton {
                    text: "恢复原配置";
                    enabled: !root.busy && root.config-managed;
                    clicked => { root.restore-config(root.config-home); }
                }

                QuietButton {
                    text: root.busy ? "正在处理…" : "应用直连";
                    primary: true;
                    enabled: root.direct-preview-ready && !root.busy && !root.chatgpt-login-pending && !root.xai-pending;
                    clicked => { root.apply-direct(); }
                }
            }
        }
    }

    ConnectionStatusDialog {
        open: root.drawer-open;
        busy: root.busy;
        loading: root.loading;
        data-ready: root.local-data-ready;
        credentials-checked: root.credentials-checked;
        provider-count: root.providers.length;
        status-text: root.status-text;
        config-mode: root.config-mode;
        config-provider: root.config-provider;
        config-model: root.config-model;
        config-exists: root.config-exists;
        direct-active: root.direct-active;
        route-running: root.route-running;
        route-managed: root.route-managed;
        config-managed: root.config-managed;
        connection-label: root.connection-label;
        route-status: root.route-status;
        action-message: root.action-message;
        config-home: root.config-home;
        data-path: root.data-path;
        problem: root.error-code == "" ? "" : root.error-message + " · " + root.error-action;
        directories-expanded <=> root.status-directories-expanded;
        dismissed => { root.drawer-open = false; app-keyboard.focus(); }
        restore-requested => { root.restore-config(root.config-home); }
        configure-requested => { root.drawer-open = false; root.active-page = 5; app-keyboard.focus(); }
    }
}

export component SwitchXTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.svg");
    tooltip: "switchx";
    callback show-app();
    callback restore-config();
    callback quit-app();
    Menu {
        MenuItem {
            title: "打开 switchx";
            activated => { root.show-app(); }
        }

        MenuItem {
            title: "恢复原配置";
            activated => { root.restore-config(); }
        }

        MenuItem {
            title: "退出";
            activated => { root.quit-app(); }
        }
    }
}
