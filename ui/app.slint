import { LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "tokens.slint";
import { QuietButton, SurfaceCard, StatusPill } from "components.slint";

export struct ProviderRow {
    id: string,
    name: string,
    endpoint: string,
    base-url: string,
    model-id: string,
    credential-status: string,
}

export component AppWindow inherits Window {
    title: "switchx";
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 1040px;
    min-height: 680px;
    background: Theme.background;

    in-out property <int> active-page: 0;
    in-out property <bool> drawer-open: false;
    in-out property <bool> loading: true;
    in-out property <bool> busy: false;
    in-out property <string> error-code: "";
    in-out property <string> error-message: "";
    in-out property <string> error-action: "";
    in-out property <string> status-text: "正在读取本地资料…";
    in-out property <string> data-path: "";
    in-out property <[ProviderRow]> providers: [];
    in-out property <[ProviderRow]> filtered-providers: [];
    in-out property <string> provider-query: "";
    in-out property <bool> editor-open: false;
    in-out property <bool> delete-confirm: false;
    in-out property <string> edit-id: "";
    in-out property <string> edit-name: "";
    in-out property <string> edit-url: "";
    in-out property <string> edit-model: "";
    in-out property <string> edit-key: "";
    in-out property <string> config-home: "";
    in-out property <string> config-status: "尚未读取 Codex 配置";
    in-out property <bool> direct-active: false;
    in-out property <string> auth-status: "官方登录状态尚未检查";
    in-out property <string> selected-provider-id: "";
    in-out property <string> direct-preview: "";
    in-out property <bool> direct-preview-ready: false;
    in-out property <string> action-message: "";
    changed active-page => {
        root.error-code = "";
        root.error-message = "";
        root.error-action = "";
    }
    callback refresh(bool);
    callback filter-providers(string);
    callback save-provider(string, string, string, string, string);
    callback delete-provider(string);
    callback check-provider(string);
    callback inspect-direct(string, string);
    callback apply-direct();
    callback restore-direct(string);
    callback inspect-config(string);
    callback import-current(string);
    callback check-login(string);
    changed drawer-open => {
        if (root.drawer-open) { drawer-keyboard.focus(); }
        else { status-button.focus(); }
    }

    drawer-keyboard := FocusScope {
        width: 0px;
        enabled: root.drawer-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.drawer-open = false;
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 208px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "switchx"; color: Theme.primary-text; font-size: 27px; font-weight: 700; }
                SurfaceCard {
                    height: 62px;
                    background: Theme.raised;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        Text { text: "Codex"; color: Theme.primary-text; font-size: 14px; font-weight: 600; }
                        Text { text: "本地工作空间"; color: Theme.muted-text; font-size: 11px; }
                    }
                }
                Text { text: "WORKSPACE"; color: Theme.muted-text; font-size: 10px; }
                QuietButton { text: "总览"; selected: root.active-page == 0; left-aligned: true; clicked => { root.active-page = 0; } }
                QuietButton { text: "上游供应商"; selected: root.active-page == 1; left-aligned: true; clicked => { root.active-page = 1; } }
                QuietButton { text: "模型路由"; selected: root.active-page == 2; left-aligned: true; clicked => { root.active-page = 2; } }
                QuietButton { text: "请求与用量"; selected: root.active-page == 3; left-aligned: true; clicked => { root.active-page = 3; } }
                Text { text: "TOOLBOX"; color: Theme.muted-text; font-size: 10px; }
                QuietButton { text: "MCP · Skills"; selected: root.active-page == 4; left-aligned: true; clicked => { root.active-page = 4; } }
                QuietButton { text: "配置与恢复"; selected: root.active-page == 5; left-aligned: true; clicked => { root.active-page = 5; } }
                Rectangle { vertical-stretch: 1; }
                QuietButton { text: "偏好设置"; selected: root.active-page == 6; left-aligned: true; clicked => { root.active-page = 6; } }
                Text { text: "●  路由未启用"; color: Theme.warning; font-size: 12px; }
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 18px;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 5px;
                    Text { text: "YOUR MODELS. ONE PLACE."; color: Theme.muted-text; font-size: 11px; }
                    Text {
                        text: root.active-page == 0 ? "模型，各就各位。"
                            : root.active-page == 1 ? "上游供应商"
                            : root.active-page == 2 ? "模型路由"
                            : root.active-page == 3 ? "请求与用量"
                            : root.active-page == 4 ? "MCP · Skills"
                            : root.active-page == 5 ? "配置与恢复" : "偏好设置";
                        color: Theme.primary-text;
                        font-size: 28px;
                        font-weight: 700;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                QuietButton {
                    width: 80px;
                    horizontal-stretch: 0;
                    text: Theme.dark ? "浅色" : "深色";
                    clicked => {
                        Theme.dark = !Theme.dark;
                        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
                    }
                }
                status-button := QuietButton { width: 104px; horizontal-stretch: 0; text: "状态详情"; clicked => { root.drawer-open = true; } }
            }
            Text {
                text: root.active-page == 0 ? "一个 Codex，自由连接你信任的每一个模型。" : "这里显示 SwitchX 本地保存的状态。";
                color: Theme.muted-text;
                font-size: 14px;
            }
            if root.error-code != "" : SurfaceCard {
                height: 74px;
                border-color: Theme.error;
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    Text { text: root.error-message + " · " + root.error-code; color: Theme.error; font-size: 14px; font-weight: 600; }
                    Text { text: root.error-action; color: Theme.muted-text; font-size: 12px; }
                }
            }
            if root.action-message != "" : SurfaceCard {
                height: 64px;
                Text { text: root.action-message; color: Theme.primary-text; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
            }

            if root.active-page == 0 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 20px;
                    SurfaceCard {
                        height: 248px;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 18px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "连接控制台"; color: Theme.primary-text; font-size: 17px; font-weight: 600; }
                                StatusPill { label: root.direct-active ? "直连已配置" : "未启用"; ink: root.direct-active ? Theme.success : Theme.warning; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.direct-active ? "待客户端重启" : "本地状态"; color: Theme.muted-text; font-size: 12px; }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                SurfaceCard {
                                    width: 176px;
                                    height: 94px;
                                    background: Theme.raised;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 5px;
                                        Text { text: "Codex"; color: Theme.primary-text; font-size: 15px; font-weight: 600; }
                                        Text { text: root.direct-active ? "直连已写入" : "查看配置与恢复"; color: Theme.muted-text; font-size: 12px; }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; horizontal-stretch: 1; }
                                SurfaceCard {
                                    width: 176px;
                                    height: 94px;
                                    background: Theme.brand-surface;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 5px;
                                        Text { text: "SwitchX Router"; color: Theme.primary-text; font-size: 15px; font-weight: 600; }
                                        Text { text: "尚未启动"; color: Theme.muted-text; font-size: 12px; }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; horizontal-stretch: 1; }
                                SurfaceCard {
                                    width: 176px;
                                    height: 94px;
                                    background: Theme.raised;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 5px;
                                        Text { text: "上游"; color: Theme.primary-text; font-size: 15px; font-weight: 600; }
                                        Text { text: root.providers.length + " 个本地记录"; color: Theme.muted-text; font-size: 12px; }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            Text { text: root.direct-active ? "Codex 直连所选上游；SwitchX 不经手推理请求。" : "此窗口不会发送模型请求。直连需从上游列表预览后应用。"; color: Theme.muted-text; font-size: 12px; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 12px;
                            Text { text: "本地上游资料"; color: Theme.primary-text; font-size: 16px; font-weight: 600; }
                            SurfaceCard {
                                height: 172px;
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    Text {
                                        text: root.loading ? "正在读取…" : root.error-code != "" ? "读取失败" : root.providers.length == 0 ? "还没有上游记录" : root.providers.length + " 个上游记录";
                                        color: Theme.primary-text;
                                        font-size: 17px;
                                        font-weight: 600;
                                    }
                                    Text { text: "添加上游后，这里会显示真实连接。"; color: Theme.muted-text; font-size: 13px; wrap: word-wrap; }
                                    QuietButton { text: "查看上游"; clicked => { root.active-page = 1; } }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 12px;
                            Text { text: "Codex 模型菜单"; color: Theme.primary-text; font-size: 16px; font-weight: 600; }
                            SurfaceCard {
                                height: 172px;
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    Text { text: "未发布目录"; color: Theme.primary-text; font-size: 17px; font-weight: 600; }
                                    Text { text: "此客户端尚未发布模型目录。"; color: Theme.muted-text; font-size: 13px; wrap: word-wrap; }
                                    QuietButton { text: "查看路由"; clicked => { root.active-page = 2; } }
                                }
                            }
                        }
                    }
                    SurfaceCard {
                        height: 92px;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            Text { text: "本地状态"; color: Theme.primary-text; font-size: 15px; font-weight: 600; }
                            Text { text: root.status-text; color: Theme.muted-text; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                }
            }

            if root.active-page == 1 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        Text { text: "已保存的上游元数据"; color: Theme.primary-text; font-size: 16px; font-weight: 600; }
                        Rectangle { horizontal-stretch: 1; }
                        LineEdit {
                            width: 220px;
                            horizontal-stretch: 0;
                            placeholder-text: "按名称筛选";
                            accessible-label: "按名称筛选上游";
                            text <=> root.provider-query;
                            edited(text) => { root.filter-providers(text); }
                        }
                        QuietButton { width: 106px; text: "检查凭据"; clicked => { root.refresh(true); } }
                        QuietButton { width: 70px; text: "刷新"; clicked => { root.refresh(false); } }
                        QuietButton {
                            width: 92px;
                            text: "添加上游";
                            clicked => {
                                root.edit-id = "";
                                root.edit-name = "";
                                root.edit-url = "";
                                root.edit-model = "";
                                root.edit-key = "";
                                root.delete-confirm = false;
                                root.editor-open = true;
                            }
                        }
                    }
                    Text { height: 28px; text: "仅支持原生 Responses 上游；API Key 保存到系统凭据存储。"; color: Theme.muted-text; font-size: 13px; }
                    if root.editor-open : SurfaceCard {
                        height: 302px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 7px;
                            Text { text: root.edit-id == "" ? "添加上游" : "编辑上游"; color: Theme.primary-text; font-size: 17px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { width: 92px; text: "名称"; color: Theme.muted-text; vertical-alignment: center; }
                                LineEdit { text <=> root.edit-name; placeholder-text: "例如 DeepSeek"; accessible-label: "上游名称"; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { width: 92px; text: "API 地址"; color: Theme.muted-text; vertical-alignment: center; }
                                LineEdit { text <=> root.edit-url; placeholder-text: "https://example.com/v1"; accessible-label: "上游 API 地址"; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { width: 92px; text: "模型 ID"; color: Theme.muted-text; vertical-alignment: center; }
                                LineEdit { text <=> root.edit-model; placeholder-text: "上游实际模型 ID"; accessible-label: "上游模型 ID"; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { width: 92px; text: "API Key"; color: Theme.muted-text; vertical-alignment: center; }
                                LineEdit { text <=> root.edit-key; input-type: password; placeholder-text: root.edit-id == "" ? "必填" : "留空则保留已保存的 Key"; accessible-label: "上游 API Key"; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                QuietButton {
                                    text: "保存"; primary: true; enabled: !root.busy;
                                    clicked => {
                                        root.save-provider(root.edit-id, root.edit-name, root.edit-url, root.edit-model, root.edit-key);
                                        root.edit-key = "";
                                    }
                                }
                                QuietButton { text: "取消"; clicked => { root.edit-key = ""; root.editor-open = false; } }
                                if root.edit-id != "" : QuietButton { text: root.delete-confirm ? "确认删除" : "删除"; enabled: !root.busy; clicked => {
                                    if (root.delete-confirm) { root.delete-provider(root.edit-id); root.edit-key = ""; }
                                    else { root.delete-confirm = true; }
                                } }
                            }
                        }
                    }
                    if !root.loading && root.error-code == "" && root.providers.length == 0 : SurfaceCard {
                        height: 140px;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 10px;
                            Text { text: "还没有上游"; color: Theme.primary-text; font-size: 18px; font-weight: 600; }
                            Text { text: "点击“添加上游”保存 Responses API 连接。"; color: Theme.muted-text; font-size: 13px; }
                        }
                    }
                    if !root.loading && root.error-code == "" && root.providers.length > 0 && root.filtered-providers.length == 0 : SurfaceCard {
                        height: 100px;
                        Text { text: "没有匹配的上游。清除筛选可查看全部记录。"; color: Theme.muted-text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    for provider in root.filtered-providers : SurfaceCard {
                        height: 108px;
                        HorizontalLayout {
                            padding: 20px;
                            spacing: 10px;
                            VerticalLayout {
                                spacing: 7px;
                                Text { text: provider.name; color: Theme.primary-text; font-size: 16px; font-weight: 600; }
                                Text { text: provider.endpoint; color: Theme.muted-text; font-size: 12px; }
                                Text { text: provider.model-id; color: Theme.muted-text; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: provider.credential-status; color: Theme.muted-text; font-size: 12px; }
                            QuietButton { width: 62px; text: "编辑"; clicked => {
                                root.edit-id = provider.id;
                                root.edit-name = provider.name;
                                root.edit-url = provider.base-url;
                                root.edit-model = provider.model-id;
                                root.edit-key = "";
                                root.delete-confirm = false;
                                root.editor-open = true;
                            } }
                            QuietButton { width: 70px; text: "检查"; enabled: !root.busy; clicked => { root.check-provider(provider.id); } }
                            QuietButton { width: 70px; text: "直连"; enabled: !root.busy; clicked => {
                                root.selected-provider-id = provider.id;
                                root.active-page = 5;
                                root.inspect-direct(provider.id, root.config-home);
                            } }
                        }
                    }
                }
            }

            if root.active-page >= 2 && root.active-page <= 4 : SurfaceCard {
                height: 200px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: root.active-page == 2 ? "目录与路由尚未启用" : root.active-page == 3 ? "还没有请求记录" : "MCP 与 Skills 尚未接入";
                        color: Theme.primary-text;
                        font-size: 19px;
                        font-weight: 600;
                    }
                    Text {
                        text: root.active-page == 2 ? "模型目录与路由尚未对当前客户端启用。" : root.active-page == 3 ? "界面未启动路由，因此不会出现真实请求。" : "不会自动导入或执行外部命令。";
                        color: Theme.muted-text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }

            if root.active-page == 5 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 14px;
                    SurfaceCard {
                        height: 176px;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            Text { text: "Codex 配置目录"; color: Theme.primary-text; font-size: 16px; font-weight: 600; }
                            LineEdit { text <=> root.config-home; accessible-label: "Codex 配置目录绝对路径"; }
                            Text { text: "只管理此目录的 config.toml；切换对新启动的客户端生效。"; color: Theme.muted-text; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                QuietButton { text: "读取当前配置"; enabled: !root.busy; clicked => { root.inspect-config(root.config-home); } }
                                QuietButton { text: "导入当前上游"; enabled: !root.busy; clicked => { root.import-current(root.config-home); } }
                                QuietButton { text: "检查官方登录"; enabled: !root.busy; clicked => { root.check-login(root.config-home); } }
                            }
                        }
                    }
                    SurfaceCard {
                        height: 154px;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            Text { text: root.config-status; color: Theme.primary-text; font-size: 15px; wrap: word-wrap; }
                            Text { text: root.auth-status; color: Theme.muted-text; font-size: 13px; wrap: word-wrap; }
                            Text { text: "API Key 直连与 ChatGPT 官方登录是两条独立路径。导入只读取上游资料，不复制原凭据。"; color: Theme.muted-text; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    SurfaceCard {
                        height: 230px;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;
                            Text { text: "直连切换"; color: Theme.primary-text; font-size: 17px; font-weight: 600; }
                            Text { text: root.direct-preview == "" ? "从上游列表选择“直连”，先查看受管字段差异。" : root.direct-preview; color: Theme.muted-text; font-size: 13px; wrap: word-wrap; }
                            Text { text: "应用前会再次检查 /models 和所选模型；这不能证明 Responses 工具调用兼容。"; color: Theme.warning; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                QuietButton { text: "应用直连"; primary: true; enabled: root.direct-preview-ready && !root.busy; clicked => { root.apply-direct(); } }
                                QuietButton { text: "恢复原配置"; enabled: !root.busy; clicked => { root.restore-direct(root.config-home); } }
                            }
                            Text { text: "直连凭据依赖当前 SwitchX 程序路径；移动或删除应用前请恢复原配置。"; color: Theme.muted-text; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                }
            }

            if root.active-page == 6 : SurfaceCard {
                height: 210px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;
                    Text { text: "外观"; color: Theme.primary-text; font-size: 18px; font-weight: 600; }
                    Text { text: "当前主题仅保存在本次运行中。界面没有持续动画。"; color: Theme.muted-text; font-size: 13px; }
                    QuietButton {
                        text: Theme.dark ? "切换到浅色" : "切换到深色";
                        clicked => {
                            Theme.dark = !Theme.dark;
                            Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
                        }
                    }
                }
            }
        }
    }

    if root.drawer-open : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000070;
        TouchArea { clicked => { root.drawer-open = false; } }
    }
    if root.drawer-open : Rectangle {
        x: root.width - 400px; y: 0px; width: 400px; height: root.height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            Text { text: "连接状态"; color: Theme.primary-text; font-size: 22px; font-weight: 700; }
            StatusPill { label: "未启用路由"; ink: Theme.warning; }
            Text { text: root.status-text; color: Theme.primary-text; font-size: 14px; wrap: word-wrap; }
            Text { text: "本地数据目录"; color: Theme.muted-text; font-size: 12px; }
            Text { text: root.data-path; color: Theme.primary-text; font-size: 12px; wrap: word-wrap; }
            if root.error-code != "" : Text { text: root.error-message + " · " + root.error-action; color: Theme.error; font-size: 13px; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            QuietButton { text: "关闭"; clicked => { root.drawer-open = false; } }
        }
    }
}

export component SwitchXTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.svg");
    tooltip: "switchx";
    callback show-app();
    callback restore-config();
    callback quit-app();
    Menu {
        MenuItem { title: "打开 switchx"; activated => { root.show-app(); } }
        MenuItem { title: "恢复直连前配置"; activated => { root.restore-config(); } }
        MenuItem { title: "退出"; activated => { root.quit-app(); } }
    }
}
