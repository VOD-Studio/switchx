import { Palette } from "std-widgets.slint";
import { Theme } from "tokens.slint";
import { QuietButton, SurfaceCard, StatusPill } from "components.slint";
import {
    ProviderRow,
    ProviderPresetRow,
    ProviderIconRow,
    AccountRow,
    ModelRow,
    RequestRow,
} from "view-models.slint";
import { OverviewPage } from "pages/overview.slint";
import { ProviderIconPicker } from "editors/provider-icon-picker.slint";
import { ProvidersPage } from "pages/providers.slint";
import { SubscriptionEditor } from "editors/subscription-editor.slint";
import { CommonConfigEditor } from "editors/common-config-editor.slint";
import { RoutingPage } from "pages/routing.slint";
import { ActivityPage } from "pages/activity.slint";
import { ConfigPage } from "pages/config.slint";

export {
    ProviderRow,
    ProviderPresetRow,
    ProviderIconRow,
    AccountRow,
    ModelRow,
    RequestRow,
} from "view-models.slint";
export { SyntaxHighlighting, CodeSpan } from "code-editor.slint";

export component AppWindow inherits Window {
    title: "switchx";
    icon: @image-url("../assets/app-icon.png");
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 1040px;
    min-height: 680px;
    background: Theme.background;

    in-out property <int> active-page: 0;
    in-out property <bool> drawer-open: false;
    in-out property <bool> loading: true;
    in-out property <bool> busy: false;
    in-out property <bool> recovery-only: false;
    in-out property <string> error-code: "";
    in-out property <string> error-message: "";
    in-out property <string> error-action: "";
    in-out property <string> status-text: "正在读取本地资料…";
    in-out property <string> data-path: "";
    in-out property <[ProviderRow]> providers: [];
    in-out property <[ProviderRow]> filtered-providers: [];
    in-out property <string> provider-query: "";
    in-out property <bool> editor-open: false;
    in-out property <bool> subscription-editor-open: false;
    in-out property <string> subscription-id: "";
    in-out property <string> subscription-name: "";
    in-out property <string> subscription-binding-label: "";
    in-out property <[string]> subscription-account-ids: [];
    in-out property <[string]> subscription-account-options: [];
    in-out property <int> subscription-account-choice: 0;
    in-out property <string> subscription-auth-json: "";
    in-out property <string> subscription-auth-error: "";
    in-out property <bool> config-editor-updating: false;
    in-out property <int> subscription-editor-generation: 0;
    in-out property <bool> subscription-editor-pending: false;
    in-out property <bool> delete-confirm: false;
    in-out property <string> edit-id: "";
    in-out property <string> edit-name: "";
    in-out property <string> edit-url: "";
    in-out property <string> edit-model: "";
    in-out property <string> edit-key: "";
    in-out property <bool> edit-remote-compaction: false;
    in-out property <bool> edit-use-common-config: true;
    in-out property <bool> edit-context-1m: false;
    in-out property <string> edit-compact-limit: "900000";
    in-out property <string> edit-config-preview: "";
    in-out property <string> edit-config-error: "";
    in-out property <bool> common-config-editor-open: false;
    in-out property <string> common-config-draft: "";
    in-out property <string> common-config-saved: "";
    in-out property <string> common-config-error: "";
    in-out property <string> common-config-message: "";
    in-out property <string> common-config-current-source: "";
    in property <[ProviderPresetRow]> provider-presets;
    in-out property <string> edit-preset-id: "";
    in-out property <string> edit-preset-url: "";
    in-out property <image> edit-preset-icon;
    in-out property <bool> edit-preset-monochrome: false;
    in property <[ProviderIconRow]> provider-icons;
    in-out property <[ProviderIconRow]> filtered-provider-icons;
    in-out property <string> provider-icon-query: "";
    in-out property <bool> icon-picker-open: false;
    in-out property <string> edit-icon-id: "";
    in-out property <string> edit-icon-name: "";
    in-out property <image> edit-icon;
    in-out property <bool> edit-icon-monochrome: false;
    in-out property <[string]> fetched-models: [];
    in-out property <bool> fetching-models: false;
    in-out property <string> discovery-message: "";
    in-out property <int> discovery-generation: 0;
    in-out property <int> discovery-scope: 0;
    in-out property <string> config-home: "";
    in-out property <string> config-status: "尚未读取 Codex 配置";
    in-out property <bool> direct-active: false;
    in-out property <string> auth-status: "官方登录状态尚未检查";
    in-out property <[AccountRow]> accounts: [];
    in-out property <string> account-status: "账号列表尚未读取";
    in-out property <string> login-user-code: "";
    in-out property <string> login-url: "";
    in-out property <string> selected-account-id: "";
    in-out property <string> delete-account-id: "";
    in-out property <bool> delete-account-confirm: false;
    property <string> delete-account-label: "";
    property <string> delete-account-references: "";
    in-out property <bool> chatgpt-login-pending: false;
    in-out property <string> chatgpt-login-id: "";
    in-out property <string> route-auth-error: "";
    in-out property <string> selected-provider-id: "";
    in-out property <string> direct-preview: "";
    in-out property <bool> direct-preview-ready: false;
    in-out property <string> action-message: "";
    in-out property <[ModelRow]> models: [];
    in-out property <[RequestRow]> requests: [];
    in-out property <string> request-error: "";
    in-out property <int> selected-model-count: 0;
    in-out property <bool> config-managed: false;
    in-out property <bool> route-managed: false;
    in-out property <bool> route-running: false;
    in-out property <string> route-status: "路由未启用";
    in-out property <string> route-port: "18731";
    in-out property <string> default-model: "";
    in-out property <string> route-preview: "";
    in-out property <bool> route-preview-ready: false;
    in-out property <string> route-preview-model: "";
    in-out property <bool> model-editor-open: false;
    in-out property <string> model-provider-id: "";
    in-out property <string> model-provider-name: "";
    in-out property <string> model-upstream-id: "";
    in-out property <string> model-public-id: "";
    in-out property <string> model-display-name: "";
    in-out property <bool> model-display-name-custom: false;
    in-out property <string> model-source-path: "";
    in-out property <string> model-original-id: "";
    in-out property <string> model-context-window: "";
    in-out property <string> model-reasoning-levels: "";
    in-out property <string> model-default-reasoning: "未设置";
    in-out property <[string]> model-reasoning-options: ["未设置"];
    in-out property <bool> model-delete-confirm: false;
    in-out property <[string]> model-provider-ids: [];
    in-out property <[string]> model-provider-options: [];
    in-out property <int> model-provider-choice: 0;
    in-out property <length> model-scroll-y: 0px;
    in-out property <bool> fallback-editor-open: false;
    in-out property <string> fallback-primary-id;
    in-out property <string> fallback-primary-label;
    in-out property <[string]> fallback-ids;
    in-out property <[string]> fallback-options;
    in-out property <int> fallback-choice: 0;
    in-out property <bool> fallback-consent: false;
    changed config-home => {
        root.route-preview-ready = false;
        root.direct-preview-ready = false;
        root.auth-status = "此目录的官方登录状态尚未检查";
        if (root.subscription-editor-open || root.subscription-editor-pending) { root.cancel-subscription-editor(); }
    }
    changed active-page => {
        if (root.active-page != 1 && root.icon-picker-open) { root.close-provider-icon-picker(); }
        if (root.active-page != 1 && (root.subscription-editor-open || root.subscription-editor-pending)) { root.cancel-subscription-editor(); }
    }
    changed subscription-editor-open => {
        if (!root.subscription-editor-open) {
            root.subscription-auth-json = "";
            root.subscription-auth-error = "";
        }
    }
    changed subscription-account-choice => {
        if (root.subscription-editor-open && !root.config-editor-updating) { root.load-subscription-auth(); }
    }
    changed route-port => { root.route-preview-ready = false; }
    changed default-model => {
        if root.default-model != root.route-preview-model { root.route-preview-ready = false; }
    }
    function reset-model-discovery() {
        root.discovery-generation += 1;
        root.fetched-models = [];
        root.fetching-models = false;
        root.discovery-message = "";
    }
    changed edit-id => { root.reset-model-discovery(); }
    changed edit-url => {
        root.reset-model-discovery();
        if (root.edit-preset-id != "" && root.edit-url != root.edit-preset-url) {
            root.edit-preset-id = "";
        }
        root.update-provider-icon();
        if (root.editor-open) { root.update-provider-config-preview(); }
    }
    changed edit-name => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-model => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-remote-compaction => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-use-common-config => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-context-1m => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-compact-limit => { if (root.editor-open) { root.update-provider-config-preview(); } }
    changed edit-key => { root.reset-model-discovery(); }
    changed editor-open => {
        root.reset-model-discovery();
        if (root.editor-open) { root.update-provider-config-preview(); }
    }
    changed model-provider-id => { root.reset-model-discovery(); }
    changed model-original-id => { root.reset-model-discovery(); }
    changed model-editor-open => {
        root.reset-model-discovery();
        if (root.model-editor-open) { root.model-scroll-y = 0px; }
    }
    changed model-reasoning-levels => { root.update-reasoning-options(); }
    changed model-upstream-id => { root.update-model-display-name(); }
    callback refresh(bool);
    callback refresh-requests();
    callback filter-providers(string);
    callback save-provider(string, string, string, string, string);
    callback begin-provider-editor(string);
    callback begin-subscription-editor(string);
    callback save-subscription(string, string, string);
    callback cancel-subscription-editor();
    callback load-subscription-auth();
    callback format-subscription-auth();
    callback subscription-auth-edited();
    callback subscription-config-edited();
    callback update-subscription-context();
    callback update-subscription-common();
    callback update-provider-config-preview();
    callback open-common-config();
    callback extract-common-config();
    callback save-common-config();
    callback cancel-common-config();
    callback delete-provider(string);
    callback check-provider(string);
    callback apply-provider-preset(string);
    callback open-provider-preset-link(bool);
    callback open-provider-icon-picker();
    callback choose-provider-icon(string);
    callback close-provider-icon-picker();
    callback filter-provider-icons(string);
    callback update-provider-icon();
    callback fetch-models(int);
    callback inspect-direct(string, string);
    callback apply-direct();
    callback restore-config(string);
    callback inspect-config(string);
    callback import-current(string);
    callback check-login(string);
    callback subscription-action(int);
    callback account-action(int, string);
    callback save-model();
    callback delete-model();
    callback begin-model-editor(string, string);
    callback add-selected-model();
    callback update-model-display-name();
    callback update-reasoning-options();
    callback select-model(string, bool);
    callback edit-fallback(string);
    callback save-fallback();
    callback inspect-route();
    callback apply-route();
    callback launch-codex();
    callback cancel-route-preview();
    callback poll-route-status();
    Timer {
        interval: 2s;
        running: root.route-running;
        triggered => { root.poll-route-status(); }
    }

    changed drawer-open => {
        if (root.drawer-open) { drawer-keyboard.focus(); }
        else { status-button.focus(); }
    }

    drawer-keyboard := FocusScope {
        width: 0px;
        enabled: root.drawer-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.drawer-open = false;
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 208px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "switchx";
                    color: Theme.primary-text;
                    font-size: 27px;
                    font-weight: 700;
                }

                SurfaceCard {
                    height: 62px;
                    background: Theme.raised;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        Text {
                            text: "Codex";
                            color: Theme.primary-text;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        Text {
                            text: "本地工作空间";
                            color: Theme.muted-text;
                            font-size: 11px;
                        }
                    }
                }

                Text {
                    text: "WORKSPACE";
                    color: Theme.muted-text;
                    font-size: 10px;
                }

                QuietButton {
                    text: "总览";
                    selected: root.active-page == 0;
                    left-aligned: true;
                    clicked => { root.active-page = 0; }
                }

                QuietButton {
                    text: "上游供应商";
                    selected: root.active-page == 1;
                    left-aligned: true;
                    clicked => { root.active-page = 1; }
                }

                QuietButton {
                    text: "模型路由";
                    selected: root.active-page == 2;
                    left-aligned: true;
                    clicked => { root.active-page = 2; }
                }

                QuietButton {
                    text: "请求与用量";
                    selected: root.active-page == 3;
                    left-aligned: true;
                    enabled: !root.busy;
                    clicked => { root.active-page = 3; root.refresh-requests(); }
                }

                Text {
                    text: "TOOLBOX";
                    color: Theme.muted-text;
                    font-size: 10px;
                }

                QuietButton {
                    text: "MCP · Skills";
                    selected: root.active-page == 4;
                    left-aligned: true;
                    clicked => { root.active-page = 4; }
                }

                QuietButton {
                    text: "配置与恢复";
                    selected: root.active-page == 5;
                    left-aligned: true;
                    clicked => { root.active-page = 5; }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                QuietButton {
                    text: "偏好设置";
                    selected: root.active-page == 6;
                    left-aligned: true;
                    clicked => { root.active-page = 6; }
                }

                Text {
                    text: root.route-running ? "●  模型路由运行中" : root.route-managed ? "●  路由配置待恢复" : "●  路由未启用";
                    color: root.route-running ? Theme.success : Theme.warning;
                    font-size: 12px;
                }
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 18px;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 5px;
                    Text {
                        text: "YOUR MODELS. ONE PLACE.";
                        color: Theme.muted-text;
                        font-size: 11px;
                    }

                    Text {
                        text: root.active-page == 0 ? "模型，各就各位。"
                            : root.active-page == 1 ? (root.icon-picker-open ? "选择上游头像" : root.common-config-editor-open ? "Codex 通用配置" : "上游供应商")
                            : root.active-page == 2 ? "模型路由"
                            : root.active-page == 3 ? "请求与用量"
                            : root.active-page == 4 ? "MCP · Skills"
                            : root.active-page == 5 ? "配置与恢复" : "偏好设置";
                        color: Theme.primary-text;
                        font-size: 28px;
                        font-weight: 700;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                QuietButton {
                    width: 80px;
                    horizontal-stretch: 0;
                    text: Theme.dark ? "浅色" : "深色";
                    clicked => {
                        Theme.dark = !Theme.dark;
                        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
                    }
                }

                status-button := QuietButton {
                    width: 104px;
                    horizontal-stretch: 0;
                    text: "状态详情";
                    clicked => { root.drawer-open = true; }
                }
            }

            Text {
                text: root.active-page == 0 ? "一个 Codex，自由连接你信任的每一个模型。" : "这里显示 SwitchX 本地保存的状态。";
                color: Theme.muted-text;
                font-size: 14px;
            }

            if root.error-code != "": SurfaceCard {
                height: 74px;
                border-color: Theme.error;
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    Text {
                        text: root.error-message + " · " + root.error-code;
                        color: Theme.error;
                        font-size: 14px;
                        font-weight: 600;
                    }

                    Text {
                        text: root.error-action;
                        color: Theme.muted-text;
                        font-size: 12px;
                    }
                }
            }
            if root.action-message != "": SurfaceCard {
                height: 64px;
                Text {
                    text: root.action-message;
                    color: Theme.primary-text;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }

            if root.active-page == 0: OverviewPage {
                loading: root.loading;
                error-code: root.error-code;
                status-text: root.status-text;
                providers: root.providers;
                direct-active: root.direct-active;
                selected-model-count: root.selected-model-count;
                config-managed: root.config-managed;
                route-managed: root.route-managed;
                route-running: root.route-running;
                navigate(page) => { root.active-page = page; }
            }

            if root.active-page == 1 && root.icon-picker-open: ProviderIconPicker {
                busy: root.busy;
                provider-icons: root.provider-icons;
                filtered-provider-icons: root.filtered-provider-icons;
                provider-icon-query <=> root.provider-icon-query;
                edit-icon-id: root.edit-icon-id;
                edit-icon-name: root.edit-icon-name;
                config-managed: root.config-managed;
                choose-provider-icon(id) => { root.choose-provider-icon(id); }
                close-provider-icon-picker() => { root.close-provider-icon-picker(); }
                filter-provider-icons(query) => { root.filter-provider-icons(query); }
            }

            if root.active-page == 1 && !root.common-config-editor-open && !root.subscription-editor-open && !root.icon-picker-open: ProvidersPage {
                loading: root.loading;
                busy: root.busy;
                recovery-only: root.recovery-only;
                error-code: root.error-code;
                providers: root.providers;
                filtered-providers: root.filtered-providers;
                provider-query <=> root.provider-query;
                editor-open <=> root.editor-open;
                delete-confirm <=> root.delete-confirm;
                edit-id: root.edit-id;
                edit-name <=> root.edit-name;
                edit-url <=> root.edit-url;
                edit-model <=> root.edit-model;
                edit-key <=> root.edit-key;
                edit-remote-compaction <=> root.edit-remote-compaction;
                edit-use-common-config <=> root.edit-use-common-config;
                edit-context-1m <=> root.edit-context-1m;
                edit-compact-limit <=> root.edit-compact-limit;
                edit-config-preview: root.edit-config-preview;
                edit-config-error: root.edit-config-error;
                provider-presets: root.provider-presets;
                edit-preset-id: root.edit-preset-id;
                edit-icon-name: root.edit-icon-name;
                edit-icon: root.edit-icon;
                edit-icon-monochrome: root.edit-icon-monochrome;
                fetched-models: root.fetched-models;
                fetching-models: root.fetching-models;
                discovery-message: root.discovery-message;
                discovery-scope: root.discovery-scope;
                chatgpt-login-pending: root.chatgpt-login-pending;
                config-managed: root.config-managed;
                refresh(check-credentials) => { root.refresh(check-credentials); }
                filter-providers(query) => { root.filter-providers(query); }
                save-provider(id, name, url, model, key) => { root.save-provider(id, name, url, model, key); }
                begin-provider-editor(id) => { root.begin-provider-editor(id); }
                begin-subscription-editor(id) => { root.begin-subscription-editor(id); }
                open-common-config() => { root.open-common-config(); }
                delete-provider(id) => { root.delete-provider(id); }
                check-provider(id) => { root.check-provider(id); }
                apply-provider-preset(id) => { root.apply-provider-preset(id); }
                open-provider-preset-link(api-key-page) => { root.open-provider-preset-link(api-key-page); }
                open-provider-icon-picker() => { root.open-provider-icon-picker(); }
                fetch-models(scope) => { root.fetch-models(scope); }
                preview-direct(provider-id) => {
                    root.selected-provider-id = provider-id;
                    root.active-page = 5;
                    root.inspect-direct(provider-id, root.config-home);
                }
                begin-model-editor(provider-id, model-id) => { root.begin-model-editor(provider-id, model-id); }
            }

            if root.active-page == 1 && root.subscription-editor-open && !root.common-config-editor-open && !root.icon-picker-open: SubscriptionEditor {
                busy: root.busy;
                subscription-id: root.subscription-id;
                subscription-name <=> root.subscription-name;
                subscription-binding-label: root.subscription-binding-label;
                subscription-account-ids: root.subscription-account-ids;
                subscription-account-options: root.subscription-account-options;
                subscription-account-choice <=> root.subscription-account-choice;
                subscription-auth-json <=> root.subscription-auth-json;
                subscription-auth-error: root.subscription-auth-error;
                delete-confirm <=> root.delete-confirm;
                edit-use-common-config <=> root.edit-use-common-config;
                edit-context-1m <=> root.edit-context-1m;
                edit-compact-limit <=> root.edit-compact-limit;
                edit-config-preview <=> root.edit-config-preview;
                edit-config-error: root.edit-config-error;
                edit-icon-name: root.edit-icon-name;
                edit-icon: root.edit-icon;
                edit-icon-monochrome: root.edit-icon-monochrome;
                config-managed: root.config-managed;
                save-subscription(id, name, account-id) => { root.save-subscription(id, name, account-id); }
                cancel-subscription-editor() => { root.cancel-subscription-editor(); }
                format-subscription-auth() => { root.format-subscription-auth(); }
                subscription-auth-edited() => { root.subscription-auth-edited(); }
                subscription-config-edited() => { root.subscription-config-edited(); }
                update-subscription-context() => { root.update-subscription-context(); }
                update-subscription-common() => { root.update-subscription-common(); }
                open-common-config() => { root.open-common-config(); }
                delete-provider(id) => { root.delete-provider(id); }
                open-provider-icon-picker() => { root.open-provider-icon-picker(); }
                navigate(page) => { root.active-page = page; }
            }

            if root.active-page == 1 && root.common-config-editor-open && !root.icon-picker-open: CommonConfigEditor {
                busy: root.busy;
                common-config-draft <=> root.common-config-draft;
                common-config-error: root.common-config-error;
                common-config-message: root.common-config-message;
                common-config-current-source: root.common-config-current-source;
                config-managed: root.config-managed;
                extract-common-config() => { root.extract-common-config(); }
                save-common-config() => { root.save-common-config(); }
                cancel-common-config() => { root.cancel-common-config(); }
            }

            if root.active-page == 2: RoutingPage {
                busy: root.busy;
                providers: root.providers;
                fetched-models: root.fetched-models;
                fetching-models: root.fetching-models;
                discovery-message: root.discovery-message;
                discovery-scope: root.discovery-scope;
                config-home: root.config-home;
                chatgpt-login-pending: root.chatgpt-login-pending;
                models: root.models;
                selected-model-count: root.selected-model-count;
                config-managed: root.config-managed;
                route-managed: root.route-managed;
                route-running: root.route-running;
                route-status: root.route-status;
                route-port <=> root.route-port;
                default-model <=> root.default-model;
                route-preview: root.route-preview;
                route-preview-ready: root.route-preview-ready;
                model-editor-open <=> root.model-editor-open;
                model-provider-name: root.model-provider-name;
                model-upstream-id <=> root.model-upstream-id;
                model-public-id <=> root.model-public-id;
                model-display-name <=> root.model-display-name;
                model-display-name-custom <=> root.model-display-name-custom;
                model-source-path <=> root.model-source-path;
                model-original-id: root.model-original-id;
                model-context-window <=> root.model-context-window;
                model-reasoning-levels <=> root.model-reasoning-levels;
                model-default-reasoning <=> root.model-default-reasoning;
                model-reasoning-options: root.model-reasoning-options;
                model-delete-confirm <=> root.model-delete-confirm;
                model-provider-options: root.model-provider-options;
                model-provider-choice <=> root.model-provider-choice;
                model-scroll-y <=> root.model-scroll-y;
                fallback-editor-open <=> root.fallback-editor-open;
                fallback-primary-label: root.fallback-primary-label;
                fallback-options: root.fallback-options;
                fallback-choice <=> root.fallback-choice;
                fallback-consent <=> root.fallback-consent;
                fetch-models(scope) => { root.fetch-models(scope); }
                restore-config(home) => { root.restore-config(home); }
                save-model() => { root.save-model(); }
                delete-model() => { root.delete-model(); }
                begin-model-editor(provider-id, model-id) => { root.begin-model-editor(provider-id, model-id); }
                add-selected-model() => { root.add-selected-model(); }
                select-model(id, selected) => { root.select-model(id, selected); }
                edit-fallback(id) => { root.edit-fallback(id); }
                save-fallback() => { root.save-fallback(); }
                inspect-route() => { root.inspect-route(); }
                apply-route() => { root.apply-route(); }
                launch-codex() => { root.launch-codex(); }
                cancel-route-preview() => { root.cancel-route-preview(); }
                navigate(page) => { root.active-page = page; }
            }

            if root.active-page == 3: ActivityPage {
                busy: root.busy;
                requests: root.requests;
                request-error: root.request-error;
                refresh-requests() => { root.refresh-requests(); }
            }

            if root.active-page == 4: SurfaceCard {
                height: 200px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: "MCP 与 Skills 尚未接入";
                        color: Theme.primary-text;
                        font-size: 19px;
                        font-weight: 600;
                    }

                    Text {
                        text: "不会自动导入或执行外部命令。";
                        color: Theme.muted-text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }

            if root.active-page == 5: ConfigPage {
                busy: root.busy;
                recovery-only: root.recovery-only;
                config-home <=> root.config-home;
                config-status: root.config-status;
                auth-status: root.auth-status;
                accounts: root.accounts;
                account-status: root.account-status;
                login-user-code: root.login-user-code;
                login-url: root.login-url;
                chatgpt-login-pending: root.chatgpt-login-pending;
                route-auth-error: root.route-auth-error;
                direct-preview: root.direct-preview;
                direct-preview-ready: root.direct-preview-ready;
                config-managed: root.config-managed;
                apply-direct() => { root.apply-direct(); }
                restore-config(home) => { root.restore-config(home); }
                inspect-config(home) => { root.inspect-config(home); }
                import-current(home) => { root.import-current(home); }
                check-login(home) => { root.check-login(home); }
                subscription-action(action) => { root.subscription-action(action); }
                account-action(action, account-id) => { root.account-action(action, account-id); }
                request-account-removal(account) => {
                    root.delete-account-id = account.id;
                    root.delete-account-label = account.label;
                    root.delete-account-references = account.bound-provider-names;
                    root.error-code = "";
                    root.error-message = "";
                    root.error-action = "";
                    root.delete-account-confirm = true;
                }
            }

            if root.active-page == 6: SurfaceCard {
                height: 210px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;
                    Text {
                        text: "外观";
                        color: Theme.primary-text;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    Text {
                        text: "当前主题仅保存在本次运行中。界面没有持续动画。";
                        color: Theme.muted-text;
                        font-size: 13px;
                    }

                    QuietButton {
                        text: Theme.dark ? "切换到浅色" : "切换到深色";
                        clicked => {
                            Theme.dark = !Theme.dark;
                            Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
                        }
                    }
                }
            }
        }
    }

    if root.drawer-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000070;
        TouchArea {
            clicked => { root.drawer-open = false; }
        }
    }
    if root.drawer-open: Rectangle {
        x: root.width - 400px;
        y: 0px;
        width: 400px;
        height: root.height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            Text {
                text: "连接状态";
                color: Theme.primary-text;
                font-size: 22px;
                font-weight: 700;
            }

            StatusPill {
                label: root.route-running ? "模型路由运行中" : root.route-managed ? "配置待恢复" : "未启用路由";
                ink: root.route-running ? Theme.success : Theme.warning;
            }

            Text {
                text: root.route-status;
                color: Theme.primary-text;
                font-size: 13px;
                wrap: word-wrap;
            }

            Text {
                text: root.status-text;
                color: Theme.primary-text;
                font-size: 14px;
                wrap: word-wrap;
            }

            Text {
                text: "本地数据目录";
                color: Theme.muted-text;
                font-size: 12px;
            }

            Text {
                text: root.data-path;
                color: Theme.primary-text;
                font-size: 12px;
                wrap: word-wrap;
            }

            if root.error-code != "": Text {
                text: root.error-message + " · " + root.error-action;
                color: Theme.error;
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle {
                vertical-stretch: 1;
            }

            QuietButton {
                text: "关闭";
                clicked => { root.drawer-open = false; }
            }
        }
    }

    if root.delete-account-confirm: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000070;
        TouchArea {
            enabled: !root.busy;
            clicked => {
                root.delete-account-confirm = false;
                root.delete-account-id = "";
            }
        }
    }
    if root.delete-account-confirm: SurfaceCard {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 480px;
        height: (root.error-code == "" ? 272px : 332px) + (root.delete-account-references == "" ? 0px : 64px);
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text {
                text: "移除 ChatGPT 账号";
                color: Theme.primary-text;
                font-size: 19px;
                font-weight: 600;
            }

            Text {
                text: root.delete-account-label;
                color: Theme.primary-text;
                font-size: 14px;
                overflow: elide;
            }

            Text {
                text: root.delete-account-references == "" ? "将移除此账号在 SwitchX 中保存的登录信息。Codex 配置目录会保留。" : "此账号仍被上游引用。请先重新绑定或删除关联上游，再移除账号。";
                color: Theme.muted-text;
                font-size: 13px;
                wrap: word-wrap;
            }

            if root.delete-account-references != "": Text {
                text: "关联上游：" + root.delete-account-references;
                color: Theme.warning;
                font-size: 13px;
                wrap: word-wrap;
            }

            if root.error-code != "": Text {
                text: root.error-message;
                color: Theme.error;
                font-size: 13px;
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
            }

            HorizontalLayout {
                spacing: 10px;
                QuietButton {
                    text: "取消";
                    enabled: !root.busy;
                    clicked => {
                        root.delete-account-confirm = false;
                        root.delete-account-id = "";
                    }
                }

                QuietButton {
                    text: "确认移除";
                    primary: true;
                    enabled: !root.busy && !root.config-managed && !root.chatgpt-login-pending && root.delete-account-id != "" && root.delete-account-references == "";
                    clicked => { root.account-action(4, root.delete-account-id); }
                }
            }
        }
    }
}

export component SwitchXTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.svg");
    tooltip: "switchx";
    callback show-app();
    callback restore-config();
    callback quit-app();
    Menu {
        MenuItem {
            title: "打开 switchx";
            activated => { root.show-app(); }
        }

        MenuItem {
            title: "恢复原配置";
            activated => { root.restore-config(); }
        }

        MenuItem {
            title: "退出";
            activated => { root.quit-app(); }
        }
    }
}
