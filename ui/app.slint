import { Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "tokens.slint";
import { QuietButton, SurfaceCard, StatusPill } from "components.slint";

export struct ProviderRow {
    name: string,
    endpoint: string,
    credential-status: string,
}

export component AppWindow inherits Window {
    title: "switchx";
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 1040px;
    min-height: 680px;
    background: Theme.background;

    in-out property <int> active-page: 0;
    in-out property <bool> drawer-open: false;
    in-out property <bool> loading: true;
    in-out property <string> error-code: "";
    in-out property <string> error-message: "";
    in-out property <string> error-action: "";
    in-out property <string> status-text: "正在读取本地资料…";
    in-out property <string> data-path: "";
    in-out property <[ProviderRow]> providers: [];
    callback refresh(bool);
    changed drawer-open => { if (root.drawer-open) { drawer-keyboard.focus(); } }

    drawer-keyboard := FocusScope {
        width: 0px;
        enabled: root.drawer-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.drawer-open = false;
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 208px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "switchx"; color: Theme.primary-text; font-size: 27px; font-weight: 700; }
                SurfaceCard {
                    height: 62px;
                    background: Theme.raised;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        Text { text: "Codex"; color: Theme.primary-text; font-size: 14px; font-weight: 600; }
                        Text { text: "本地工作空间"; color: Theme.muted-text; font-size: 11px; }
                    }
                }
                Text { text: "WORKSPACE"; color: Theme.muted-text; font-size: 10px; }
                QuietButton { text: "总览"; selected: root.active-page == 0; left-aligned: true; clicked => { root.active-page = 0; } }
                QuietButton { text: "上游供应商"; selected: root.active-page == 1; left-aligned: true; clicked => { root.active-page = 1; } }
                QuietButton { text: "模型路由"; selected: root.active-page == 2; left-aligned: true; clicked => { root.active-page = 2; } }
                QuietButton { text: "请求与用量"; selected: root.active-page == 3; left-aligned: true; clicked => { root.active-page = 3; } }
                Text { text: "TOOLBOX"; color: Theme.muted-text; font-size: 10px; }
                QuietButton { text: "MCP · Skills"; selected: root.active-page == 4; left-aligned: true; clicked => { root.active-page = 4; } }
                QuietButton { text: "配置与恢复"; selected: root.active-page == 5; left-aligned: true; clicked => { root.active-page = 5; } }
                Rectangle { vertical-stretch: 1; }
                QuietButton { text: "偏好设置"; selected: root.active-page == 6; left-aligned: true; clicked => { root.active-page = 6; } }
                Text { text: "●  路由未启用"; color: Theme.warning; font-size: 12px; }
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 18px;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 5px;
                    Text { text: "YOUR MODELS. ONE PLACE."; color: Theme.muted-text; font-size: 11px; }
                    Text {
                        text: root.active-page == 0 ? "模型，各就各位。"
                            : root.active-page == 1 ? "上游供应商"
                            : root.active-page == 2 ? "模型路由"
                            : root.active-page == 3 ? "请求与用量"
                            : root.active-page == 4 ? "MCP · Skills"
                            : root.active-page == 5 ? "配置与恢复" : "偏好设置";
                        color: Theme.primary-text;
                        font-size: 28px;
                        font-weight: 700;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                QuietButton {
                    width: 80px;
                    horizontal-stretch: 0;
                    text: Theme.dark ? "浅色" : "深色";
                    clicked => {
                        Theme.dark = !Theme.dark;
                        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
                    }
                }
                QuietButton { width: 104px; horizontal-stretch: 0; text: "状态详情"; clicked => { root.drawer-open = true; } }
            }
            Text {
                text: root.active-page == 0 ? "一个 Codex，自由连接你信任的每一个模型。" : "这里显示 SwitchX 本地保存的状态。";
                color: Theme.muted-text;
                font-size: 14px;
            }
            if root.error-code != "" : SurfaceCard {
                height: 74px;
                border-color: Theme.error;
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    Text { text: root.error-message + " · " + root.error-code; color: Theme.error; font-size: 14px; font-weight: 600; }
                    Text { text: root.error-action; color: Theme.muted-text; font-size: 12px; }
                }
            }

            if root.active-page == 0 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 20px;
                    SurfaceCard {
                        height: 248px;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 18px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "连接控制台"; color: Theme.primary-text; font-size: 17px; font-weight: 600; }
                                StatusPill { label: "未启用"; ink: Theme.warning; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "本地只读"; color: Theme.muted-text; font-size: 12px; }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                SurfaceCard {
                                    width: 176px;
                                    height: 94px;
                                    background: Theme.raised;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 5px;
                                        Text { text: "Codex"; color: Theme.primary-text; font-size: 15px; font-weight: 600; }
                                        Text { text: "本应用未检查配置"; color: Theme.muted-text; font-size: 12px; }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; horizontal-stretch: 1; }
                                SurfaceCard {
                                    width: 176px;
                                    height: 94px;
                                    background: Theme.brand-surface;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 5px;
                                        Text { text: "SwitchX Router"; color: Theme.primary-text; font-size: 15px; font-weight: 600; }
                                        Text { text: "尚未启动"; color: Theme.muted-text; font-size: 12px; }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; horizontal-stretch: 1; }
                                SurfaceCard {
                                    width: 176px;
                                    height: 94px;
                                    background: Theme.raised;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 5px;
                                        Text { text: "上游"; color: Theme.primary-text; font-size: 15px; font-weight: 600; }
                                        Text { text: root.providers.length + " 个本地记录"; color: Theme.muted-text; font-size: 12px; }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            Text { text: "SwitchX 未修改 Codex 配置。此窗口不会发送模型请求。"; color: Theme.muted-text; font-size: 12px; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 12px;
                            Text { text: "本地上游资料"; color: Theme.primary-text; font-size: 16px; font-weight: 600; }
                            SurfaceCard {
                                height: 172px;
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    Text {
                                        text: root.loading ? "正在读取…" : root.error-code != "" ? "读取失败" : root.providers.length == 0 ? "还没有上游记录" : root.providers.length + " 个上游记录";
                                        color: Theme.primary-text;
                                        font-size: 17px;
                                        font-weight: 600;
                                    }
                                    Text { text: "添加上游后，这里会显示真实连接。"; color: Theme.muted-text; font-size: 13px; wrap: word-wrap; }
                                    QuietButton { text: "查看上游"; clicked => { root.active-page = 1; } }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 12px;
                            Text { text: "Codex 模型菜单"; color: Theme.primary-text; font-size: 16px; font-weight: 600; }
                            SurfaceCard {
                                height: 172px;
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    Text { text: "未发布目录"; color: Theme.primary-text; font-size: 17px; font-weight: 600; }
                                    Text { text: "此客户端尚未发布模型目录。"; color: Theme.muted-text; font-size: 13px; wrap: word-wrap; }
                                    QuietButton { text: "查看路由"; clicked => { root.active-page = 2; } }
                                }
                            }
                        }
                    }
                    SurfaceCard {
                        height: 92px;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            Text { text: "本地状态"; color: Theme.primary-text; font-size: 15px; font-weight: 600; }
                            Text { text: root.status-text; color: Theme.muted-text; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                }
            }

            if root.active-page == 1 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        Text { text: "已保存的上游元数据"; color: Theme.primary-text; font-size: 16px; font-weight: 600; }
                        Rectangle { horizontal-stretch: 1; }
                        QuietButton { width: 106px; text: "检查凭据"; clicked => { root.refresh(true); } }
                        QuietButton { width: 70px; text: "刷新"; clicked => { root.refresh(false); } }
                    }
                    Text { height: 28px; text: "此页只读。凭据值不会进入界面；检查操作只返回可读取性。"; color: Theme.muted-text; font-size: 13px; }
                    if !root.loading && root.error-code == "" && root.providers.length == 0 : SurfaceCard {
                        height: 140px;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 10px;
                            Text { text: "还没有上游"; color: Theme.primary-text; font-size: 18px; font-weight: 600; }
                            Text { text: "添加、编辑与连接验证暂不可用。"; color: Theme.muted-text; font-size: 13px; }
                        }
                    }
                    for provider in root.providers : SurfaceCard {
                        height: 100px;
                        HorizontalLayout {
                            padding: 20px;
                            spacing: 20px;
                            VerticalLayout {
                                spacing: 7px;
                                Text { text: provider.name; color: Theme.primary-text; font-size: 16px; font-weight: 600; }
                                Text { text: provider.endpoint; color: Theme.muted-text; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: provider.credential-status; color: Theme.muted-text; font-size: 12px; }
                        }
                    }
                }
            }

            if root.active-page >= 2 && root.active-page <= 5 : SurfaceCard {
                height: 200px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: root.active-page == 2 ? "目录与路由尚未启用" : root.active-page == 3 ? "还没有请求记录" : root.active-page == 4 ? "MCP 与 Skills 尚未接入" : "尚未管理 Codex 配置";
                        color: Theme.primary-text;
                        font-size: 19px;
                        font-weight: 600;
                    }
                    Text {
                        text: root.active-page == 2 ? "模型目录与路由尚未对当前客户端启用。" : root.active-page == 3 ? "界面未启动路由，因此不会出现真实请求。" : root.active-page == 4 ? "不会自动导入或执行外部命令。" : "当前只能查看状态，尚未启用配置切换。";
                        color: Theme.muted-text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }

            if root.active-page == 6 : SurfaceCard {
                height: 210px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;
                    Text { text: "外观"; color: Theme.primary-text; font-size: 18px; font-weight: 600; }
                    Text { text: "当前主题仅保存在本次运行中。界面没有持续动画。"; color: Theme.muted-text; font-size: 13px; }
                    QuietButton {
                        text: Theme.dark ? "切换到浅色" : "切换到深色";
                        clicked => {
                            Theme.dark = !Theme.dark;
                            Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
                        }
                    }
                }
            }
        }
    }

    if root.drawer-open : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000070;
        TouchArea { clicked => { root.drawer-open = false; } }
    }
    if root.drawer-open : Rectangle {
        x: root.width - 400px; y: 0px; width: 400px; height: root.height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            Text { text: "连接状态"; color: Theme.primary-text; font-size: 22px; font-weight: 700; }
            StatusPill { label: "未启用路由"; ink: Theme.warning; }
            Text { text: root.status-text; color: Theme.primary-text; font-size: 14px; wrap: word-wrap; }
            Text { text: "本地数据目录"; color: Theme.muted-text; font-size: 12px; }
            Text { text: root.data-path; color: Theme.primary-text; font-size: 12px; wrap: word-wrap; }
            if root.error-code != "" : Text { text: root.error-message + " · " + root.error-action; color: Theme.error; font-size: 13px; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            QuietButton { text: "关闭"; clicked => { root.drawer-open = false; } }
        }
    }
}

export component SwitchXTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.svg");
    tooltip: "switchx";
    callback show-app();
    callback quit-app();
    Menu {
        MenuItem { title: "打开 switchx"; activated => { root.show-app(); } }
        MenuItem { title: "退出"; activated => { root.quit-app(); } }
    }
}
