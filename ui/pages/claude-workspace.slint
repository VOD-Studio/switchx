import { QuietScrollView } from "../scroll-view.slint";
import {
    QuietButton,
    QuietLineEdit,
    QuietSegmented,
    QuietComboBox,
    SurfaceCard,
    StatusPill,
} from "../components.slint";
import { ClaudeUi } from "../claude-state.slint";
import { Theme } from "../tokens.slint";

export component ClaudeWorkspacePage inherits VerticalLayout {
    in property <bool> busy;
    in-out property <string> home;
    in-out property <string> status;
    in-out property <string> workspace-id;
    callback inspect(string);
    spacing: 15px;
    HorizontalLayout {
        spacing: 12px;
        QuietSegmented {
            width: 304px;
            options: ["连接", "模型", "配置", "路由"];
            current-index: ClaudeUi.page;
            selected(index) => { ClaudeUi.page = index; }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        QuietButton {
            text: "刷新";
            ghost: true;
            width: 72px;
            enabled: !root.busy;
            clicked => { ClaudeUi.refresh(); }
        }

        QuietButton {
            text: "添加连接";
            icon: @image-url("../../assets/ui/plus.svg");
            icon-color: Theme.on-brand;
            primary: true;
            width: 120px;
            enabled: !root.busy && ClaudeUi.loaded;
            accessible-label: "添加 Claude 连接";
            clicked => { ClaudeUi.edit("", 0); }
        }
    }

    SurfaceCard {
        height: 76px;
        HorizontalLayout {
            padding: 16px;
            spacing: 14px;
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: ClaudeUi.route-running ? (ClaudeUi.active-mode == "aggregate" ? "模型聚合运行中" : "模型路由运行中") : ClaudeUi.managed ? ClaudeUi.active-name : "使用原有配置";
                    color: Theme.primary-text;
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: ClaudeUi.route-running ? ClaudeUi.route-endpoint : root.status;
                    color: Theme.muted-text;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            StatusPill {
                label: ClaudeUi.recovering ? "待恢复" : ClaudeUi.route-running ? "运行中" : ClaudeUi.managed ? "配置已写入" : "未接管";
                ink: ClaudeUi.recovering ? Theme.warning : ClaudeUi.route-running ? Theme.success : Theme.muted-text;
                fill: ClaudeUi.recovering ? Theme.warning-surface : ClaudeUi.route-running ? Theme.brand-surface : Theme.raised;
            }

            if ClaudeUi.managed: QuietButton {
                text: ClaudeUi.route-running ? "停止并恢复" : "恢复";
                width: ClaudeUi.route-running ? 112px : 70px;
                enabled: !root.busy;
                accessible-label: "预览恢复 Claude 配置";
                clicked => { ClaudeUi.preview-recovery(false); }
            }
        }
    }

    if ClaudeUi.config-error != "": Text {
        text: ClaudeUi.config-error;
        color: Theme.error;
        font-size: 12px;
        wrap: word-wrap;
    }
    if ClaudeUi.page == 0: QuietScrollView {
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            spacing: 12px;
            padding-bottom: 12px;
            HorizontalLayout {
                spacing: 10px;
                QuietLineEdit {
                    text <=> ClaudeUi.query;
                    placeholder-text: "搜索 Claude 连接";
                    accessible-label: "搜索 Claude 连接";
                    icon: @image-url("../../assets/ui/search.svg");
                    width: 220px;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                QuietButton {
                    text: "导入当前配置";
                    ghost: true;
                    width: 114px;
                    enabled: !root.busy && ClaudeUi.loaded && !ClaudeUi.managed;
                    clicked => { ClaudeUi.import-current(); }
                }

                QuietButton {
                    text: "官方登录";
                    ghost: true;
                    width: 92px;
                    enabled: !root.busy && ClaudeUi.loaded;
                    clicked => { ClaudeUi.new-native(); }
                }
            }

            if !ClaudeUi.loaded || ClaudeUi.connections.length == 0: SurfaceCard {
                height: 156px;
                VerticalLayout {
                    padding: 26px;
                    spacing: 12px;
                    Text {
                        text: ClaudeUi.loaded ? "从一个连接开始。" : "正在读取 Claude 工作空间…";
                        color: Theme.primary-text;
                        font-size: 22px;
                        font-weight: 500;
                    }

                    Text {
                        text: "添加 Anthropic 兼容 API 或使用本机官方登录，再选择要显示的模型。";
                        color: Theme.muted-text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
            for connection[index] in ClaudeUi.connections: SurfaceCard {
                visible: ClaudeUi.matches-query(connection.name, ClaudeUi.query);
                height: 104px;
                border-color: connection.id == ClaudeUi.active-id && ClaudeUi.managed ? Theme.brand : Theme.border;
                HorizontalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Image {
                        width: 25px;
                        height: 25px;
                        source: @image-url("../../assets/providers/icons/claude.svg");
                        colorize: Theme.brand;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text {
                            text: connection.name;
                            color: Theme.primary-text;
                            font-size: 15px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: connection.native ? "登录由 Claude Code 管理" : connection.endpoint;
                            color: Theme.muted-text;
                            font-size: 11px;
                            overflow: elide;
                        }

                        Text {
                            text: connection.authentication + " · " + connection.model-count + " 个菜单模型";
                            color: Theme.muted-text;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }

                    QuietButton {
                        text: "模型";
                        width: 58px;
                        enabled: !root.busy;
                        accessible-label: "查看 Claude 模型 " + connection.name;
                        clicked => { ClaudeUi.selected-connection = index; ClaudeUi.page = 1; }
                    }

                    QuietButton {
                        text: "编辑";
                        width: 58px;
                        enabled: !root.busy && !ClaudeUi.managed;
                        accessible-label: "编辑 Claude 连接 " + connection.name;
                        clicked => { ClaudeUi.edit(connection.id, 0); }
                    }

                    QuietButton {
                        text: "预览启用";
                        width: 96px;
                        primary: true;
                        enabled: !root.busy && !ClaudeUi.recovering;
                        accessible-label: "预览 Claude 连接 " + connection.name;
                        clicked => { ClaudeUi.preview(connection.id); }
                    }

                    QuietButton {
                        text: "删除";
                        icon: @image-url("../../assets/ui/trash.svg");
                        icon-only: true;
                        icon-color: Theme.muted-text;
                        width: 32px;
                        ghost: true;
                        enabled: !root.busy && !ClaudeUi.managed;
                        accessible-label: "删除 Claude 连接 " + connection.name;
                        clicked => { ClaudeUi.delete-id = connection.id; ClaudeUi.delete-name = connection.name; ClaudeUi.delete-revision = connection.revision; ClaudeUi.delete-open = true; }
                    }
                }
            }
            if ClaudeUi.managed: Text {
                text: "此工作空间正在托管配置。可预览切换连接；修改或删除已有连接前请先恢复。";
                color: Theme.muted-text;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
    if ClaudeUi.page == 1: QuietScrollView {
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            spacing: 12px;
            padding-bottom: 12px;
            HorizontalLayout {
                spacing: 12px;
                QuietComboBox {
                    model: ClaudeUi.connection-names;
                    current-index <=> ClaudeUi.selected-connection;
                    width: 240px;
                    enabled: ClaudeUi.connections.length > 0;
                    accessible-label: "Claude 模型所属连接";
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                QuietButton {
                    text: "编辑模型列表";
                    width: 132px;
                    enabled: ClaudeUi.connections.length > 0 && !ClaudeUi.managed && !root.busy;
                    clicked => { ClaudeUi.edit(ClaudeUi.connections[ClaudeUi.selected-connection].id, 1); }
                }
            }

            if ClaudeUi.connections.length > 0: Text {
                text: ClaudeUi.connections[ClaudeUi.selected-connection].picker + " · 默认模型：" + (ClaudeUi.connections[ClaudeUi.selected-connection].default-model == "" ? "客户端默认" : ClaudeUi.connections[ClaudeUi.selected-connection].default-model);
                color: Theme.muted-text;
                font-size: 12px;
                wrap: word-wrap;
            }
            for model in ClaudeUi.connections[ClaudeUi.selected-connection].models: SurfaceCard {
                height: model.description == "" ? 76px : 94px;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 14px;
                    VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: model.label == "" ? model.model : model.label;
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.primary-text;
                            overflow: elide;
                        }

                        Text {
                            text: model.model;
                            color: Theme.muted-text;
                            font-size: 11px;
                            overflow: elide;
                        }

                        if model.description != "": Text {
                            text: model.description;
                            color: Theme.muted-text;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    StatusPill {
                        label: !model.enabled ? "不发布" : model.model == ClaudeUi.connections[ClaudeUi.selected-connection].default-model ? "默认模型" : "菜单模型";
                    }
                }
            }
            if ClaudeUi.connections.length == 0: Text {
                text: "先添加或导入一个连接，再编辑模型列表。";
                color: Theme.muted-text;
                font-size: 13px;
            }
        }
    }
    if ClaudeUi.page == 2: QuietScrollView {
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            spacing: 16px;
            SurfaceCard {
                height: 202px;
                VerticalLayout {
                    padding: 22px;
                    spacing: 13px;
                    Text {
                        text: "配置目录";
                        color: Theme.primary-text;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    QuietLineEdit {
                        text <=> root.home;
                        edited => {
                            root.workspace-id = "";
                            root.status = "目录已变化，请读取工作空间";
                            ClaudeUi.active-mode = "none";
                            ClaudeUi.managed = false;
                            ClaudeUi.recovering = false;
                            ClaudeUi.route-running = false;
                            ClaudeUi.route-endpoint = "";
                            ClaudeUi.route-models = [];
                            ClaudeUi.route-provider-ids = [];
                            ClaudeUi.route-provider-names = [];
                            ClaudeUi.recent-requests = [];
                            ClaudeUi.active-id = "";
                            ClaudeUi.active-name = "";
                            ClaudeUi.loaded = false;
                            ClaudeUi.connections = [];
                            ClaudeUi.connection-names = [];
                            ClaudeUi.preview-ready = false;
                            ClaudeUi.cli-check-id = "";
                            ClaudeUi.cli-checking = false;
                            ClaudeUi.cli-version = "";
                            ClaudeUi.cli-message = "读取工作空间后检查 CLI";
                            ClaudeUi.supports-menu = false;
                            ClaudeUi.supports-behaves-as = false;
                            ClaudeUi.feedback = "";
                        }
                        accessible-label: "Claude Code 配置目录绝对路径";
                        icon: @image-url("../../assets/ui/folder.svg");
                        enabled: !root.busy;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        QuietButton {
                            text: "读取工作空间";
                            width: 132px;
                            enabled: !root.busy;
                            clicked => { root.inspect(root.home); }
                        }

                        Text {
                            text: "用户级 settings.json；MCP 和官方登录文件由各自流程管理。";
                            color: Theme.muted-text;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            SurfaceCard {
                height: 208px;
                VerticalLayout {
                    padding: 22px;
                    spacing: 13px;
                    Text {
                        text: "Claude Code CLI";
                        color: Theme.primary-text;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    QuietLineEdit {
                        text <=> ClaudeUi.cli-setting;
                        placeholder-text: "程序绝对路径，留空自动检测";
                        accessible-label: "Claude CLI 程序路径";
                        enabled: !root.busy;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        QuietButton {
                            text: ClaudeUi.cli-checking ? "检查中…" : "保存并检查";
                            width: 132px;
                            enabled: !root.busy && !ClaudeUi.cli-checking;
                            clicked => { ClaudeUi.check-cli(); }
                        }

                        Text {
                            text: ClaudeUi.cli-message;
                            color: Theme.muted-text;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
    if ClaudeUi.page == 3: QuietScrollView {
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            spacing: 14px;
            padding-bottom: 12px;
            SurfaceCard {
                height: 202px;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        QuietSegmented {
                            width: 250px;
                            options: ["单连接路由", "多连接聚合"];
                            current-index: ClaudeUi.route-mode;
                            selected(index) => { ClaudeUi.route-mode = index; ClaudeUi.refresh-route-models(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        QuietButton {
                            text: ClaudeUi.route-running ? "预览更新" : "预览发布";
                            primary: true;
                            width: 116px;
                            enabled: !root.busy && ClaudeUi.loaded && !ClaudeUi.recovering && ClaudeUi.route-provider-ids.length > 0;
                            accessible-label: "预览 Claude 模型路由";
                            clicked => { ClaudeUi.preview-routing(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "默认连接";
                                color: Theme.muted-text;
                                font-size: 11px;
                            }

                            QuietComboBox {
                                model: ClaudeUi.route-provider-names;
                                current-index <=> ClaudeUi.route-primary;
                                enabled: !root.busy && ClaudeUi.route-provider-ids.length > 0;
                                accessible-label: "Claude 路由默认连接";
                                selected(_) => { ClaudeUi.route-default = ""; ClaudeUi.refresh-route-models(); }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "默认模型 ID";
                                color: Theme.muted-text;
                                font-size: 11px;
                            }

                            QuietLineEdit {
                                text <=> ClaudeUi.route-default;
                                placeholder-text: "留空沿用默认连接的模型";
                                accessible-label: "Claude 路由默认模型";
                                enabled: !root.busy;
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            width: 105px;
                            Text {
                                text: "本地端口";
                                color: Theme.muted-text;
                                font-size: 11px;
                            }

                            QuietLineEdit {
                                text <=> ClaudeUi.route-port;
                                placeholder-text: "0 自动分配";
                                accessible-label: "Claude 路由端口";
                                enabled: !root.busy && !ClaudeUi.route-running;
                            }
                        }
                    }

                    Text {
                        text: ClaudeUi.route-mode == 1 ? "发布所有 API 连接勾选的模型；同名模型按各自绑定分发。默认连接承接明确的默认与角色请求。" : "发布默认连接的模型与角色映射，通过本地端点访问此连接。";
                        color: Theme.muted-text;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }

            if ClaudeUi.route-error != "": Text {
                text: ClaudeUi.route-error;
                color: Theme.warning;
                font-size: 12px;
                wrap: word-wrap;
            }
            if ClaudeUi.route-recording-failed: Text {
                text: "请求记录写入失败，请检查资料目录；路由仍在转发。";
                color: Theme.warning;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                Text {
                    text: "模型去向 · " + ClaudeUi.route-models.length;
                    color: Theme.primary-text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }

                QuietButton {
                    text: "刷新列表";
                    ghost: true;
                    width: 90px;
                    enabled: !root.busy;
                    clicked => { ClaudeUi.refresh-route-models(); }
                }
            }

            for model in ClaudeUi.route-models: SurfaceCard {
                height: 90px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text {
                        text: model.label;
                        color: Theme.primary-text;
                        font-size: 13px;
                        font-weight: 500;
                        overflow: elide;
                    }

                    Text {
                        text: "实际模型 · " + model.upstream;
                        color: Theme.muted-text;
                        font-size: 10px;
                        overflow: elide;
                    }

                    Text {
                        text: model.menu ? "发布到菜单" : "默认或角色绑定";
                        color: Theme.muted-text;
                        font-size: 10px;
                    }
                }
            }
            Text {
                text: "最近 Claude 请求";
                color: Theme.primary-text;
                font-size: 14px;
                font-weight: 600;
            }

            if ClaudeUi.recent-requests.length == 0: Text {
                text: "尚无此工作空间的路由记录。";
                color: Theme.muted-text;
                font-size: 12px;
            }
            for row in ClaudeUi.recent-requests: Text {
                text: row;
                color: Theme.muted-text;
                font-size: 12px;
                wrap: word-wrap;
            }
            Text {
                text: "路由运行期间保持 SwitchX 开启；仅支持原生 Messages 上游。本机官方登录继续使用直连。";
                color: Theme.muted-text;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
    if ClaudeUi.feedback != "": Text {
        text: ClaudeUi.feedback;
        color: Theme.muted-text;
        font-size: 12px;
        wrap: word-wrap;
    }
}
