import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens.slint";
import {
    QuietButton,
    QuietCheckBox,
    QuietComboBox,
    StatusPill,
} from "../components.slint";
import { ProviderRow, ModelRow } from "../view-models.slint";

// Daily workbench: the model menu stays visible while edits and publication
// previews are handled by the window's shared drawers.
export component RoutingPage inherits Rectangle {
    in property <bool> busy;
    in property <bool> loading;
    in property <[ProviderRow]> providers;
    in property <[ModelRow]> models;
    in property <int> selected-model-count;
    in property <bool> config-managed;
    in property <bool> route-managed;
    in property <bool> route-running;
    in property <bool> direct-active;
    in property <bool> chatgpt-login-pending;
    in property <string> route-status;
    in property <string> config-home;
    in-out property <string> default-model;
    in property <[string]> model-provider-options;
    in-out property <int> model-provider-choice;
    in-out property <length> model-scroll-y;
    property <bool> selected-only: false;
    callback add-selected-model();
    callback begin-model-editor(string, string);
    callback select-model(string, bool);
    callback edit-fallback(string);
    callback inspect-route();
    callback launch-codex();
    callback show-direct();
    callback restore-config(string);
    callback navigate(int);
    vertical-stretch: 1;
    VerticalLayout {
        spacing: 18px;
        Rectangle {
            height: 50px;
            border-radius: 9px;
            background: Theme.brand-surface;
            animate background { duration: Theme.page-motion; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 17px;
                    height: 17px;
                    source: @image-url("../../assets/ui/code.svg");
                    colorize: Theme.brand;
                }

                Text {
                    text: "Codex";
                    color: Theme.primary-text;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 1px;
                    background: Theme.brand.with-alpha(0.3);
                }

                Image {
                    y: (parent.height - self.height) / 2;
                    width: 19px;
                    height: 19px;
                    source: @image-url("../../assets/ui/brand.svg");
                    colorize: Theme.brand;
                }

                Text {
                    text: root.direct-active ? "上游直连" : "SwitchX";
                    color: Theme.primary-text;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 1px;
                    background: Theme.brand.with-alpha(0.3);
                }

                Text {
                    text: root.direct-active ? "单一上游" : root.providers.length + " 个连接";
                    color: Theme.primary-text;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.loading ? "正在读取…" : root.route-running ? "●  本地路由已启用" : root.route-managed ? "●  配置待恢复" : root.direct-active ? "●  直连已启用" : "●  等待启用";
                    color: Theme.brand;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            Text {
                text: root.direct-active ? "模型菜单 · 未发布" : "我的模型";
                color: Theme.primary-text;
                font-size: 17px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: root.models.length;
                color: Theme.muted-text;
                font-size: 12px;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            QuietButton {
                width: 58px;
                text: "全部";
                selected: !root.selected-only;
                ghost: true;
                clicked => { root.selected-only = false; }
            }

            QuietButton {
                width: 58px;
                text: "已选";
                selected: root.selected-only;
                ghost: true;
                clicked => { root.selected-only = true; }
            }

            QuietComboBox {
                width: 155px;
                model: root.model-provider-options;
                current-index <=> root.model-provider-choice;
                accessible-label: "添加模型的连接";
                enabled: !root.busy && !root.config-managed && root.providers.length > 0;
            }

            QuietButton {
                width: 36px;
                text: "添加模型";
                icon-only: true;
                icon: @image-url("../../assets/ui/plus.svg");
                icon-color: Theme.primary-text;
                enabled: !root.busy && !root.config-managed && root.providers.length > 0;
                clicked => { root.add-selected-model(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 140px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 11px;
            background: Theme.panel;
            clip: true;
            animate background, border-color { duration: Theme.page-motion; }
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 36px;
                    background: Theme.background;
                    HorizontalLayout {
                        padding-left: 54px;
                        padding-right: 20px;
                        spacing: 12px;
                        Text {
                            text: "模型 / 公开标识";
                            color: Theme.muted-text;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Text {
                            width: 146px;
                            text: "连接";
                            color: Theme.muted-text;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Text {
                            width: 148px;
                            text: "默认与设置";
                            color: Theme.muted-text;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.models.length == 0: VerticalLayout {
                    padding: 32px;
                    spacing: 14px;
                    alignment: center;
                    Text {
                        text: root.loading ? "正在读取模型…" : "把第一个模型放到手边。";
                        color: Theme.primary-text;
                        font-size: 19px;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "添加连接，再选择要在 Codex 中使用的模型。";
                        color: Theme.muted-text;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        Rectangle { }

                        QuietButton {
                            width: 140px;
                            text: "添加连接";
                            primary: true;
                            clicked => { root.navigate(1); }
                        }

                        Rectangle { }
                    }
                }
                if root.selected-only && root.selected-model-count == 0 && root.models.length > 0: Text {
                    text: "还没有选择模型。切回“全部”开始选择。";
                    color: Theme.muted-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-y <=> root.model-scroll-y;
                    VerticalLayout {
                        spacing: 0px;
                        for model in root.models: Rectangle {
                            height: !root.selected-only || model.included ? 74px : 0px;
                            visible: !root.selected-only || model.included;
                            background: root.default-model == model.public-id ? Theme.brand-surface.with-alpha(0.45) : Theme.panel;
                            animate background { duration: Theme.fast; }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.border;
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                spacing: 10px;
                                QuietCheckBox {
                                    y: (parent.height - self.height) / 2;
                                    width: 28px;
                                    text: "";
                                    accessible-label: "发布 " + model.display-name;
                                    checked: model.included;
                                    enabled: model.ready && !root.busy && !root.config-managed;
                                    toggled => { root.select-model(model.public-id, self.checked); }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    Text {
                                        text: model.display-name;
                                        color: Theme.primary-text;
                                        font-size: 14px;
                                        font-weight: 500;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: model.public-id;
                                        color: Theme.muted-text;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    width: 146px;
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: model.provider-name;
                                        color: Theme.primary-text;
                                        font-size: 12px;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: model.ready ? (model.is-subscription ? "订阅账号" : "Responses API") : "待完善模型资料";
                                        color: model.ready ? Theme.muted-text : Theme.warning;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }

                                QuietButton {
                                    y: (parent.height - self.height) / 2;
                                    width: 66px;
                                    text: root.default-model == model.public-id ? "✓ 默认" : "设默认";
                                    selected: root.default-model == model.public-id;
                                    ghost: true;
                                    enabled: model.included && !root.busy && !root.config-managed;
                                    clicked => { root.default-model = model.public-id; }
                                }

                                QuietButton {
                                    y: (parent.height - self.height) / 2;
                                    width: 36px;
                                    text: "编辑 " + model.display-name;
                                    icon-only: true;
                                    ghost: true;
                                    icon: @image-url("../../assets/ui/settings.svg");
                                    icon-color: Theme.muted-text;
                                    enabled: !root.busy && !root.config-managed;
                                    clicked => { root.begin-model-editor(model.provider-id, model.saved ? model.public-id : ""); }
                                }

                                QuietButton {
                                    y: (parent.height - self.height) / 2;
                                    width: 36px;
                                    text: "备用上游 · " + model.display-name;
                                    icon-only: true;
                                    ghost: true;
                                    icon: @image-url("../../assets/ui/connections.svg");
                                    icon-color: model.fallback-provider-id == "" ? Theme.muted-text : Theme.brand;
                                    enabled: model.ready && !root.busy && !root.config-managed && !model.is-subscription;
                                    clicked => { root.edit-fallback(model.public-id); }
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: root.config-managed ? (root.route-running ? "路由已启用" : root.direct-active ? "直连已启用" : "配置正在管理中") : "已选 " + root.selected-model-count + " 个模型";
                    color: Theme.primary-text;
                    font-size: 13px;
                    font-weight: 500;
                }

                Text {
                    text: root.config-managed ? (root.direct-active ? "当前使用单一上游；恢复后可发布模型菜单。" : "恢复后可编辑模型与连接。") : "默认 · " + (root.default-model == "" ? "尚未选择" : root.default-model) + "，在新会话生效。";
                    color: Theme.muted-text;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            if root.config-managed: QuietButton {
                width: 112px;
                text: "恢复并停止";
                ghost: true;
                enabled: !root.busy;
                clicked => { root.restore-config(root.config-home); }
            }
            QuietButton {
                width: 154px;
                text: root.busy ? "正在处理…" : root.route-running ? "启动 Codex" : root.direct-active ? "查看直连配置" : "预览并启用";
                icon: @image-url("../../assets/ui/arrow.svg");
                icon-color: Theme.on-brand;
                primary: true;
                enabled: !root.busy && (root.route-running || root.direct-active || (!root.config-managed && !root.chatgpt-login-pending && root.selected-model-count > 0));
                clicked => { if (root.route-running) { root.launch-codex(); } else if (root.direct-active) { root.show-direct(); } else { root.inspect-route(); } }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            Image {
                y: (parent.height - self.height) / 2;
                width: 15px;
                height: 15px;
                source: @image-url("../../assets/ui/folder.svg");
                colorize: Theme.muted-text;
            }

            Text {
                text: root.config-home;
                color: Theme.muted-text;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }

            QuietButton {
                width: 126px;
                text: "配置与恢复  ↗";
                ghost: true;
                height: 28px;
                clicked => { root.navigate(5); }
            }
        }
    }
}
