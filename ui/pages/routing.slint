import { QuietScrollView as ScrollView } from "../scroll-view.slint";
import { Theme } from "../tokens.slint";
import {
    QuietButton,
    QuietCheckBox,
    QuietComboBox,
    StatusPill,
} from "../components.slint";
import { WorkbenchConnection } from "workbench-connection.slint";
import { ProviderRow, ModelRow } from "../view-models.slint";

// Daily workbench: the model menu stays visible while edits and publication
// previews are handled by the window's shared drawers.
export component RoutingPage inherits Rectangle {
    in property <bool> busy;
    in property <bool> loading;
    in property <[ProviderRow]> providers;
    in property <[ModelRow]> models;
    in property <int> selected-model-count;
    in property <int> selected-connection-count;
    in property <string> default-model-label;
    in property <int> selectable-model-count;
    in property <bool> config-managed;
    in property <bool> route-managed;
    in property <bool> route-running;
    in property <bool> direct-active;
    in property <bool> chatgpt-login-pending;
    in property <string> route-status;
    in property <string> config-home;
    in-out property <string> default-model;
    in property <[string]> model-provider-options;
    in-out property <int> model-provider-choice;
    in-out property <length> model-scroll-y;
    property <bool> selected-only: false;
    property <bool> direct-mode: false;
    callback select-connection(string, bool);
    callback connection-models(string);
    callback preview-direct(string);
    callback add-connection();
    callback add-selected-model();
    callback begin-model-editor(string, string);
    callback select-model(string, bool);
    callback select-models(bool, bool);
    callback edit-fallback(string);
    callback inspect-route();
    callback launch-codex();
    callback show-direct();
    callback restore-config(string);
    callback switch-api-preview();
    callback navigate(int);
    vertical-stretch: 1;
    VerticalLayout {
        spacing: 18px;
        Rectangle {
            height: 50px;
            border-radius: 9px;
            background: Theme.brand-surface;
            animate background { duration: Theme.page-motion; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 17px;
                    height: 17px;
                    source: @image-url("../../assets/ui/code.svg");
                    colorize: Theme.brand;
                }

                Text {
                    text: "Codex";
                    color: Theme.primary-text;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 1px;
                    background: Theme.brand.with-alpha(0.3);
                }

                Image {
                    y: (parent.height - self.height) / 2;
                    width: 19px;
                    height: 19px;
                    source: @image-url("../../assets/ui/brand.svg");
                    colorize: Theme.brand;
                }

                Text {
                    text: root.direct-active ? "上游直连" : "SwitchX";
                    color: Theme.primary-text;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 1px;
                    background: Theme.brand.with-alpha(0.3);
                }

                Text {
                    text: root.direct-active ? "单一上游" : root.selected-connection-count + " 个连接已加入";
                    color: Theme.primary-text;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.loading ? "正在读取…" : root.route-running ? "●  本地路由已启用" : root.route-managed ? "●  配置待恢复" : root.direct-active ? "●  直连已启用" : "●  等待启用";
                    color: Theme.brand;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            Text {
                text: "我的连接";
                color: Theme.primary-text;
                font-size: 17px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: root.providers.length;
                color: Theme.muted-text;
                font-size: 12px;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 150px;
                height: 36px;
                background: Theme.inset;
                border-radius: 9px;
                Rectangle {
                    x: root.direct-mode ? 77px : 3px;
                    y: 3px;
                    width: 70px;
                    height: 30px;
                    border-radius: 7px;
                    background: Theme.brand-surface;
                    animate x {
                        duration: Theme.drawer-motion;
                        easing: cubic-bezier(0.22, 1, 0.36, 1);
                    }
                }

                HorizontalLayout {
                    spacing: 0px;
                    QuietButton {
                        text: "聚合";
                        ghost: true;
                        clicked => { root.direct-mode = false; }
                    }

                    QuietButton {
                        text: "直连";
                        ghost: true;
                        clicked => { root.direct-mode = true; }
                    }
                }
            }

            QuietButton {
                width: 58px;
                text: "全部";
                ghost: true;
                selected: !root.selected-only;
                clicked => { root.selected-only = false; }
            }

            QuietButton {
                width: 76px;
                text: "已加入";
                ghost: true;
                selected: root.selected-only;
                clicked => { root.selected-only = true; }
            }

            QuietButton {
                width: 116px;
                text: "添加连接";
                primary: true;
                icon: @image-url("../../assets/ui/plus.svg");
                icon-color: Theme.on-brand;
                enabled: !root.busy && !root.config-managed;
                clicked => { root.add-connection(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 140px;
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    height: 36px;
                    spacing: 10px;
                    QuietCheckBox {
                        width: 110px;
                        y: (parent.height - self.height) / 2;
                        text: "全部加入";
                        accessible-label: self.checked ? "移出全部可发布模型" : "加入全部可发布模型";
                        auto-toggle: false;
                        checked: root.selected-model-count > 0 && (root.selected-only || root.selected-model-count == root.selectable-model-count);
                        indeterminate: !root.selected-only && root.selected-model-count > 0 && root.selected-model-count < root.selectable-model-count;
                        enabled: !root.direct-mode && !root.busy && !root.loading && !root.config-managed && (root.selected-only ? root.selected-model-count : root.selectable-model-count) > 0;
                        toggled => { root.select-models(!self.checked, root.selected-only); }
                    }

                    Text {
                        text: root.direct-mode ? "选择一个 API 连接，预览后启用直连。" : "加入连接即可使用整组模型，展开后可以单独调整。";
                        color: Theme.muted-text;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    content-y <=> root.model-scroll-y;
                    VerticalLayout {
                        spacing: 12px;
                        if root.providers.length == 0: Rectangle {
                            height: 200px;
                            background: Theme.panel;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 12px;
                            VerticalLayout {
                                padding: 24px;
                                spacing: 12px;
                                alignment: center;
                                Text {
                                    text: root.loading ? "正在读取连接…" : "从一个连接开始。";
                                    color: Theme.primary-text;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "在连接中准备模型，再整组加入工作台。";
                                    color: Theme.muted-text;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }

                                HorizontalLayout {
                                    Rectangle { }

                                    QuietButton {
                                        width: 140px;
                                        text: "添加连接";
                                        primary: true;
                                        enabled: !root.loading && !root.busy && !root.config-managed;
                                        clicked => { root.add-connection(); }
                                    }

                                    Rectangle { }
                                }
                            }
                        }
                        if root.selected-only && root.selected-model-count == 0 && root.providers.length > 0: Rectangle {
                            height: 140px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                Text {
                                    text: "还没有加入连接";
                                    color: Theme.primary-text;
                                    font-size: 18px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "切回“全部”，选择一个准备好的连接。";
                                    color: Theme.muted-text;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        for provider[index] in root.providers: Rectangle {
                            property <float> shown: !root.selected-only || provider.selected-model-count > 0 ? 1 : 0;
                            animate shown {
                                duration: Theme.page-motion;
                                easing: ease-out;
                            }
                            height: card.height * self.shown;
                            visible: self.shown > 0;
                            opacity: self.shown;
                            clip: true;
                            card := WorkbenchConnection {
                                provider: provider;
                                order: index;
                                busy: root.busy;
                                managed: root.config-managed;
                                direct-mode: root.direct-mode;
                                default-model <=> root.default-model;
                                select(selected) => { root.select-connection(provider.id, selected); }
                                select-model(id, selected) => { root.select-model(id, selected); }
                                models => { root.connection-models(provider.id); }
                                edit-model(id) => { root.begin-model-editor(provider.id, id); }
                                fallback(id) => { root.edit-fallback(id); }
                                direct => { root.preview-direct(provider.id); }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: root.config-managed ? (root.route-running ? "路由已启用" : root.direct-active ? "直连已启用" : "配置正在管理中") : root.direct-mode ? "直连使用一个 API 连接" : "已选 " + root.selected-model-count + " 个模型";
                    color: Theme.primary-text;
                    font-size: 13px;
                    font-weight: 500;
                }

                Text {
                    text: root.route-running ? "请用“启动 Codex”或 codex --no-daemon 新建会话。" : root.config-managed ? (root.direct-active ? "当前使用单一上游；恢复后可发布模型菜单。" : "恢复后可编辑模型与连接。") : root.direct-mode ? "点击连接卡片的“预览直连”，查看变更后启用。" : "默认 · " + (root.default-model == "" ? "尚未选择" : root.default-model-label) + "，在新会话生效。";
                    color: Theme.muted-text;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            if root.config-managed: QuietButton {
                width: 112px;
                text: "恢复并停止";
                ghost: true;
                enabled: !root.busy;
                clicked => { root.restore-config(root.config-home); }
            }
            QuietButton {
                width: 154px;
                text: root.busy ? "正在处理…" : root.route-running ? "启动 Codex" : root.direct-active ? "查看直连配置" : root.direct-mode ? "选择连接预览直连" : "预览并启用";
                icon: @image-url("../../assets/ui/arrow.svg");
                icon-color: Theme.on-brand;
                primary: true;
                enabled: !root.busy && (root.route-running || root.direct-active || (!root.direct-mode && !root.config-managed && !root.chatgpt-login-pending && root.selected-model-count > 0));
                clicked => { if (root.route-running) { root.launch-codex(); } else if (root.direct-active) { root.show-direct(); } else { root.inspect-route(); } }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            Image {
                y: (parent.height - self.height) / 2;
                width: 15px;
                height: 15px;
                source: @image-url("../../assets/ui/folder.svg");
                colorize: Theme.muted-text;
            }

            Text {
                text: root.config-home;
                color: Theme.muted-text;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }

            QuietButton {
                width: 126px;
                text: "配置与恢复  ↗";
                ghost: true;
                height: 28px;
                clicked => { root.navigate(5); }
            }

            QuietButton {
                width: 132px;
                height: 28px;
                text: "切回 API 预览";
                ghost: true;
                enabled: !root.busy && !root.chatgpt-login-pending;
                clicked => { root.switch-api-preview(); }
            }
        }
    }
}
