import { QuietScrollView as ScrollView } from "../scroll-view.slint";
import { Theme } from "../tokens.slint";
import {
    QuietButton,
    QuietLineEdit,
    SurfaceCard,
    StatusPill,
} from "../components.slint";
import {
    SettingsHeading,
    AppearanceChoice,
    MotionPreference,
} from "settings-controls.slint";

export component ConfigPage inherits ScrollView {
    in property <bool> busy;
    in property <bool> recovery-only;
    in-out property <string> config-home;
    in-out property <string> route-port;
    in property <string> config-status;
    in property <bool> chatgpt-login-pending;
    in property <bool> config-managed;
    callback restore-config(string);
    callback inspect-config(string);
    callback import-current(string);
    callback check-login(string);
    callback open-common-config();
    callback show-direct();
    callback set-appearance(bool);
    private property <bool> recovery-open: root.recovery-only;
    private property <float> recovery-progress: root.recovery-open ? 1 : 0;
    private property <length> recovery-content-height: 74px + recovery-status.preferred-height;
    changed recovery-only => { if root.recovery-only { root.recovery-open = true; } }
    animate recovery-progress {
        duration: Theme.drawer-motion;
        easing: ease-in-out;
    }
    horizontal-scrollbar-policy: always-off;

    VerticalLayout {
        spacing: 16px;
        padding-bottom: 4px;
        SurfaceCard {
            height: 228px;
            border-radius: 16px;
            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                SettingsHeading {
                    icon: @image-url("../../assets/ui/sun.svg");
                    title: "外观与动效";
                    description: "舒服的配色，恰到好处的反馈。";
                    trailing: "即时生效";
                }

                HorizontalLayout {
                    spacing: 16px;
                    AppearanceChoice {
                        selected: !Theme.dark;
                        chosen => { root.set-appearance(false); }
                    }

                    AppearanceChoice {
                        dark: true;
                        selected: Theme.dark;
                        chosen => { root.set-appearance(true); }
                    }

                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                    }

                    MotionPreference {
                        width: (root.width - 54px) * 0.32;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            height: 246px;
            SurfaceCard {
                border-radius: 16px;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    SettingsHeading {
                        icon: @image-url("../../assets/ui/folder.svg");
                        title: "工作空间";
                        description: "选择 SwitchX 管理的 Codex 目录。";
                    }

                    VerticalLayout {
                        spacing: 7px;
                        Text {
                            text: "CODEX HOME";
                            color: Theme.muted-text;
                            font-size: 10px;
                            font-weight: 600;
                            letter-spacing: 1px;
                        }

                        QuietLineEdit {
                            text <=> root.config-home;
                            icon: @image-url("../../assets/ui/folder.svg");
                            accessible-label: "Codex 配置目录绝对路径";
                            enabled: !root.busy && !root.config-managed && !root.chatgpt-login-pending;
                        }

                        Text {
                            text: root.config-managed ? "配置正在托管，恢复后可更换目录。" : root.chatgpt-login-pending ? "登录进行中，完成后可更换目录。" : "配置变更会在新启动的 Codex 会话中生效。";
                            color: Theme.muted-text;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        QuietButton {
                            text: "读取配置";
                            primary: true;
                            enabled: !root.busy && !root.chatgpt-login-pending;
                            clicked => { root.inspect-config(root.config-home); }
                        }

                        QuietButton {
                            text: "导入当前上游";
                            enabled: !root.busy && !root.chatgpt-login-pending;
                            clicked => { root.import-current(root.config-home); }
                        }

                        QuietButton {
                            text: "检查 Codex 登录";
                            enabled: !root.busy && !root.chatgpt-login-pending;
                            clicked => { root.check-login(root.config-home); }
                        }
                    }
                }
            }

            SurfaceCard {
                width: (root.width - 14px) * 0.33;
                border-radius: 16px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    SettingsHeading {
                        icon: @image-url("../../assets/ui/settings.svg");
                        title: "连接偏好";
                        description: "共享设置与本机连接。";
                    }

                    QuietButton {
                        text: "编辑通用配置";
                        icon: @image-url("../../assets/ui/code.svg");
                        icon-color: Theme.muted-text;
                        left-aligned: true;
                        enabled: !root.busy && !root.config-managed;
                        clicked => { root.open-common-config(); }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: "路由端口";
                                color: Theme.primary-text;
                                font-size: 12px;
                            }

                            Text {
                                text: "仅本机访问";
                                color: Theme.muted-text;
                                font-size: 10px;
                            }
                        }

                        QuietLineEdit {
                            width: 80px;
                            text <=> root.route-port;
                            horizontal-alignment: center;
                            accessible-label: "本地路由端口";
                            enabled: !root.busy && !root.config-managed;
                        }
                    }
                }
            }
        }

        SurfaceCard {
            border-radius: 16px;
            border-color: root.recovery-only ? Theme.warning.with-alpha(0.5) : Theme.border;
            height: 100px + root.recovery-progress * root.recovery-content-height;
            VerticalLayout {
                padding: 20px;
                spacing: 0px;
                HorizontalLayout {
                    height: 60px;
                    spacing: 12px;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: root.recovery-only ? Theme.warning-surface : Theme.inset;
                        Image {
                            x: 9px;
                            y: 9px;
                            width: 18px;
                            height: 18px;
                            source: @image-url("../../assets/ui/lock.svg");
                            colorize: root.recovery-only ? Theme.warning : Theme.muted-text;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: "配置与恢复";
                            color: Theme.primary-text;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        Text {
                            text: root.recovery-only ? "配置存在冲突，请先检查再恢复。" : root.config-managed ? "工作空间正在托管，可随时查看和恢复。" : "查看当前配置，或还原 SwitchX 管理的改动。";
                            color: root.recovery-only ? Theme.warning : Theme.muted-text;
                            font-size: 11px;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }

                    StatusPill {
                        width: 72px;
                        label: root.recovery-only ? "需要恢复" : root.config-managed ? "托管中" : "未托管";
                        ink: root.recovery-only ? Theme.warning : root.config-managed ? Theme.brand : Theme.muted-text;
                        fill: root.recovery-only ? Theme.warning-surface : root.config-managed ? Theme.brand-surface : Theme.inset;
                    }

                    QuietButton {
                        width: 32px;
                        text: root.recovery-open ? "收起配置与恢复" : "展开配置与恢复";
                        accessible-expanded: root.recovery-open;
                        icon-only: true;
                        icon: @image-url("../../assets/ui/chevron-down.svg");
                        icon-color: Theme.muted-text;
                        icon-angle: root.recovery-open ? 180deg : 0deg;
                        ghost: true;
                        clicked => { root.recovery-open = !root.recovery-open; }
                    }
                }

                Rectangle {
                    height: root.recovery-progress * root.recovery-content-height;
                    clip: true;
                    VerticalLayout {
                        y: (1 - root.recovery-progress) * -8px;
                        height: root.recovery-content-height;
                        spacing: 12px;
                        opacity: root.recovery-progress;
                        visible: root.recovery-progress > 0;
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        recovery-status := Text {
                            width: root.width - 54px;
                            text: root.config-status == "" ? "尚未读取 Codex 配置。" : root.config-status;
                            color: root.recovery-only ? Theme.warning : Theme.muted-text;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Text {
                                text: "恢复只撤回 SwitchX 管理的改动。";
                                color: Theme.muted-text;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            QuietButton {
                                width: 120px;
                                text: "查看直连配置";
                                enabled: root.recovery-open && !root.busy;
                                clicked => { root.show-direct(); }
                            }

                            QuietButton {
                                width: 110px;
                                text: "恢复原配置";
                                primary: root.config-managed;
                                enabled: root.recovery-open && !root.busy && root.config-managed;
                                clicked => { root.restore-config(root.config-home); }
                            }
                        }
                    }
                }
            }
        }
    }
}
