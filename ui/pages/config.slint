import { QuietScrollView as ScrollView } from "../scroll-view.slint";
import { Theme } from "../tokens.slint";
import {
    QuietButton,
    QuietLineEdit,
    QuietCheckBox,
    SurfaceCard,
} from "../components.slint";

export component ConfigPage inherits ScrollView {
    in property <bool> busy;
    in property <bool> recovery-only;
    in-out property <string> config-home;
    in-out property <string> route-port;
    in property <string> config-status;
    in property <bool> chatgpt-login-pending;
    in property <bool> config-managed;
    callback restore-config(string);
    callback inspect-config(string);
    callback import-current(string);
    callback check-login(string);
    callback open-common-config();
    callback show-direct();
    callback set-appearance(bool);
    VerticalLayout {
        spacing: 22px;
        HorizontalLayout {
            height: 56px;
            spacing: 12px;
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "外观";
                    color: Theme.primary-text;
                    font-size: 15px;
                    font-weight: 500;
                }

                Text {
                    text: "柔和浅色，或安静深色。";
                    color: Theme.muted-text;
                    font-size: 12px;
                }
            }

            QuietButton {
                width: 86px;
                text: "浅色";
                selected: !Theme.dark;
                clicked => { root.set-appearance(false); }
            }

            QuietButton {
                width: 86px;
                text: "深色";
                selected: Theme.dark;
                clicked => { root.set-appearance(true); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 56px;
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "过渡动画";
                    color: Theme.primary-text;
                    font-size: 15px;
                    font-weight: 500;
                }

                Text {
                    text: Theme.system-reduced-motion ? "系统已启用减少动态效果，界面直接响应。" : "短促的操作反馈与自然的页面过渡。";
                    color: Theme.muted-text;
                    font-size: 12px;
                }
            }

            QuietCheckBox {
                text: "启用动画";
                width: 116px;
                checked <=> Theme.animations-enabled;
                enabled: !Theme.system-reduced-motion;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        VerticalLayout {
            spacing: 12px;
            Text {
                text: "Codex 工作空间";
                color: Theme.primary-text;
                font-size: 15px;
                font-weight: 500;
            }

            QuietLineEdit {
                text <=> root.config-home;
                accessible-label: "Codex 配置目录绝对路径";
                enabled: !root.busy && !root.config-managed && !root.chatgpt-login-pending;
            }

            Text {
                text: "只管理此目录的配置；变更在新启动的会话中生效。";
                color: Theme.muted-text;
                font-size: 12px;
            }

            HorizontalLayout {
                spacing: 8px;
                QuietButton {
                    text: "读取配置";
                    enabled: !root.busy && !root.chatgpt-login-pending;
                    clicked => { root.inspect-config(root.config-home); }
                }

                QuietButton {
                    text: "导入当前上游";
                    enabled: !root.busy && !root.chatgpt-login-pending;
                    clicked => { root.import-current(root.config-home); }
                }

                QuietButton {
                    text: "检查 Codex 登录";
                    enabled: !root.busy && !root.chatgpt-login-pending;
                    clicked => { root.check-login(root.config-home); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 60px;
            spacing: 12px;
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "通用配置";
                    color: Theme.primary-text;
                    font-size: 15px;
                    font-weight: 500;
                }

                Text {
                    text: "集中管理连接共享的普通设置。";
                    color: Theme.muted-text;
                    font-size: 12px;
                }
            }

            QuietButton {
                width: 90px;
                text: "编辑  ↗";
                enabled: !root.busy && !root.config-managed;
                clicked => { root.open-common-config(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 56px;
            spacing: 12px;
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "本地路由端口";
                    color: Theme.primary-text;
                    font-size: 15px;
                    font-weight: 500;
                }

                Text {
                    text: "用于 Codex 与 SwitchX 的本机连接。";
                    color: Theme.muted-text;
                    font-size: 12px;
                }
            }

            VerticalLayout {
                width: 110px;
                alignment: center;
                QuietLineEdit {
                    text <=> root.route-port;
                    accessible-label: "本地路由端口";
                    enabled: !root.busy && !root.config-managed;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        VerticalLayout {
            spacing: 12px;
            Text {
                text: "配置与恢复";
                color: Theme.primary-text;
                font-size: 15px;
                font-weight: 500;
            }

            Text {
                text: root.config-status;
                color: root.recovery-only ? Theme.warning : Theme.muted-text;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;
                QuietButton {
                    text: "查看直连配置";
                    enabled: !root.busy;
                    clicked => { root.show-direct(); }
                }

                QuietButton {
                    text: "恢复原配置";
                    primary: root.config-managed;
                    enabled: !root.busy && root.config-managed;
                    clicked => { root.restore-config(root.config-home); }
                }
            }
        }
    }
}
