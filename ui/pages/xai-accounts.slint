import { Theme } from "../tokens.slint";
import { AccountRow } from "../view-models.slint";
import {
    AccountCard,
    AccountEmpty,
    AccountLoginProgress,
    AccountSectionHeader,
} from "account-card.slint";

export component XaiAccounts inherits Rectangle {
    in property <bool> busy;
    in property <bool> config-managed;
    in property <bool> recovery-only;
    in property <bool> pending;
    in property <bool> other-login-pending;
    in property <[AccountRow]> accounts;
    in property <string> error;
    in property <string> user-code;
    in property <string> login-url;
    in-out property <string> expanded-id;
    in property <string> removing-id;
    callback action(int, string);
    callback request-removal(AccountRow);
    height: content.preferred-height;
    preferred-height: root.height;
    vertical-stretch: 0;
    content := VerticalLayout {
        height: self.preferred-height;
        spacing: 12px;
        AccountSectionHeader {
            icon: @image-url("../../assets/providers/icons/xai.svg");
            title: "Grok";
            count: root.accounts.length;
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.warning;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.accounts.length == 0: AccountEmpty {
            text: "尚未添加 Grok 账号。添加后，可在上游连接中绑定。";
        }
        for account[index] in root.accounts: AccountCard {
            order: index;
            expanded: root.expanded-id == account.id;
            removing: root.removing-id == account.id;
            toggle-details(id) => { root.expanded-id = root.expanded-id == id ? "" : id; }
            account: account;
            grok: true;
            busy: root.busy;
            config-managed: root.config-managed;
            recovery-only: root.recovery-only;
            pending: root.pending || root.other-login-pending;
            action(action, id) => { root.action(action, id); }
            request-removal(account) => { root.request-removal(account); }
        }
        AccountLoginProgress {
            title: "完成 Grok 官方授权";
            pending: root.pending;
            busy: root.busy;
            user-code: root.user-code;
            login-url: root.login-url;
            cancel => { root.action(3, ""); }
        }
    }
}
