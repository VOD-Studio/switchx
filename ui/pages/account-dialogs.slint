import { Theme } from "../tokens.slint";
import { QuietButton, StatusPill } from "../components.slint";

// Confirms writing a saved account into the Codex entry login, or a native relogin.
export component AccountLoginConfirm inherits VerticalLayout {
    in property <bool> native;
    in property <bool> open;
    in property <bool> busy;
    // Logins, recovery, and a selected account permit confirming.
    in property <bool> can-confirm;
    callback confirm();
    callback cancel();

    spacing: 16px;
    Text {
        text: "执行时会先恢复受管配置，并停止当前路由。";
        color: Theme.warning;
        font-size: 13px;
        wrap: word-wrap;
    }

    Text {
        text: "各上游的账号绑定保持不变。完成后，请在工作台重新发布，并启动新会话。";
        color: Theme.muted-text;
        font-size: 13px;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 10px;
        QuietButton {
            text: "取消";
            enabled: root.open && !root.busy;
            clicked => { root.cancel(); }
        }

        QuietButton {
            text: root.native ? "继续登录" : "确认写入";
            primary: true;
            enabled: root.open && !root.busy && root.can-confirm;
            clicked => { root.confirm(); }
        }
    }
}

// One consequence of removing an account, revealed after the hero in order.
component RemovalOutcome inherits Rectangle {
    in property <bool> open;
    in property <int> order;
    in property <image> icon;
    in property <color> tone;
    in property <string> title;
    in property <string> detail;
    private property <bool> motion: Theme.animations-enabled && !Theme.system-reduced-motion;
    private property <float> shown: root.open ? 1 : 0;
    animate shown {
        duration: root.motion ? 460ms : 0ms;
        delay: root.motion && root.open ? 160ms + root.order * 70ms : 0ms;
        easing: cubic-bezier(0.22, 1, 0.36, 1);
    }
    height: row.preferred-height;
    opacity: root.shown;
    accessible-role: none;
    row := HorizontalLayout {
        x: (1 - root.shown) * 10px;
        width: parent.width;
        padding: 10px;
        padding-right: 14px;
        spacing: 12px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 30px;
            height: 30px;
            horizontal-stretch: 0;
            border-radius: 9px;
            background: root.tone.with-alpha(0.12);
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 15px;
                height: 15px;
                source: root.icon;
                colorize: root.tone;
            }
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.primary-text;
                font-size: 13px;
                font-weight: 500;
                wrap: word-wrap;
            }

            Text {
                text: root.detail;
                color: Theme.muted-text;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}

// Removes a saved ChatGPT or Grok account once no upstream references it.
// Always mounted inside the shared animated modal, so closing can finish its motion.
export component AccountRemovalConfirm inherits VerticalLayout {
    in property <bool> open;
    in property <bool> grok;
    in property <string> label;
    in property <string> initial;
    // The Codex entry login file belongs to this account and is removed with it.
    in property <bool> codex-linked;
    in property <string> references;
    in property <bool> busy;
    // Settled logins and configuration permit removing.
    in property <bool> can-remove;
    callback remove();
    callback cancel();

    private property <bool> motion: Theme.animations-enabled && !Theme.system-reduced-motion;
    private property <bool> blocked: root.references != "";
    private property <color> tone: root.blocked ? Theme.warning : Theme.error;
    private property <bool> confirmed: false;
    changed open => { if (root.open) { root.confirmed = false; } }
    private property <float> reveal: root.open ? 1 : 0;
    animate reveal {
        duration: root.motion ? 520ms : 0ms;
        easing: cubic-bezier(0.22, 1, 0.36, 1);
    }
    // The link draws in from both tiles once they arrive.
    private property <float> link: root.open ? 1 : 0;
    animate link {
        duration: root.motion ? 640ms : 0ms;
        delay: root.motion && root.open ? 120ms : 0ms;
        easing: cubic-bezier(0.65, 0, 0.35, 1);
    }
    // Hovering the confirm action previews the detachment; confirming completes it as the modal closes.
    // A reopened modal starts attached instead of rejoining on screen.
    private property <float> detach: root.confirmed ? 1 : confirm-button.hovered ? 0.4 : 0;
    animate detach {
        duration: root.motion && (root.confirmed || root.reveal > 0.05) ? 420ms : 0ms;
        easing: cubic-bezier(0.22, 1, 0.36, 1);
    }
    // A slow pulse travels along the intact link.
    private property <float> flow: root.motion && root.open && root.detach < 0.01 ? mod(animation-tick(), 2400ms) / 2400ms : 0;
    spacing: 16px;

    hero := Rectangle {
        property <length> tile: 64px;
        property <length> span: 132px;
        property <length> node: 30px;
        property <length> cx: self.width / 2;
        property <length> cy: 54px;
        property <length> reach: (self.span - self.node) / 2;
        height: 132px;
        border-radius: 14px;
        clip: true;
        background: @linear-gradient(115deg, root.tone.with-alpha(0.08) 0%, Theme.raised.with-alpha(0.55) 100%);
        border-width: 1px;
        border-color: root.tone.with-alpha(0.14);
        accessible-role: none;

        Rectangle {
            x: hero.cx - 100px;
            y: hero.cy - 100px;
            width: 200px;
            height: 200px;
            background: @radial-gradient(circle, root.tone.with-alpha(0.16) 0%, root.tone.with-alpha(0) 70%);
            opacity: root.reveal * (1 - root.detach * 0.7);
        }

        // Each half of the link stays anchored to its tile and retracts toward it.
        Rectangle {
            x: hero.cx - hero.span / 2 - root.detach * 18px;
            y: hero.cy - 1px;
            width: hero.reach * root.link * (1 - root.detach);
            height: 2px;
            border-radius: 1px;
            background: @linear-gradient(90deg, root.tone.with-alpha(0.2) 0%, root.tone.with-alpha(0.55) 100%);
        }

        Rectangle {
            x: hero.cx + hero.span / 2 + root.detach * 18px - self.width;
            y: hero.cy - 1px;
            width: hero.reach * root.link * (1 - root.detach);
            height: 2px;
            border-radius: 1px;
            background: @linear-gradient(90deg, root.tone.with-alpha(0.55) 0%, root.tone.with-alpha(0.2) 100%);
        }

        Rectangle {
            x: hero.cx - hero.span / 2 + root.flow * hero.span - self.width / 2;
            y: hero.cy - self.height / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.tone;
            opacity: root.link * (1 - root.detach) * clamp(min(root.flow, 1 - root.flow) * 6, 0, 1) * 0.8;
        }

        Rectangle {
            x: hero.cx - hero.node / 2;
            y: hero.cy - hero.node / 2;
            width: hero.node;
            height: hero.node;
            border-radius: hero.node / 2;
            background: Theme.panel;
            border-width: 1px;
            border-color: root.tone.with-alpha(0.35);
            opacity: root.link * (1 - root.detach * 0.75);
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: @image-url("../../assets/ui/link.svg");
                colorize: root.tone;
                transform-rotation: (1 - root.link) * 40deg - root.detach * 45deg;
            }
        }

        account-tile := Rectangle {
            x: hero.cx - hero.span / 2 - hero.tile - root.detach * 18px;
            y: hero.cy - hero.tile / 2 + (1 - root.reveal) * 14px;
            width: hero.tile;
            height: hero.tile;
            border-radius: 20px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: root.tone.with-alpha(0.1);
            opacity: root.reveal * (1 - root.detach * 0.35);
            Text {
                text: root.initial == "" ? "?" : root.initial;
                color: Theme.primary-text;
                font-size: 24px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                x: parent.width - 18px;
                y: parent.height - 18px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 13px;
                    height: 13px;
                    source: root.grok ? @image-url("../../assets/providers/icons/xai.svg") : @image-url("../../assets/providers/icons/openai.svg");
                    colorize: Theme.primary-text;
                }
            }
        }

        vault-tile := Rectangle {
            x: hero.cx + hero.span / 2 + root.detach * 18px;
            y: hero.cy - hero.tile / 2 + (1 - root.reveal) * 22px;
            width: hero.tile;
            height: hero.tile;
            border-radius: 20px;
            background: Theme.panel;
            border-width: 1px;
            border-color: root.blocked ? Theme.warning.with-alpha(0.4) : Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: root.tone.with-alpha(0.1);
            opacity: root.reveal;
            if !root.blocked: Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                source: @image-url("../../assets/logo.png");
                image-fit: contain;
            }
            if root.blocked: Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                source: @image-url("../../assets/ui/connections.svg");
                colorize: Theme.warning;
            }
        }

        Text {
            x: account-tile.x - 30px;
            y: hero.cy + hero.tile / 2 + 10px;
            width: hero.tile + 60px;
            text: root.grok ? "Grok 账号" : "ChatGPT 账号";
            color: Theme.muted-text;
            font-size: 11px;
            horizontal-alignment: center;
            opacity: account-tile.opacity;
        }

        Text {
            x: vault-tile.x - 30px;
            y: hero.cy + hero.tile / 2 + 10px;
            width: hero.tile + 60px;
            text: root.blocked ? "上游连接" : "SwitchX";
            color: Theme.muted-text;
            font-size: 11px;
            horizontal-alignment: center;
            opacity: root.reveal;
        }
    }

    HorizontalLayout {
        height: 24px;
        spacing: 8px;
        Text {
            text: root.label;
            color: Theme.primary-text;
            font-size: 15px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            opacity: root.reveal;
        }

        if root.codex-linked && !root.grok: StatusPill {
            y: (parent.height - self.height) / 2;
            width: 98px;
            height: 22px;
            border-radius: 11px;
            label: "Codex 当前登录";
            ink: Theme.warning;
            fill: Theme.warning-surface;
            opacity: root.reveal;
        }
    }

    Rectangle {
        height: outcome-list.preferred-height;
        border-radius: 12px;
        background: Theme.inset;
        border-width: 1px;
        border-color: Theme.border.with-alpha(0.7);
        outcome-list := VerticalLayout {
            padding: 4px;
            if !root.blocked: RemovalOutcome {
                open: root.open;
                order: 0;
                icon: @image-url("../../assets/ui/trash.svg");
                tone: Theme.error;
                title: "清除保存的登录凭据";
                detail: root.grok ? "SwitchX 保存的 Grok 授权与刷新令牌会被删除。" : "SwitchX 保存的 ChatGPT 令牌与账号资料会被删除。";
            }
            if !root.blocked && root.codex-linked && !root.grok: RemovalOutcome {
                open: root.open;
                order: 1;
                icon: @image-url("../../assets/ui/alert.svg");
                tone: Theme.warning;
                title: "同时退出 Codex 本机登录";
                detail: "Codex 登录文件 auth.json 会一并删除，之后需重新登录。";
            }
            if !root.blocked: RemovalOutcome {
                open: root.open;
                order: 2;
                icon: @image-url("../../assets/ui/check.svg");
                tone: Theme.brand;
                title: root.grok ? "xAI 账号本身不受影响" : "ChatGPT 账号本身不受影响";
                detail: "之后可随时重新登录并保存到 SwitchX。";
            }
            if root.blocked: RemovalOutcome {
                open: root.open;
                order: 0;
                icon: @image-url("../../assets/ui/link.svg");
                tone: Theme.warning;
                title: "仍有连接绑定此账号";
                detail: root.references;
            }
            if root.blocked: RemovalOutcome {
                open: root.open;
                order: 1;
                icon: @image-url("../../assets/ui/arrow-right.svg");
                tone: Theme.muted-text;
                title: "先改绑或删除这些连接";
                detail: "在“上游连接”中处理后，即可移除此账号。";
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.border.with-alpha(0.65);
    }

    HorizontalLayout {
        height: 38px;
        spacing: 10px;
        QuietButton {
            text: root.blocked ? "知道了" : "保留账号";
            height: 38px;
            enabled: root.open && !root.busy;
            clicked => { root.cancel(); }
        }

        confirm-button := QuietButton {
            text: "移除账号";
            height: 38px;
            primary: true;
            background: self.hovered ? Theme.error.with-alpha(0.88) : Theme.error;
            border-color: Theme.error;
            loading: root.busy;
            enabled: root.open && !root.busy && !root.confirmed && !root.blocked && root.can-remove;
            clicked => {
                root.confirmed = true;
                root.remove();
            }
        }
    }
}
