import { ListView } from "../scroll-view.slint";
import { Theme } from "../tokens.slint";
import { QuietButton, QuietLineEdit } from "../components.slint";
import { ProviderRow } from "../view-models.slint";

export component ProvidersPage inherits VerticalLayout {
    in property <bool> loading;
    in property <bool> busy;
    in property <bool> recovery-only;
    in property <[ProviderRow]> providers;
    in property <[ProviderRow]> filtered-providers;
    in-out property <string> provider-query;
    in property <bool> chatgpt-login-pending;
    in property <bool> config-managed;
    callback refresh(bool);
    callback filter-providers(string);
    callback add-connection();
    callback begin-provider-editor(string);
    callback begin-subscription-editor(string);
    callback begin-xai-editor(string);
    callback check-provider(string);
    callback preview-direct(string);
    callback begin-model-editor(string, string);
    function check-duration(milliseconds: int) -> string {
        return (round(milliseconds / 100) / 10) + "s";
    }
    spacing: 16px;
    HorizontalLayout {
        height: 36px;
        spacing: 10px;
        QuietLineEdit {
            width: 190px;
            icon: @image-url("../../assets/ui/search.svg");
            placeholder-text: "搜索连接";
            accessible-label: "按名称筛选上游";
            text <=> root.provider-query;
            edited(text) => { root.filter-providers(text); }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        QuietButton {
            width: 96px;
            text: "检查凭据";
            ghost: true;
            enabled: !root.busy;
            clicked => { root.refresh(true); }
        }

        QuietButton {
            width: 72px;
            text: "刷新";
            ghost: true;
            enabled: !root.busy;
            clicked => { root.refresh(false); }
        }

        QuietButton {
            width: 120px;
            text: "+ 添加连接";
            primary: true;
            enabled: !root.busy && !root.config-managed;
            clicked => { root.add-connection(); }
        }
    }

    if root.config-managed: Text {
        text: root.recovery-only ? "先在设置中恢复原配置，再读取连接资料。" : "配置正在管理中。恢复并停止后可修改连接与账号绑定。";
        color: Theme.warning;
        font-size: 12px;
        wrap: word-wrap;
    }
    if !root.loading && root.providers.length == 0: VerticalLayout {
        padding: 36px;
        spacing: 12px;
        Text {
            text: "从一个连接开始。";
            color: Theme.primary-text;
            font-size: 23px;
            font-weight: 500;
            horizontal-alignment: center;
        }

        Text {
            text: "添加 API 连接、ChatGPT 或 Grok 订阅，再把常用模型放进工作台。";
            color: Theme.muted-text;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
    if root.providers.length > 0 && root.filtered-providers.length == 0: Text {
        text: "没有匹配的连接。试试其他名称。";
        color: Theme.muted-text;
        horizontal-alignment: center;
    }
    ListView {
        vertical-stretch: 1;
        for provider in root.filtered-providers: Rectangle {
            height: max(provider.auth-error == "" ? 116px : 144px, info.preferred-height + 48px);
            Rectangle {
                height: parent.height - 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 11px;
                animate background, border-color { duration: Theme.fast; }
                HorizontalLayout {
                    padding: 18px;
                    spacing: 14px;
                    cross-axis-alignment: center;
                    Image {
                        width: provider.icon-id == "xiaomimimo" ? 64px : 32px;
                        height: 32px;
                        source: provider.icon;
                        image-fit: contain;
                        colorize: provider.monochrome ? Theme.primary-text : transparent;
                    }

                    info := VerticalLayout {
                        alignment: center;
                        spacing: 5px;
                        Text {
                            text: provider.name;
                            color: Theme.primary-text;
                            font-size: 16px;
                            font-weight: 500;
                            overflow: elide;
                        }

                        Text {
                            text: provider.is-subscription ? provider.binding-label : provider.endpoint;
                            color: Theme.muted-text;
                            font-size: 12px;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            if provider.check-id != "" || provider.check-message != "": Image {
                                width: 14px;
                                height: 14px;
                                source: provider.check-id != "" ? @image-url("../../assets/ui/loader.svg") : provider.check-failed ? @image-url("../../assets/ui/close.svg") : @image-url("../../assets/ui/check.svg");
                                colorize: provider.check-failed ? Theme.error : Theme.brand;
                                transform-rotation: provider.check-id != "" && Theme.animations-enabled && !Theme.system-reduced-motion ? 360deg * mod(animation-tick(), 1s) / 1s : 0deg;
                            }
                            Text {
                                text: provider.check-id != "" ? "正在" + provider.check-stage + " · " + root.check-duration(provider.check-elapsed-ms) : provider.check-message != "" ? provider.check-message + " · " + root.check-duration(provider.check-elapsed-ms) : provider.credential-status;
                                color: provider.check-failed ? Theme.error : provider.check-id != "" || provider.check-message != "" ? Theme.brand : Theme.muted-text;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }

                        if provider.check-detail != "" || (provider.check-id != "" && provider.check-elapsed-ms >= 10000): Text {
                            text: provider.check-id != "" ? "检查耗时较长，仍在等待响应" : provider.check-detail;
                            color: provider.check-failed ? Theme.error : Theme.muted-text;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        if provider.auth-error != "": Text {
                            text: provider.auth-error;
                            color: Theme.error;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    QuietButton {
                        width: 72px;
                        text: "模型";
                        ghost: true;
                        enabled: !root.busy && !root.config-managed;
                        clicked => { root.begin-model-editor(provider.id, ""); }
                    }

                    QuietButton {
                        width: 80px;
                        text: provider.check-id != "" ? "检查中…" : provider.check-failed ? "重试" : "检查";
                        ghost: true;
                        enabled: !root.busy && provider.check-id == "";
                        clicked => { root.check-provider(provider.id); }
                    }

                    if !provider.is-subscription: QuietButton {
                        width: 64px;
                        text: "直连";
                        ghost: true;
                        enabled: !root.busy && !root.config-managed && !root.chatgpt-login-pending;
                        clicked => { root.preview-direct(provider.id); }
                    }
                    QuietButton {
                        width: 106px;
                        text: "管理连接  ↗";
                        enabled: !root.busy && !root.config-managed;
                        clicked => { if provider.is-grok { root.begin-xai-editor(provider.id); } else if provider.is-subscription { root.begin-subscription-editor(provider.id); } else { root.begin-provider-editor(provider.id); } }
                    }
                }
            }
        }
    }

    Text {
        text: "保存连接后，在工作台预览并启用。账号绑定与 Codex 入口登录分别管理。";
        color: Theme.muted-text;
        font-size: 11px;
        wrap: word-wrap;
    }
}
