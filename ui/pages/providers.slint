import { ListView } from "../scroll-view.slint";
import { Theme } from "../tokens.slint";
import { QuietButton, QuietLineEdit } from "../components.slint";
import { ProviderRow } from "../view-models.slint";
import { ProviderCard } from "provider-card.slint";

export component ProvidersPage inherits VerticalLayout {
    in property <bool> interactive: true;
    in property <bool> loading;
    in property <bool> busy;
    in property <bool> recovery-only;
    in property <[ProviderRow]> providers;
    in property <[ProviderRow]> filtered-providers;
    in-out property <string> provider-query;
    in property <bool> chatgpt-login-pending;
    in property <bool> config-managed;
    callback refresh(bool);
    callback filter-providers(string);
    callback add-connection();
    callback begin-provider-editor(string);
    callback begin-subscription-editor(string);
    callback begin-xai-editor(string);
    callback check-provider(string);
    callback preview-direct(string);
    callback begin-model-editor(string, string);
    spacing: 16px;
    HorizontalLayout {
        height: 36px;
        spacing: 10px;
        QuietLineEdit {
            enabled: root.interactive;
            width: 190px;
            icon: @image-url("../../assets/ui/search.svg");
            placeholder-text: "搜索连接";
            accessible-label: "按名称筛选上游";
            text <=> root.provider-query;
            edited(text) => { root.filter-providers(text); }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        QuietButton {
            width: 96px;
            text: "检查凭据";
            ghost: true;
            enabled: !root.busy;
            clicked => { root.refresh(true); }
        }

        QuietButton {
            width: 72px;
            text: "刷新";
            ghost: true;
            enabled: !root.busy;
            clicked => { root.refresh(false); }
        }

        QuietButton {
            width: 120px;
            text: "+ 添加连接";
            primary: true;
            enabled: !root.busy && !root.config-managed;
            clicked => { root.add-connection(); }
        }
    }

    if root.config-managed: Text {
        text: root.recovery-only ? "先在设置中恢复原配置，再读取连接资料。" : "配置正在管理中。恢复并停止后可修改连接与账号绑定。";
        color: Theme.warning;
        font-size: 12px;
        wrap: word-wrap;
    }
    if !root.loading && root.providers.length == 0: VerticalLayout {
        padding: 36px;
        spacing: 12px;
        Text {
            text: "从一个连接开始。";
            color: Theme.primary-text;
            font-size: 23px;
            font-weight: 500;
            horizontal-alignment: center;
        }

        Text {
            text: "添加 API 连接、ChatGPT 或 Grok 订阅，再把常用模型放进工作台。";
            color: Theme.muted-text;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
    if root.providers.length > 0 && root.filtered-providers.length == 0: Text {
        text: "没有匹配的连接。试试其他名称。";
        color: Theme.muted-text;
        horizontal-alignment: center;
    }
    ListView {
        vertical-stretch: 1;
        for provider[index] in root.filtered-providers: ProviderCard {
            provider: provider;
            order: index;
            busy: root.busy;
            config-managed: root.config-managed;
            login-pending: root.chatgpt-login-pending;
            manage => { if provider.is-grok { root.begin-xai-editor(provider.id); } else if provider.is-subscription { root.begin-subscription-editor(provider.id); } else { root.begin-provider-editor(provider.id); } }
            models => { root.begin-model-editor(provider.id, ""); }
            check => { root.check-provider(provider.id); }
            direct => { root.preview-direct(provider.id); }
        }
    }

    Text {
        text: "保存连接后，在工作台预览并启用。账号绑定与 Codex 入口登录分别管理。";
        color: Theme.muted-text;
        font-size: 11px;
        wrap: word-wrap;
    }
}
