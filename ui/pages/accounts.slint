import { QuietScrollView as ScrollView } from "../scroll-view.slint";
import { Theme } from "../tokens.slint";
import {
    QuietButton,
    QuietLineEdit as LineEdit,
    SurfaceCard,
} from "../components.slint";
import { AccountRow } from "../view-models.slint";
export component AccountsPage inherits ScrollView {
    in property <bool> busy;
    in property <bool> recovery-only;
    in property <bool> config-managed;
    in property <string> auth-status;
    in property <[AccountRow]> accounts;
    in property <string> account-status;
    in property <string> login-user-code;
    in property <string> login-url;
    in property <bool> chatgpt-login-pending;
    in property <string> route-auth-error;
    callback subscription-action(int);
    callback account-action(int, string);
    callback request-account-removal(AccountRow);
    VerticalLayout {
        SurfaceCard {
            height: 328px + root.accounts.length * 94px + (root.accounts.length == 0 ? 40px : 0px) + (root.chatgpt-login-pending ? 172px : 0px);
            border-width: 0px;
            background: transparent;
            VerticalLayout {
                padding: 0px;
                spacing: 10px;
                HorizontalLayout {
                    height: 36px;
                    Text {
                        text: "ChatGPT 订阅账号";
                        color: Theme.primary-text;
                        font-size: 17px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    QuietButton {
                        width: 88px;
                        horizontal-stretch: 0;
                        text: "刷新列表";
                        enabled: !root.busy && !root.chatgpt-login-pending;
                        clicked => { root.account-action(0, ""); }
                    }
                }

                Text {
                    text: root.route-auth-error == "" ? root.account-status : root.route-auth-error;
                    color: Theme.primary-text;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    text: "账号可绑定到多个订阅上游。写入 Codex 登录只设置客户端入口登录，不改变各上游的绑定。";
                    color: Theme.muted-text;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    QuietButton {
                        text: "添加 ChatGPT 账号";
                        primary: true;
                        enabled: !root.busy && !root.chatgpt-login-pending;
                        clicked => { root.account-action(1, ""); }
                    }

                    QuietButton {
                        text: "导入当前 Codex 账号";
                        enabled: !root.busy && !root.chatgpt-login-pending;
                        clicked => { root.account-action(5, ""); }
                    }

                    QuietButton {
                        text: "将默认账号写入 Codex";
                        enabled: !root.busy && !root.chatgpt-login-pending && root.accounts.length > 0;
                        clicked => { root.account-action(3, ""); }
                    }
                }

                if root.accounts.length == 0: Text {
                    height: 30px;
                    text: "尚未保存账号。添加或导入后，可为订阅上游选择账号，也可显式设置 Codex 入口登录。";
                    color: Theme.muted-text;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                for account in root.accounts: Rectangle {
                    height: 84px;
                    background: account.is-active ? Theme.brand-surface : Theme.raised;
                    border-width: 1px;
                    border-color: account.is-active ? Theme.brand : Theme.border;
                    border-radius: 10px;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: account.label;
                                    color: Theme.primary-text;
                                    font-size: 14px;
                                    font-weight: 600;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                if account.is-active: Text {
                                    text: "Codex 入口登录";
                                    color: Theme.brand;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: (account.workspace == "" ? "ChatGPT 账号" : "工作区：" + account.workspace) + " · " + account.bound-provider-count + " 个上游引用";
                                color: Theme.muted-text;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        QuietButton {
                            width: 92px;
                            horizontal-stretch: 0;
                            text: account.is-default ? "默认账号" : "设为默认";
                            selected: account.is-default;
                            enabled: !root.busy && !root.config-managed && !root.chatgpt-login-pending && !account.is-default;
                            clicked => { root.account-action(2, account.id); }
                        }

                        QuietButton {
                            width: 138px;
                            horizontal-stretch: 0;
                            text: "写入 Codex 登录";
                            enabled: !root.busy && !root.recovery-only && !root.chatgpt-login-pending;
                            clicked => { root.account-action(3, account.id); }
                        }

                        QuietButton {
                            width: 80px;
                            horizontal-stretch: 0;
                            text: "移除";
                            enabled: !root.busy && !root.config-managed && !root.chatgpt-login-pending;
                            clicked => { root.request-account-removal(account); }
                        }
                    }
                }

                if root.chatgpt-login-pending: Rectangle {
                    height: 162px;
                    background: Theme.brand-surface;
                    border-width: 1px;
                    border-color: Theme.brand;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.login-user-code == "" ? "在官方浏览器页面完成登录，可随时取消。" : "复制验证码，在已打开的官方登录页面完成登录。";
                                color: Theme.primary-text;
                                font-size: 13px;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            QuietButton {
                                width: 96px;
                                horizontal-stretch: 0;
                                text: "取消登录";
                                enabled: !root.busy;
                                clicked => { root.subscription-action(3); }
                            }
                        }

                        if root.login-user-code != "": HorizontalLayout {
                            spacing: 8px;
                            Text {
                                width: 88px;
                                text: "登录验证码";
                                color: Theme.muted-text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            LineEdit {
                                text: root.login-user-code;
                                read-only: true;
                                accessible-label: "登录验证码，可选择复制";
                            }
                        }
                        if root.login-url != "": HorizontalLayout {
                            spacing: 8px;
                            Text {
                                width: 88px;
                                text: "登录页面";
                                color: Theme.muted-text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            LineEdit {
                                text: root.login-url;
                                read-only: true;
                                accessible-label: "官方登录页面地址，可选择复制";
                            }
                        }
                    }
                }

                Text {
                    text: root.auth-status;
                    color: Theme.muted-text;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;

                    if !root.chatgpt-login-pending: QuietButton {
                        text: "Codex 原生登录";
                        enabled: !root.busy;
                        clicked => { root.subscription-action(1); }
                    }

                    QuietButton {
                        text: "检查 Codex 登录";
                        enabled: !root.busy && !root.chatgpt-login-pending;
                        clicked => { root.subscription-action(2); }
                    }

                    QuietButton {
                        text: "切回 API 预览";
                        enabled: !root.busy && !root.chatgpt-login-pending;
                        clicked => { root.subscription-action(4); }
                    }
                }

                Text {
                    text: "设为默认只影响默认账号选择。写入 Codex 登录是独立操作，会先恢复受管配置；之后请重新发布并启动新会话。";
                    color: Theme.muted-text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
