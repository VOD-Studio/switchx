import { XaiAccounts } from "xai-accounts.slint";
import { AccountCard, AccountLoginProgress } from "account-card.slint";
import { QuietScrollView as ScrollView } from "../scroll-view.slint";
import { Theme } from "../tokens.slint";
import { QuietButton, AnimatedSection } from "../components.slint";
import { AccountRow } from "../view-models.slint";

export component AccountsPage inherits ScrollView {
    in property <bool> busy;
    in property <bool> recovery-only;
    in property <bool> config-managed;
    in property <string> auth-status;
    in property <[AccountRow]> accounts;
    in property <string> account-error;
    in property <string> login-user-code;
    in property <string> login-url;
    in property <bool> chatgpt-login-pending;
    in property <string> route-auth-error;
    in property <[AccountRow]> xai-accounts;
    in property <string> xai-error;
    in property <string> xai-user-code;
    in property <string> xai-login-url;
    in property <bool> xai-pending;
    in-out property <bool> native-expanded: false;
    in-out property <string> expanded-chatgpt-id;
    in-out property <string> expanded-grok-id;
    in property <string> removing-id;
    callback xai-account-action(int, string);
    callback request-xai-removal(AccountRow);
    callback subscription-action(int);
    callback account-action(int, string);
    callback request-account-removal(AccountRow);
    callback request-account-login(AccountRow);
    callback request-native-login();
    property <bool> login-pending: root.chatgpt-login-pending || root.xai-pending;
    VerticalLayout {
        spacing: 18px;
        if root.route-auth-error != "": Text {
            text: root.route-auth-error;
            color: Theme.warning;
            font-size: 12px;
            wrap: word-wrap;
        }
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 20px;
                    height: 20px;
                    source: @image-url("../../assets/providers/icons/openai.svg");
                    colorize: Theme.primary-text;
                }

                Text {
                    text: "ChatGPT";
                    width: 78px;
                    color: Theme.primary-text;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                Text {
                    text: root.accounts.length + " 个账号";
                    width: 65px;
                    horizontal-stretch: 0;
                    color: Theme.muted-text;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                QuietButton {
                    width: 154px;
                    horizontal-stretch: 0;
                    text: "导入 Codex 账号";
                    ghost: true;
                    enabled: !root.busy && !root.login-pending;
                    clicked => { root.account-action(5, ""); }
                }
            }

            if root.account-error != "": Text {
                text: root.account-error;
                color: Theme.warning;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.accounts.length == 0: Text {
                height: 48px;
                text: "尚未添加 ChatGPT 账号。添加或导入后，可在上游连接中绑定。";
                color: Theme.muted-text;
                font-size: 12px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            for account in root.accounts: AccountCard {
                expanded: root.expanded-chatgpt-id == account.id;
                removing: root.removing-id == account.id;
                toggle-details(id) => { root.expanded-chatgpt-id = root.expanded-chatgpt-id == id ? "" : id; }
                account: account;
                busy: root.busy;
                config-managed: root.config-managed;
                recovery-only: root.recovery-only;
                pending: root.login-pending;
                action(action, id) => { root.account-action(action, id); }
                request-removal(account) => { root.request-account-removal(account); }
                request-login(account) => { root.request-account-login(account); }
            }
            AccountLoginProgress {
                title: "完成 ChatGPT 官方登录";
                pending: root.chatgpt-login-pending;
                busy: root.busy;
                user-code: root.login-user-code;
                login-url: root.login-url;
                cancel => { root.subscription-action(3); }
            }
        }

        XaiAccounts {
            other-login-pending: root.chatgpt-login-pending;
            expanded-id <=> root.expanded-grok-id;
            removing-id: root.removing-id;
            busy: root.busy;
            config-managed: root.config-managed;
            recovery-only: root.recovery-only;
            accounts: root.xai-accounts;
            error: root.xai-error;
            user-code: root.xai-user-code;
            login-url: root.xai-login-url;
            pending: root.xai-pending;
            action(action, id) => { root.xai-account-action(action, id); }
            request-removal(account) => { root.request-xai-removal(account); }
        }

        VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                height: 36px;
                spacing: 12px;
                QuietButton {
                    width: 172px;
                    horizontal-stretch: 0;
                    text: "Codex 本机登录";
                    icon: @image-url("../../assets/ui/terminal.svg");
                    icon-color: Theme.muted-text;
                    ghost: true;
                    left-aligned: true;
                    accessible-expandable: true;
                    accessible-expanded: root.native-expanded;
                    clicked => { root.native-expanded = !root.native-expanded; }
                }

                Text {
                    text: root.auth-status;
                    color: Theme.muted-text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                QuietButton {
                    width: 36px;
                    text: root.native-expanded ? "收起本机登录" : "展开本机登录";
                    icon-only: true;
                    icon: @image-url("../../assets/ui/chevron-down.svg");
                    icon-color: Theme.muted-text;
                    icon-angle: root.native-expanded ? 180deg : 0deg;
                    ghost: true;
                    accessible-expandable: true;
                    accessible-expanded: root.native-expanded;
                    clicked => { root.native-expanded = !root.native-expanded; }
                }
            }

            AnimatedSection {
                expanded: root.native-expanded;
                content-height: native-content.preferred-height;
                native-content := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: self.preferred-height;
                    spacing: 12px;
                    Text {
                        text: root.auth-status;
                        color: Theme.primary-text;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "本机文件关联与官方登录检查分别显示；上游连接的账号绑定独立管理。";
                        color: Theme.muted-text;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        QuietButton {
                            width: 112px;
                            text: "检查登录";
                            enabled: root.native-expanded && !root.busy && !root.login-pending;
                            clicked => { root.subscription-action(2); }
                        }

                        QuietButton {
                            width: 160px;
                            text: "重新登录 Codex";
                            enabled: root.native-expanded && !root.busy && !root.login-pending;
                            clicked => { root.request-native-login(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        Text {
            text: "保存账号后，可在上游连接中绑定。路由预览与启用在工作台完成。";
            color: Theme.muted-text;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
